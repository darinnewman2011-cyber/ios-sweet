+/*
+ * Layout constants for the Galaxy A8 2018 (jackpotlte) Bluetooth endpoint:
+ * the BHCS structure and the BSMHCP shared-memory protocol, as defined by the
+ * Samsung vendor driver (Eureka-Kernel/include/scsc/api/bhcs.h and
+ * bsmhcp.h) and used by drivers/misc/samsung/scsc_bt/.
+ *
+ * The structures are not copied field by field; only the pieces this port
+ * touches are named, as byte offsets into the MIF block.  The offsets and the
+ * 0x165c0 total were checked against the vendor headers with the host C
+ * compiler (offsetof/sizeof), and the BSMHCP magic value is the vendor macro
+ * evaluated at build time on that host.
+ *
+ * "AP RW / R4 RO" regions are written by a5xelte_bt.c; the rest exists so the
+ * firmware sees the layout it expects.  Anything not named here is left zero,
+ * which is also what the vendor driver does for the fields it does not set
+ * (acl_buffer_size, cmd_evt_buffer_size, acl_tx_buffers, mailbox_offset,
+ * service_request: scsc_bt_module.c:555-575, scsc_shm.c:1574-1600).
+ */
+#ifndef _A5XELTE_BT_H_
+#define _A5XELTE_BT_H_
+
+/* struct BHCS, bhcs.h:39-50.  sizeof == 28, naturally aligned; the vendor
+ * allocates it with BSMHCP_ALIGNMENT (32). */
+#define A5BT_BHCS_SIZE          28u
+#define A5BT_BHCS_VERSION       0u      /* uint32_t version, == 2 */
+#define A5BT_BHCS_PROTO_OFF     4u      /* uint32_t bsmhcp_protocol_offset */
+#define A5BT_BHCS_PROTO_LEN     8u      /* uint32_t bsmhcp_protocol_length */
+#define A5BT_BHCS_CONF_OFF      12u     /* uint32_t configuration_offset    */
+#define A5BT_BHCS_CONF_LEN      16u     /* uint32_t configuration_length    */
+#define A5BT_BHCS_LAP           20u     /* uint32_t bluetooth_address_lap   */
+#define A5BT_BHCS_UAP           24u     /* uint8_t  bluetooth_address_uap   */
+#define A5BT_BHCS_NAP           26u     /* uint16_t bluetooth_address_nap   */
+#define A5BT_BHCS_VERSION_EXPECT 2u     /* BHCS_VERSION */
+
+#define A5BT_ALIGN              32u     /* BSMHCP_ALIGNMENT */
+
+/* struct BSMHCP_PROTOCOL, bsmhcp.h:274-321. */
+#define A5BT_BSMHCP_SIZE        0x165c0u
+#define A5BT_BSMHCP_MAGIC       0x155160c2u     /* BSMHCP_PROTOCOL_MAGICVALUE */
+
+/* struct BSMHCP_HEADER (bsmhcp.h:200-272): the fields this port reads/writes.
+ * Everything else (counters, btlog enables, timing/IQ fields) stays zero. */
+#define A5BT_H_MAGIC            0x00u   /* u32  magic_value                */
+#define A5BT_H_SERVICE_REQUEST  0x06u   /* u8   service_request  (left 0)  */
+#define A5BT_H_ACL_BUF_SIZE     0x08u   /* u32  acl_buffer_size   (left 0) */
+#define A5BT_H_CMD_EVT_BUF_SIZE 0x0cu   /* u32  cmd_evt_buffer_size(0)     */
+#define A5BT_H_ACL_TX_BUFFERS   0x10u   /* u32  acl_tx_buffers     (left 0) */
+#define A5BT_H_AP_TO_BG         0x14u   /* u16  ap_to_bg_int_src           */
+#define A5BT_H_AP_TO_FG         0x16u   /* u16  ap_to_fg_int_src           */
+#define A5BT_H_BG_TO_AP         0x18u   /* u16  bg_to_ap_int_src           */
+#define A5BT_H_MAILBOX_OFFSET   0x1cu   /* u32  mailbox_offset    (left 0) */
+#define A5BT_H_CMD_WRITE        0x24u   /* u32  mailbox_hci_cmd_write      */
+#define A5BT_H_EVT_READ         0x28u   /* u32  mailbox_hci_evt_read       */
+#define A5BT_H_ACL_TX_WRITE     0x2cu   /* u32  mailbox_acl_tx_write       */
+#define A5BT_H_ACL_FREE_READ    0x30u   /* u32  mailbox_acl_free_read      */
+#define A5BT_H_ACL_RX_READ      0x34u   /* u32  mailbox_acl_rx_read        */
+#define A5BT_H_ABOX_OFFSET      0x38u   /* u32  abox_offset                */
+#define A5BT_H_ABOX_LENGTH      0x3cu   /* u32  abox_length                */
+#define A5BT_H_PANIC            0x40u   /* u16  panic_deathbed_confession  */
+#define A5BT_H_CMD_READ         0x44u   /* u32  mailbox_hci_cmd_read       */
+#define A5BT_H_EVT_WRITE        0x48u   /* u32  mailbox_hci_evt_write      */
+#define A5BT_H_CONTROLLER_FLAGS 0x4cu   /* u32  controller_flags           */
+#define A5BT_H_FW_FEATURES      0x50u   /* u32  firmware_features          */
+#define A5BT_H_SERVICE_STATE    0x56u   /* u8   service_state              */
+#define A5BT_H_ACL_TX_READ      0x60u   /* u32  mailbox_acl_tx_read        */
+#define A5BT_H_ACL_FREE_WRITE   0x64u   /* u32  mailbox_acl_free_write     */
+
+/* Transfer rings (bsmhcp.h:278-321).  An entry is a length word followed by an
+ * inline data buffer; the data starts with the H4 packet type. */
+#define A5BT_HCI_CMD_RING       0x00100u
+#define A5BT_HCI_CMD_SLOTS      8u      /* BSMHCP_TRANSFER_RING_CMD_SIZE   */
+#define A5BT_HCI_CMD_ENTRY      260u    /* u16 length + u8 data[258]       */
+#define A5BT_HCI_EVT_RING       0x0a2c0u
+#define A5BT_HCI_EVT_SLOTS      32u     /* BSMHCP_TRANSFER_RING_EVT_SIZE   */
+#define A5BT_HCI_EVT_ENTRY      264u    /* u16 length, u16 handle,
+                                         * u16 event_type, u8 data[258]    */
+#define A5BT_HCI_EVT_DATA_OFF   6u
+#define A5BT_HCI_DATA_OFF       2u
+#define A5BT_HCI_DATA_MAX       258u    /* BSMHCP_CMD_EVT_BUFFER_SIZE      */
+
+/* ACL rings, bsmhcp.h:283-321.  The TX data path is implemented as a
+ * single-packet helper; RX, AVDTP, timing, IQ and the free ring's payload
+ * format are recorded here only as far as the code needs them. */
+#define A5BT_ACL_TX_RING        0x029a0u        /* 32 x 8 bytes            */
+#define A5BT_ACL_TX_SLOTS       32u     /* BSMHCP_TRANSFER_RING_ACL_SIZE   */
+#define A5BT_ACL_TX_ENTRY       8u      /* BSMHCP_TD_ACL_TX_DATA           */
+#define A5BT_ACL_TD_LENGTH      0u      /* u16 length                      */
+#define A5BT_ACL_TD_BUFFER      2u      /* u8  buffer_index                */
+#define A5BT_ACL_TD_FLAGS       3u      /* u8  flags (PB/BC bits)          */
+#define A5BT_ACL_TD_HANDLE      4u      /* u16 hci_connection_handle       */
+#define A5BT_ACL_TD_CID         6u      /* u16 l2cap_cid                   */
+#define A5BT_ACL_TX_BUFFER      0x02aa0u        /* 30 x 1024 bytes         */
+#define A5BT_ACL_BUFFERS        30u     /* BSMHCP_DATA_BUFFER_TX_ACL_SIZE  */
+#define A5BT_ACL_BUF_STRIDE     1024u   /* BSMHCP_ACL_BUFFER_SIZE          */
+#define A5BT_ACL_RX_RING        0x0e440u        /* 32 x 1032 bytes         */
+#define A5BT_ACL_FREE_RING      0x16540u        /* 32 x 4 bytes            */
+#define A5BT_ACL_FREE_SLOTS     32u
+#define A5BT_ACL_FREE_ENTRY     4u
+
+/* HCI opcode sent as the boot-time proof (HCI Reset). */
+#define A5BT_HCI_OP_RESET       0x0c03u
+
+/* ACL TX seam.  `payload` is the ACL data after the 4-byte HCI ACL header and
+ * `len` is its length, which is what the descriptor's `length` field wants
+ * (scsc_shm.c:314, 419).  `flags` carries the PB/BC bits from the
+ * caller's HCI header (0x30/0xC0 masks) and BSMHCP_ACL_L2CAP_FLAG_END (0x01)
+ * when the payload completes an L2CAP frame.  Single packet only: no
+ * fragmentation, so PB = continuation is not handled.  No caller yet (no HCI
+ * device node); see the file comment in a5xelte_bt.c. */
+int a5scsc_bt_acl_send(uint16_t handle, uint8_t flags, uint16_t l2cap_cid,
+    const void *payload, uint32_t len);
+
+#endif /* _A5XELTE_BT_H_ */
