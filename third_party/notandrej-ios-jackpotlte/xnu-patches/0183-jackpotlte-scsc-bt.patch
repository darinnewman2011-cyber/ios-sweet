--- /dev/null
+++ b/bsd/dev/a5xelte_bt.c
@@ -0,0 +1,528 @@
+/*
+ * Galaxy A8 2018 (SM-A530F, jackpotlte, Exynos7885) Bluetooth endpoint over
+ * the Samsung SCSC / Maxwell (MX140) shared-memory protocol.
+ *
+ * The BT controller is a service of the same R4 that the WiFi transport in
+ * bsd/dev/a5xelte_scsc.c starts.  The transport patch (0181/0182) owns the
+ * firmware, the mailbox, the MIF window and the mxmgmt stream; this file adds
+ * the Bluetooth service on top of it:
+ *
+ *   - allocates the BHCS (Bluetooth Host Configuration Structure, bhcs.h:39-50)
+ *     and the BSMHCP_PROTOCOL block (bsmhcp.h:274-321) in MIF shared DRAM;
+ *   - allocates the three interrupt bits the vendor BT driver uses, in its
+ *     order (bg_to_ap to-host, then ap_to_bg and ap_to_fg from-host), and
+ *     publishes them in the BSMHCP header;
+ *   - asks the service manager to start service id 2 with an
+ *     SM_MSG_START_REQ carrying the BHCS offset, and waits for
+ *     SM_MSG_START_CFM (servman_messages.h:14-33, scsc_service.c:146-168);
+ *   - writes one HCI command into the command transfer ring and reads the
+ *     HCI event transfer ring.  The packet inside the rings is the HCI packet
+ *     without the H4 type byte: commands are [opcode lo, opcode hi, plen,
+ *     params...] and events are [event code, plen, params...].  The boot-time
+ *     proof is an HCI Reset (opcode 0x0c03, no parameters) followed by its
+ *     Command Complete (event 0x0e);
+ *   - has a single-packet ACL TX path (one buffer, no fragmentation) that no
+ *     caller uses yet, because there is no HCI device node.
+ *
+ * Everything runs in thread context: the mailbox is polled by the SCSC
+ * transport thread, which calls this file's interrupt-bit handler
+ * (a5scsc_bt_evt) for the bg_to_ap bit.  Nothing here runs in an ISR.
+ *
+ * NOT implemented, on purpose, and listed as stubs in PORT-START.md:
+ *   - no HCI character device or Bluetooth stack interface, so there is no
+ *     path for a host stack to open the controller yet, and therefore no user
+ *     of a5scsc_bt_acl_send();
+ *   - ACL RX, AVDTP detection, timing packets, IQ reports, the BT log rings and
+ *     the A-box audio window (the jackpotlte DT's btabox node carries no reg,
+ *     so the vendor driver maps that window as zero too);
+ *   - the Bluetooth device address is left 0 (vendor default: it comes from
+ *     the SoC unique id or a stack-supplied value, neither available here);
+ *   - the BSMHCP configuration blob (mx140 *.hcf) is not loaded;
+ *   - no stop/restart path.
+ *
+ * Gate: the whole endpoint runs only with the "a8bt" boot argument set to 1,
+ * independently of "a8wifi".  Without it the probe returns immediately.
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+#include "a5xelte_scsc.h"
+#include "a5xelte_bt.h"
+
+void a5xelte_bt_probe(void);
+
+/* ---- device state --------------------------------------------------------- */
+
+struct a5bt_softc {
+	uint32_t          bhcs_ref;      /* MIF offset of struct BHCS       */
+	uint32_t          proto_ref;     /* MIF offset of BSMHCP_PROTOCOL   */
+	volatile uint8_t *proto;         /* its MIF VA                      */
+
+	int               bit_tohost;    /* bg_to_ap_int_src                */
+	int               bit_from_bg;   /* ap_to_bg_int_src                */
+	int               bit_from_fg;   /* ap_to_fg_int_src                */
+
+	/* Written by the poll thread, read by the bring-up thread. */
+	volatile bool     start_cfm;
+	volatile bool     reset_cc;
+	volatile uint32_t events;
+	volatile uint32_t last_cc_opcode;
+	volatile bool     panic_seen;
+	volatile uint32_t unknown_sm;
+
+	/* ACL TX buffers.  The vendor keeps a bitmap and learns about released
+	 * buffers from the acl_tx_free ring (scsc_shm.c:1082-1150,
+	 * 425-470).  Only 30 of the 32 ring entries own a data buffer. */
+	uint8_t           acl_busy[A5BT_ACL_BUFFERS];
+	uint32_t          acl_last;
+	uint32_t          acl_count;    /* buffers currently owned by a packet */
+	uint32_t          acl_free_seen;
+};
+
+static struct a5bt_softc a5bt;
+
+/* ---- shared-memory accessors ----------------------------------------------
+ * Same 32-bit little-endian accesses as the transport, on a MIF offset.
+ * The BSMHCP block is MIF DRAM (non-cacheable), so unaligned access is fine;
+ * keep it word-based anyway to match the vendor driver's plain C accesses.
+ */
+
+static inline uint32_t
+a5bt_rd32(volatile uint8_t *base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+a5bt_wr32(volatile uint8_t *base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static inline uint16_t
+a5bt_rd16(volatile uint8_t *base, uint32_t off)
+{
+	return *(volatile uint16_t *)(base + off);
+}
+
+static inline void
+a5bt_wr16(volatile uint8_t *base, uint32_t off, uint16_t v)
+{
+	*(volatile uint16_t *)(base + off) = v;
+}
+
+static inline void
+a5bt_mb(void)
+{
+	__asm__ volatile ("dmb osh" ::: "memory");
+}
+
+/* ---- HCI command transfer ring -------------------------------------------
+ * struct BSMHCP_TD_CONTROL { u16 length; u8 data[258]; }, eight entries, one
+ * slot always free (bsmhcp.h:107-111, 278-281; scsc_shm.c:212-256).
+ * `data` is the HCI command packet without the H4 type byte, and `length` is
+ * 3 + parameter length: the vendor strips the type before the ring
+ * (scsc_shm.c:1482, 213-215).
+ */
+static bool
+a5bt_hci_cmd(const uint8_t *cmd, uint32_t len)
+{
+	uint32_t w, r;
+	volatile uint8_t *td;
+
+	if (!a5bt.proto || cmd == NULL || len == 0 ||
+	    len > A5BT_HCI_DATA_MAX) {
+		return false;
+	}
+	w = a5bt_rd32(a5bt.proto, A5BT_H_CMD_WRITE);
+	r = a5bt_rd32(a5bt.proto, A5BT_H_CMD_READ);
+	if (w >= A5BT_HCI_CMD_SLOTS || r >= A5BT_HCI_CMD_SLOTS) {
+		return false;
+	}
+	if (((w + 1) % A5BT_HCI_CMD_SLOTS) == r) {
+		return false;           /* ring full (BSMHCP_HAS_ROOM) */
+	}
+	td = a5bt.proto + A5BT_HCI_CMD_RING + w * A5BT_HCI_CMD_ENTRY;
+	memcpy((void *)(td + A5BT_HCI_DATA_OFF), cmd, len);
+	a5bt_wr16(td, 0, (uint16_t)len);
+	a5bt_mb();
+	a5bt_wr32(a5bt.proto, A5BT_H_CMD_WRITE,
+	    (w + 1) % A5BT_HCI_CMD_SLOTS);
+	a5bt_mb();
+	/* Wake the firmware's Bluetooth side (scsc_shm.c:255-258). */
+	a5scsc_irq_bit_set(a5bt.bit_from_bg, A5SCSC_MIF_TARGET_R4);
+	return true;
+}
+
+/* ---- ACL TX (single packet, no fragmentation) -----------------------------
+ * The firmware returns used data buffers through the acl_tx_free ring
+ * (struct BSMHCP_TD_ACL_TX_FREE { u8 buffer_index; u8 reserved; u16 handle; },
+ * bsmhcp.h:150-154).  Reap them before allocating, like
+ * scsc_shm.c:425-470 does.
+ */
+static void
+a5bt_acl_reap(void)
+{
+	uint32_t r, w, n = 0;
+	uint8_t idx;
+
+	if (!a5bt.proto) {
+		return;
+	}
+	r = a5bt_rd32(a5bt.proto, A5BT_H_ACL_FREE_READ);
+	w = a5bt_rd32(a5bt.proto, A5BT_H_ACL_FREE_WRITE);
+	while (r != w && n < A5BT_ACL_FREE_SLOTS && r < A5BT_ACL_FREE_SLOTS) {
+		idx = *(a5bt.proto + A5BT_ACL_FREE_RING +
+		    r * A5BT_ACL_FREE_ENTRY);
+		if (idx < A5BT_ACL_BUFFERS && a5bt.acl_busy[idx]) {
+			a5bt.acl_busy[idx] = 0;
+			a5bt.acl_count--;
+			a5bt.acl_free_seen++;
+		}
+		r = (r + 1) % A5BT_ACL_FREE_SLOTS;
+		a5bt_mb();
+		a5bt_wr32(a5bt.proto, A5BT_H_ACL_FREE_READ, r);
+		w = a5bt_rd32(a5bt.proto, A5BT_H_ACL_FREE_WRITE);
+		n++;
+	}
+}
+
+/* Hands one ACL packet (L2CAP payload, no H4 header) to the firmware.
+ * `flags` are the HCI PB/BC bits already shifted into place, and
+ * `l2cap_cid`/`handle` come from the caller's packet header.  Fragmentation
+ * (PB = continuation) is not supported: one call is one whole packet, which
+ * is what BSMHCP_TD_ACL_TX_DATA describes.  No caller exists yet; see the file
+ * comment.
+ */
+int
+a5scsc_bt_acl_send(uint16_t handle, uint8_t flags, uint16_t l2cap_cid,
+    const void *payload, uint32_t len)
+{
+	uint32_t w, r, i, idx = A5BT_ACL_BUFFERS;
+	volatile uint8_t *td;
+
+	if (a5bt.proto == NULL || payload == NULL || len == 0 ||
+	    len > A5BT_ACL_BUF_STRIDE) {
+		return EINVAL;
+	}
+	w = a5bt_rd32(a5bt.proto, A5BT_H_ACL_TX_WRITE);
+	r = a5bt_rd32(a5bt.proto, A5BT_H_ACL_TX_READ);
+	if (w >= A5BT_ACL_TX_SLOTS || r >= A5BT_ACL_TX_SLOTS) {
+		return EIO;
+	}
+	if (((w + 1) % A5BT_ACL_TX_SLOTS) == r) {
+		return EAGAIN;          /* transfer ring full */
+	}
+	for (i = 0; i < A5BT_ACL_BUFFERS; i++) {
+		/* same probe order as scsc_shm.c:245-252 */
+		if (++a5bt.acl_last == A5BT_ACL_BUFFERS) {
+			a5bt.acl_last = 0;
+		}
+		if (a5bt.acl_busy[a5bt.acl_last] == 0) {
+			a5bt.acl_busy[a5bt.acl_last] = 1;
+			idx = a5bt.acl_last;
+			a5bt.acl_count++;
+			break;
+		}
+	}
+	if (idx == A5BT_ACL_BUFFERS) {
+		return EAGAIN;          /* no free data buffer */
+	}
+	memcpy((void *)(a5bt.proto + A5BT_ACL_TX_BUFFER +
+	    idx * A5BT_ACL_BUF_STRIDE), payload, len);
+	td = a5bt.proto + A5BT_ACL_TX_RING + w * A5BT_ACL_TX_ENTRY;
+	a5bt_wr16(td, A5BT_ACL_TD_LENGTH, (uint16_t)len);
+	*(td + A5BT_ACL_TD_BUFFER) = (uint8_t)idx;
+	*(td + A5BT_ACL_TD_FLAGS) = flags;
+	a5bt_wr16(td, A5BT_ACL_TD_HANDLE, handle);
+	a5bt_wr16(td, A5BT_ACL_TD_CID, l2cap_cid);
+	a5bt_mb();
+	a5bt_wr32(a5bt.proto, A5BT_H_ACL_TX_WRITE,
+	    (w + 1) % A5BT_ACL_TX_SLOTS);
+	a5bt_mb();
+	/* ACL data wakes the foreground bit; commands use ap_to_bg
+	 * (scsc_shm.c:258 vs scsc_shm.c:429). */
+	a5scsc_irq_bit_set(a5bt.bit_from_fg, A5SCSC_MIF_TARGET_R4);
+	return 0;
+}
+
+/* ---- HCI event transfer ring ---------------------------------------------
+ * struct BSMHCP_TD_HCI_EVT { u16 length; u16 hci_connection_handle;
+ * u16 event_type; u8 data[258]; } (bsmhcp.h:112-117).  `data` starts with the
+ * HCI event code (the firmware strips the H4 type, scsc_shm.c:579-600), so
+ * data[0] == 0x0e is a Command Complete, data[1] is the parameter length and
+ * `length` is that parameter length + 2.
+ * The vendor consumer advances read index without waking the firmware
+ * (scsc_shm.c:914-985), which is what this does.
+ */
+static void
+a5bt_evt(int bit __unused, void *arg __unused)
+{
+	uint32_t r, w, n = 0;
+	volatile uint8_t *td;
+	uint16_t len;
+
+	if (!a5bt.proto) {
+		return;
+	}
+	a5bt_acl_reap();
+	r = a5bt_rd32(a5bt.proto, A5BT_H_EVT_READ);
+	w = a5bt_rd32(a5bt.proto, A5BT_H_EVT_WRITE);
+	while (r != w && n < A5BT_HCI_EVT_SLOTS && r < A5BT_HCI_EVT_SLOTS) {
+		td = a5bt.proto + A5BT_HCI_EVT_RING + r * A5BT_HCI_EVT_ENTRY;
+		len = a5bt_rd16(td, 0);
+		if (len != 0 && len <= A5BT_HCI_DATA_MAX) {
+			const volatile uint8_t *d = td + A5BT_HCI_EVT_DATA_OFF;
+
+			a5bt.events++;
+			if (len >= 6 && d[0] == 0x0e) {
+				/* Command Complete: event 0x0e, plen in d[1],
+				 * num_cmds in d[2], opcode in d[3..4] (LE),
+				 * status in d[5]. */
+				a5bt.last_cc_opcode =
+				    (uint32_t)d[3] | ((uint32_t)d[4] << 8);
+				if (a5bt.last_cc_opcode == A5BT_HCI_OP_RESET) {
+					a5bt.reset_cc = true;
+				}
+			}
+		}
+		r = (r + 1) % A5BT_HCI_EVT_SLOTS;
+		a5bt_mb();
+		a5bt_wr32(a5bt.proto, A5BT_H_EVT_READ, r);
+		/* Firmware may have added more while we were copying. */
+		w = a5bt_rd32(a5bt.proto, A5BT_H_EVT_WRITE);
+		n++;
+	}
+	if (a5bt_rd16(a5bt.proto, A5BT_H_PANIC) != 0) {
+		a5bt.panic_seen = true;
+	}
+}
+
+/* ---- service manager ------------------------------------------------------
+ * sm_msg_packet is { u8 service_id; u8 msg; u32 optional_data } packed
+ * (servman_messages.h:29-33).  Payload byte 0 is the service id, so the
+ * transport's "msg" slot carries it (see a5scsc_mxmgmt_send).
+ */
+static void
+a5bt_sm(const uint8_t *p, void *arg __unused)
+{
+	if (p[0] != A5SCSC_SERVICE_ID_BT) {
+		a5bt.unknown_sm++;
+		return;
+	}
+	switch (p[1]) {
+	case A5SCSC_SM_MSG_START_CFM:
+		a5bt.start_cfm = true;
+		break;
+	case A5SCSC_SM_MSG_STOP_CFM:
+		break;
+	default:
+		a5bt.unknown_sm++;
+		break;
+	}
+}
+
+/* ---- bring-up ------------------------------------------------------------ */
+
+static void
+a5bt_sleep_ms(uint32_t ms)
+{
+	assert_wait_timeout((event_t)&a5bt.proto, THREAD_UNINT, ms,
+	    1000 * NSEC_PER_USEC);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Fills BHCS (bhcs.h:39-50, setup_bhcs() in scsc_bt_module.c:556-575).  The
+ * configuration blob and the device address are intentionally zero: the
+ * vendor leaves them zero when the config file is absent, and the address
+ * comes from a source this port does not have. */
+static void
+a5bt_fill_bhcs(uint8_t *bhcs)
+{
+	bzero(bhcs, A5BT_BHCS_SIZE);
+	a5bt_wr32(bhcs, A5BT_BHCS_VERSION, A5BT_BHCS_VERSION_EXPECT);
+	a5bt_wr32(bhcs, A5BT_BHCS_PROTO_OFF, a5bt.proto_ref);
+	a5bt_wr32(bhcs, A5BT_BHCS_PROTO_LEN, A5BT_BSMHCP_SIZE);
+	/* configuration_offset/length, bluetooth_address_* stay 0. */
+	a5bt_mb();
+}
+
+/* Allocates and publishes the three interrupt bits in the vendor's order
+ * (scsc_shm.c:95-131).  Called before the service is started, because the
+ * firmware reads them out of the BSMHCP header at start. */
+static int
+a5bt_bits(void)
+{
+	a5bt.bit_tohost = a5scsc_intrbit_alloc_tohost(a5bt_evt, NULL);
+	if (a5bt.bit_tohost < 0) {
+		return ENOSPC;
+	}
+	a5bt.bit_from_bg = a5scsc_intrbit_alloc_fromhost(
+	    A5SCSC_MIF_TARGET_R4, false);
+	if (a5bt.bit_from_bg < 0) {
+		return ENOSPC;
+	}
+	a5bt.bit_from_fg = a5scsc_intrbit_alloc_fromhost(
+	    A5SCSC_MIF_TARGET_R4, false);
+	if (a5bt.bit_from_fg < 0) {
+		return ENOSPC;
+	}
+	a5bt_wr16(a5bt.proto, A5BT_H_BG_TO_AP, (uint16_t)a5bt.bit_tohost);
+	a5bt_wr16(a5bt.proto, A5BT_H_AP_TO_BG, (uint16_t)a5bt.bit_from_bg);
+	a5bt_wr16(a5bt.proto, A5BT_H_AP_TO_FG, (uint16_t)a5bt.bit_from_fg);
+	a5bt_mb();
+	return 0;
+}
+
+/* Sends SM_MSG_START_REQ(service_id = BT, optional_data = bhcs_ref) and waits
+ * for the confirmation (scsc_service.c:146-168). */
+static bool
+a5bt_service_start(uint32_t *waited_ms)
+{
+	uint8_t body[5];                /* { msg, optional_data } */
+	uint32_t waited;
+	int err;
+
+	body[0] = A5SCSC_SM_MSG_START_REQ;
+	body[1] = (uint8_t)(a5bt.bhcs_ref & 0xff);
+	body[2] = (uint8_t)((a5bt.bhcs_ref >> 8) & 0xff);
+	body[3] = (uint8_t)((a5bt.bhcs_ref >> 16) & 0xff);
+	body[4] = (uint8_t)((a5bt.bhcs_ref >> 24) & 0xff);
+	a5scsc_mxmgmt_register(A5SCSC_MMTRANS_CHAN_SERVICE, a5bt_sm, NULL);
+	err = a5scsc_mxmgmt_send(A5SCSC_MMTRANS_CHAN_SERVICE,
+	    A5SCSC_SERVICE_ID_BT, body, sizeof(body));
+	if (err != 0) {
+		*waited_ms = 0;
+		return false;
+	}
+	for (waited = 0; waited < A5SCSC_SM_TIMEOUT_MS && !a5bt.start_cfm;
+	    waited += A5SCSC_POLL_INTERVAL_MS) {
+		a5bt_sleep_ms(A5SCSC_POLL_INTERVAL_MS);
+	}
+	*waited_ms = waited;
+	return a5bt.start_cfm;
+}
+
+/* Boot-time proof that the controller is alive: HCI Reset and its Command
+ * Complete.  The command is [opcode lo, opcode hi, plen, params...]; the H4
+ * type byte exists only on the host-side H4 stream and must not be written
+ * into the ring (scsc_shm.c:1482 passes &buf[1]). */
+static bool
+a5bt_hci_reset(uint32_t *waited_ms)
+{
+	static const uint8_t reset[] = { A5BT_HCI_OP_RESET & 0xff,
+	    (A5BT_HCI_OP_RESET >> 8) & 0xff, 0x00 };
+	uint32_t waited;
+
+	if (!a5bt_hci_cmd(reset, sizeof(reset))) {
+		*waited_ms = 0;
+		return false;
+	}
+	for (waited = 0; waited < A5SCSC_SM_TIMEOUT_MS && !a5bt.reset_cc;
+	    waited += A5SCSC_POLL_INTERVAL_MS) {
+		a5bt_sleep_ms(A5SCSC_POLL_INTERVAL_MS);
+	}
+	*waited_ms = waited;
+	return a5bt.reset_cc;
+}
+
+static void
+a5bt_bringup_thread(void *param __unused, wait_result_t wr __unused)
+{
+	uint8_t *bhcs;
+	uint32_t waited;
+	int attempt;
+
+	/* Wait for the shared transport; it loads the firmware and starts the
+	 * R4 on its first successful call. */
+	for (attempt = 0; attempt < 120; attempt++) {
+		if (a5scsc_transport_up()) {
+			break;
+		}
+		a5bt_sleep_ms(250);
+	}
+	if (attempt == 120) {
+		printf("A5XELTE BT: shared SCSC transport not up; BT port disabled\n");
+		return;
+	}
+	printf("A5XELTE BT: transport: shared R4 up, allocating BT blocks\n");
+
+	if (!a5scsc_mifram_alloc(A5BT_BHCS_SIZE, A5BT_ALIGN, &a5bt.bhcs_ref) ||
+	    !a5scsc_mifram_alloc(A5BT_BSMHCP_SIZE, A5BT_ALIGN,
+	    &a5bt.proto_ref)) {
+		printf("A5XELTE BT: MIF allocation failed; BT port disabled\n");
+		return;
+	}
+	a5bt.proto = a5scsc_mifram_ptr(a5bt.proto_ref);
+	bhcs = a5scsc_mifram_ptr(a5bt.bhcs_ref);
+	if (a5bt.proto == NULL || bhcs == NULL) {
+		printf("A5XELTE BT: MIF mapping failed; BT port disabled\n");
+		return;
+	}
+	memset((void *)a5bt.proto, 0, A5BT_BSMHCP_SIZE);
+	a5bt_wr32(a5bt.proto, A5BT_H_MAGIC, A5BT_BSMHCP_MAGIC);
+	a5bt_mb();
+
+	if (a5bt_bits() != 0) {
+		printf("A5XELTE BT: interrupt-bit allocation failed; BT port disabled\n");
+		return;
+	}
+	a5bt_fill_bhcs(bhcs);
+	printf("A5XELTE BT: config: bhcs 0x%x protocol 0x%x (%u bytes), bits tohost %d fromhost %d/%d\n",
+	    a5bt.bhcs_ref, a5bt.proto_ref, A5BT_BSMHCP_SIZE,
+	    a5bt.bit_tohost, a5bt.bit_from_bg, a5bt.bit_from_fg);
+
+	if (!a5bt_service_start(&waited)) {
+		printf("A5XELTE BT: service: no SM_MSG_START_CFM in %u ms; BT port disabled\n",
+		    (unsigned)A5SCSC_SM_TIMEOUT_MS);
+		return;
+	}
+	printf("A5XELTE BT: service: SM_MSG_START_CFM after %u ms\n",
+	    waited);
+
+	if (!a5bt_hci_reset(&waited)) {
+		printf("A5XELTE BT: hci: no Command Complete for HCI Reset in %u ms (events %u, last cc opcode 0x%04x)\n",
+		    (unsigned)A5SCSC_SM_TIMEOUT_MS, a5bt.events,
+		    a5bt.last_cc_opcode);
+		return;
+	}
+	printf("A5XELTE BT: hci: reset complete after %u ms (events %u)\n",
+	    waited, a5bt.events);
+	printf("A5XELTE BT: up: controller answered HCI Reset\n");
+}
+
+/* ---- public entry point --------------------------------------------------- */
+
+void
+a5xelte_bt_probe(void)
+{
+	int enabled = 0;
+	thread_t thread = THREAD_NULL;
+
+	(void)PE_parse_boot_argn("a8bt", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	if (kernel_thread_start((thread_continue_t)a5bt_bringup_thread, NULL,
+	    &thread) != KERN_SUCCESS) {
+		printf("A5XELTE BT: bring-up thread failed to start\n");
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+#else   /* ARM64_BOARD_CONFIG_A5XELTE && JACKPOTLTE */
+
+void
+a5xelte_bt_probe(void)
+{
+}
+
+#endif  /* ARM64_BOARD_CONFIG_A5XELTE && JACKPOTLTE */
