+/* ---- mxconf: the structure the R4 reads through MBOX1 ---------------------
+ * mxconf.h:106-139.  The struct is NOT packed; every member is naturally
+ * aligned on both the AP and the R4, so the layout is:
+ *
+ *   off  size  member
+ *   0x00    4  magic                    (MXCONF_MAGIC)
+ *   0x04    2  version.major   (u16)
+ *   0x06    2  version.minor   (u16)
+ *   0x08   48  mx_trans_conf          -> mxmgmt  to_ap / from_ap
+ *   0x38   48  mx_trans_conf_gdb_r4
+ *   0x68   48  mx_trans_conf_gdb_m4
+ *   0x98   24  mxlogconf.stream_conf
+ *   0xB0        (end; sizeof(struct mxconf) == 176)
+ *
+ * and every struct mxstreamconf is 24 bytes:
+ *
+ *   0x00   20  buf_conf: buffer_loc, num_packets, packet_size,
+ *                        read_index_loc, write_index_loc  (all u32)
+ *   0x14    1  read_bit_idx
+ *   0x15    1  write_bit_idx
+ *   0x16    2  (tail padding)
+ *
+ * The R4 dereferences buffer_loc / read_index_loc / write_index_loc, so a
+ * zeroed descriptor (num_packets == 0, read_index_loc == 0) is not a safe
+ * placeholder: the firmware computes indexes modulo num_packets.  Patch 0181
+ * therefore fills every stream in, as transports_init() does
+ * (mxman.c:1004-1035).
+ */
+#define A5SCSC_MXCONF_MAGIC             0x79828486U     /* mxconf.h:35 */
+#define A5SCSC_MXCONF_VERSION_MAJOR     0u              /* mxconf.h:43 */
+#define A5SCSC_MXCONF_VERSION_MINOR     1u              /* mxconf.h:44 */
+#define A5SCSC_MXCONF_SIZE              176u            /* sizeof(struct mxconf) */
+#define A5SCSC_MXCONF_MX_TRANS          8u              /* mxconf.h:119 */
+#define A5SCSC_MXCONF_GDB_R4            56u             /* mxconf.h:125 */
+#define A5SCSC_MXCONF_GDB_M4            104u            /* mxconf.h:127 */
+#define A5SCSC_MXCONF_MXLOG             152u            /* mxconf.h:132 */
+#define A5SCSC_MXCONF_TRANS_SIZE        48u             /* 2 * mxstreamconf */
+#define A5SCSC_MXCONF_STREAM_STRIDE     24u             /* sizeof(mxstreamconf) */
+#define A5SCSC_MXSTREAM_TO_AP           0u              /* mxtransconf first  */
+#define A5SCSC_MXSTREAM_FROM_AP         24u             /* mxtransconf second */
+
+/* struct mxcbufconf, mxconf.h:52-58: five u32, in this order. */
+#define A5SCSC_MXCBUF_LOC_OFF           0u
+#define A5SCSC_MXCBUF_NUM_OFF           4u
+#define A5SCSC_MXCBUF_SIZE_OFF          8u
