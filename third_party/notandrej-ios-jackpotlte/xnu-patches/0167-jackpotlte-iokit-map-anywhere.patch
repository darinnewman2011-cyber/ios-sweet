diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -1952,7 +1952,27 @@
 
 		options = (options & ~kIOMapUserOptionsMask)
 		    | (mapFlags & kIOMapUserOptionsMask);
+#if defined(JACKPOTLTE)
+		/* Bring-up: our libIOKit callers pass atAddress 0 with mapFlags 0,
+		 * which the public IOConnectMapMemory64 documents as "place it
+		 * anywhere" (a null address is not a requested address).  Without
+		 * kIOMapAnywhere the mapping below is entered with
+		 * VM_MAP_KERNEL_FLAGS_FIXED() at address 0, which a user task
+		 * cannot have, so createMappingInTask() fails and the client gets
+		 * kIOReturnBadArgument for a request that should have succeeded. */
+		if (atAddress == 0) {
+			options |= kIOMapAnywhere;
+		}
+#endif
 		map = memory->createMappingInTask( task, atAddress, options );
+#if defined(JACKPOTLTE)
+		if (map == NULL) {
+			IOLog("jackpotlte-iokit: map type %u failed: at %#llx, "
+			    "options %#x, length %llu\n", (unsigned int) type,
+			    (unsigned long long) atAddress, (unsigned int) options,
+			    (unsigned long long) memory->getLength());
+		}
+#endif
 		memory->release();
 
 		FAKE_STACK_FRAME_END();
