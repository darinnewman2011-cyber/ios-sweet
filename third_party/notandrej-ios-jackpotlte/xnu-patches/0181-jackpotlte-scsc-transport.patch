+		a5scsc_transport_state = 0;
+		return 0;
+	}
+	printf("A5XELTE SCSC: stage 2/6 mxconf: at 0x%x, bits tohost 0x%04x r4 0x%04x m4 0x%04x\n",
+	    a5scsc.mxconf_ref, a5scsc.intr_tohost,
