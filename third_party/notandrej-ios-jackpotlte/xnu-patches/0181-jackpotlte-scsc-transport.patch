+	 * state machine accepted the reset. */
+	printf("A5XELTE SCSC: stage 5/6 handshake: STUBBED\n");
+	printf("A5XELTE SCSC: stage 6/6 up: WLBT running, no firmware handshake\n");
+	return 1;
+}
