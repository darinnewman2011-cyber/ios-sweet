+/* ---- interrupt bits (platform_mif.c:766-908, mifintrbit.c) ----------------
+ * The AP sees two 16-bit masks per bank: bits [31:16] of INTMSR0 are interrupts
+ * from R4/M4 that are pending and not masked.  Bit 0 of each from-host map is
+ * reserved for forcing a firmware panic (mifintrbit.c:236-237); everything else
+ * is first-fit from bit 0 up.
+ */
+
+/* Pending, enabled and unmasked interrupts from R4/M4 (MIF:776-786). */
+static uint32_t
+a5scsc_irq_get(void)
+{
+	return a5scsc_mbox_rd(a5scsc.mbox_r4, A5SCSC_INTMSR0) >> 16;
+}
+
+static void
+a5scsc_irq_bit_clear(int bit)
+{
+	if (bit < 0 || bit >= (int)A5SCSC_INTRBIT_NUM) {
+		return;
+	}
+	a5scsc_wr(a5scsc.mbox_r4, A5SCSC_INTCR0, ((1u << bit) << 16));   /* MIF:831-842 */
+}
+
+static void
+a5scsc_irq_bit_mask(int bit)
+{
+	uint32_t v;
+
+	if (bit < 0 || bit >= (int)A5SCSC_INTRBIT_NUM) {
+		return;
+	}
+	v = a5scsc_mbox_rd(a5scsc.mbox_r4, A5SCSC_INTMR0);
+	a5scsc_wr(a5scsc.mbox_r4, A5SCSC_INTMR0, v | ((1u << bit) << 16)); /* MIF:844-860 */
+}
+
+static void
+a5scsc_irq_bit_unmask(int bit)
+{
+	uint32_t v;
+
+	if (bit < 0 || bit >= (int)A5SCSC_INTRBIT_NUM) {
+		return;
+	}
+	v = a5scsc_mbox_rd(a5scsc.mbox_r4, A5SCSC_INTMR0);
+	a5scsc_wr(a5scsc.mbox_r4, A5SCSC_INTMR0, v & ~((1u << bit) << 16)); /* MIF:862-878 */
+}
+
+/* Generate an interrupt TO R4 (target 0) or M4 (target 1); MIF:788-829.
+ * The from-M4 direction uses the R1 offsets in the M4 bank on 7885. */
+static void
+a5scsc_irq_bit_set(int bit, uint8_t target)
+{
+	if (bit < 0 || bit >= (int)A5SCSC_INTRBIT_NUM) {
+		return;
+	}
+	if (target == A5SCSC_MIF_TARGET_M4) {
+		a5scsc_wr(a5scsc.mbox_m4, A5SCSC_INTGR1, (1u << bit));
+	} else {
+		a5scsc_wr(a5scsc.mbox_r4, A5SCSC_INTGR1, (1u << bit));
+	}
+}
+
+/* One pass of the work mifiintrman_isr() does (mifintrbit.c:52-71): clear the
+ * bit first so a new arrival is not lost, then run the registered handler. */
+static void
+a5scsc_intr_dispatch(void)
+{
+	uint32_t pending = a5scsc_irq_get();
+
+	while (pending != 0) {
+		int bit = 0;
+
+		while (bit < (int)A5SCSC_INTRBIT_NUM &&
+		    (pending & (1u << bit)) == 0) {
+			bit++;
+		}
+		if (bit >= (int)A5SCSC_INTRBIT_NUM) {
+			break;
+		}
+		pending &= ~(1u << bit);
+		a5scsc_irq_bit_clear(bit);
+		if (a5scsc.intr_fn[bit] != NULL) {
+			a5scsc.intr_fn[bit](bit, a5scsc.intr_arg[bit]);
+		}
+	}
+}
+
+/* mifintrbit.c:105-121: mask, clear, register, unmask, then mark allocated. */
+static int
+a5scsc_intrbit_alloc_tohost(a5scsc_intr_fn fn, void *arg)
+{
+	int bit;
+
+	for (bit = 0; bit < (int)A5SCSC_INTRBIT_NUM; bit++) {
+		if ((a5scsc.intr_tohost & (1u << bit)) == 0) {
+			break;
+		}
+	}
+	if (bit >= (int)A5SCSC_INTRBIT_NUM) {
+		return -1;
+	}
+	a5scsc_irq_bit_mask(bit);
+	a5scsc_irq_bit_clear(bit);
+	a5scsc.intr_fn[bit] = fn;
+	a5scsc.intr_arg[bit] = arg;
+	a5scsc_irq_bit_unmask(bit);
+	a5scsc.intr_tohost |= (uint16_t)(1u << bit);
+	return bit;
+}
+
+/* mifintrbit.c:150-170.  "reserved" picks the panic bit instead of allocating,
+ * which is what the gdb output streams do (mifstream.c:62-70). */
+static int
+a5scsc_intrbit_alloc_fromhost(uint8_t target, bool reserved)
+{
+	uint16_t *map = (target == A5SCSC_MIF_TARGET_M4) ?
+	    &a5scsc.intr_fromhost_m4 : &a5scsc.intr_fromhost_r4;
+	int bit;
+
+	if (reserved) {
+		return (int)A5SCSC_INTRBIT_RESERVED_PANIC;
+	}
+	for (bit = 0; bit < (int)A5SCSC_INTRBIT_NUM; bit++) {
+		if ((*map & (1u << bit)) == 0) {
+			break;
+		}
+	}
+	if (bit >= (int)A5SCSC_INTRBIT_NUM) {
+		return -1;
+	}
+	*map |= (uint16_t)(1u << bit);
+	return bit;
+}
+
+static void
+a5scsc_intrbit_init(void)
+{
+	a5scsc.intr_tohost = 0;
+	a5scsc.intr_fromhost_r4 = (uint16_t)(1u << A5SCSC_INTRBIT_RESERVED_PANIC);
+	a5scsc.intr_fromhost_m4 = (uint16_t)(1u << A5SCSC_INTRBIT_RESERVED_PANIC);
+	bzero(a5scsc.intr_fn, sizeof(a5scsc.intr_fn));
+	bzero(a5scsc.intr_arg, sizeof(a5scsc.intr_arg));
+}
