 #define SWEET_SURFACE_STATE_SEED        0xc     /* u32 in the state page */
 #define kIOSurfaceLockReadOnly          0x1
 
+/* Smallest structure output that is a surface client and not a value: the
+ * framework builds its own IOSurfaceClient (0x150 bytes at planeCount 0,
+ * 0xa68 at 16) out of this, and then dereferences the two addresses the
+ * result starts with (JT 61: backboardd, IOSurface + 0x4ffc, far 0x30). */
+#define SWEET_SURFACE_CLIENT_MIN        0x100
+#define SWEET_SURFACE_REQ_LOG           384     /* request lines this boot */
+#define SWEET_SURFACE_SHAPE_LOG         64      /* one shape line per selector */
+
 static IOLock       *sweet_surface_lock;
 static SweetSurface *sweet_surface_table[SWEET_SURFACE_MAX_ID];
