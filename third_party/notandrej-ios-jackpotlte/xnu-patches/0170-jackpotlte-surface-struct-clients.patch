 	IOLog("SWEET SURF: %s %s %u\n", name, what, n);
 }
 
+/* Bring-up instrumentation (jt62): one line per request, so the sequence a
+ * dying display server leaves behind can be read off the panel, and one line
+ * per selector saying the shape of what it asked for.  Both are bounded so a
+ * frame's worth of traffic cannot scroll the crash report itself away. */
+static uint32_t sweet_surf_requests;
+static uint64_t sweet_surf_shaped;
+
+static uint32_t
+sweet_surf_in_size(IOExternalMethodArguments *args)
+{
+	return args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() :
+	    (uint32_t)args->structureInputSize;
+}
+
+static uint32_t
+sweet_surf_out_size(IOExternalMethodArguments *args)
+{
+	return args->structureOutputDescriptor != NULL ?
+	    (uint32_t)args->structureOutputDescriptor->getLength() :
+	    (uint32_t)args->structureOutputSize;
+}
+
+/* The surface id a request names: the first scalar when it has one, otherwise
+ * the first u32 of its structure input.  IOSurface.framework's per-plane and
+ * per-buffer calls (JT 61 sel 6 and 9) pass no scalars at all and put the
+ * client id in the structure, so a fallback that only looks at scalars would
+ * refuse exactly the request that killed the display server. */
+static bool
+sweet_surf_in_id(IOExternalMethodArguments *args, uint32_t *idOut)
+{
+	uint32_t id;
+
+	if (args->scalarInputCount > 0) {
+		*idOut = (uint32_t)args->scalarInput[0];
+		return true;
+	}
+	if (args->structureInputDescriptor != NULL) {
+		if (args->structureInputDescriptor->getLength() < sizeof(id) ||
+		    args->structureInputDescriptor->readBytes(0, &id, sizeof(id)) !=
+		    sizeof(id)) {
+			return false;
+		}
+		*idOut = id;
+		return true;
+	}
+	if (args->structureInput != NULL && args->structureInputSize >= sizeof(id)) {
+		memcpy(&id, args->structureInput, sizeof(id));
+		*idOut = id;
+		return true;
+	}
+	return false;
+}
+
+static void
+sweet_surf_log_request(uint32_t selector, IOExternalMethodArguments *args, uint64_t arg0)
+{
+	char name[32];
+	uint32_t id = 0;
+	bool haveId = sweet_surf_in_id(args, &id);
+
+	if (sweet_surf_requests++ >= SWEET_SURFACE_REQ_LOG) {
+		return;
+	}
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET SURF REQ: %s sel %u arg0 %#llx id %u%s scalarin %u struct %u/%u desc %u/%u\n",
+	    name, selector, (unsigned long long)arg0, id,
+	    haveId ? (args->scalarInputCount > 0 ? "" : " (from struct)") : " (none)",
+	    args->scalarInputCount, sweet_surf_in_size(args), sweet_surf_out_size(args),
+	    args->structureInputDescriptor != NULL,
+	    args->structureOutputDescriptor != NULL);
+}
+
+static void
+sweet_surf_log_shape(uint32_t selector, IOExternalMethodArguments *args)
+{
+	char name[32];
+
+	if (selector >= SWEET_SURFACE_SHAPE_LOG ||
+	    (sweet_surf_shaped & (1ULL << selector))) {
+		return;
+	}
+	sweet_surf_shaped |= 1ULL << selector;
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET SURF SHAPE: %s sel %u scalarin %u struct %u/%u\n",
+	    name, selector, args->scalarInputCount, sweet_surf_in_size(args),
+	    sweet_surf_out_size(args));
+}
+
