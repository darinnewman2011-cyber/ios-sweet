+		if (out >= SWEET_SURFACE_CLIENT_MIN &&
+		    sweet_surf_in_id(args, &id)) {
+			SweetSurface *s = sweet_surface_copy(id);
+			if (s != NULL) {
+				IOReturn ret = sweet_surface_get(s) ?
+				    returnSurface(s, args) : kIOReturnNotFound;
+				s->release();
+				return ret;
+			}
+			IOLog("SWEET SURF: sel %u wants a %u-byte structure; "
+			    "id %u is no surface\n", selector, out, id);
+			sweet_surf_log_once("sel", selector);
+			return kIOReturnUnsupported;
+		}
 		for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
 			args->scalarOutput[i] = 0;
 		}
@@ -783,6 +907,7 @@
