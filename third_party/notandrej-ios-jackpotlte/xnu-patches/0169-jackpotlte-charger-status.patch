+/*
+ * Charger status fields (drivers/battery_v2/include/charger/s2mu004_charger.h):
+ *   STATUS0 CHGIN_STATUS[7:5]   input source, 0 = no input (83-85);
+ *   STATUS1 SELF_DISCHG bit 7, CHG_FAULT[6:3], TOP_OFF bit 1, DONE bit 0
+ *           (91-113);
+ *   STATUS3 BAT_STATUS[2:1], DET_BAT bit 0 (129-134).
+ */
+#define JT_CHGIN(st0)		((unsigned)((st0) >> 5) & 0x7u)
+#define JT_CHG_FAULT(st1)	((unsigned)((st1) >> 3) & 0xfu)
+#define JT_ST1_SELF_DISCHG	0x80u
+#define JT_ST1_TOP_OFF		0x02u
+#define JT_ST1_DONE		0x01u
+#define JT_ST3_DET_BAT		0x01u
+
+/*
+ * CHGIN_STATUS values the vendor driver decodes: 3 and 5 mean "input present,
+ * charging" (s2mu004_charger.c:721-757), 2 is the VBUS over-voltage reported
+ * by its CHGIN interrupt (s2mu004_charger.c:1416-1425), and 0 is "no charger
+ * input" (drivers/muic/s2mu004-muic-afc.c:1305,1337).  The other values are
+ * not named anywhere in the vendor tree, so they are logged raw and treated as
+ * "input present, not charging".
+ */
+#define JT_CHGIN_NONE		0u
+#define JT_CHGIN_OVP		2u
+#define JT_CHGIN_CHARGING(v)	((v) == 3u || (v) == 5u)
+
+/* CHG_FAULT_STATUS values that mean charging has stopped (charger.h:98-103). */
+#define JT_FAULT_WD_SUSPEND	3u
+#define JT_FAULT_WD_RST		4u
+#define JT_FAULT_TSD		5u
+#define JT_FAULT_TFB		6u
