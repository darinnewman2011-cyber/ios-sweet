+/*
+ * Both buses are mapped once and then used by two callers: jackpotlte_pmic_probe()
+ * on the bsd_init thread at root-mount time, and the SweetBattery timer on its
+ * workloop.  Every transfer on either bus is under jp_lock, so a poll can never
+ * interleave with the probe's register sequence (or with itself after a
+ * second caller appears).
+ */
+static vm_offset_t jp_fg;
+static vm_offset_t jp_chg;
+static LCK_GRP_DECLARE(jp_grp, "jackpotlte_pmic");
+static LCK_MTX_DECLARE(jp_lock, &jp_grp);
+
+static bool
+jp_map(void)
+{
+	if (!jp_fg) {
+		jp_fg = ml_io_map(JT_I2C_FUELGAUGE_PA, JT_I2C_WINDOW);
+	}
+	if (!jp_chg) {
+		jp_chg = ml_io_map(JT_I2C_CHARGER_PA, JT_I2C_WINDOW);
+	}
+	return jp_fg && jp_chg;
+}
+
 /* Polled S3C2440 transfer, ported from bsd/dev/a5xelte_touch.c:224-318. */
 static bool
