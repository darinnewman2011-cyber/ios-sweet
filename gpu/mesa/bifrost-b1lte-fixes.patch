@@ -2025,6 +2025,10 @@
       bi_mov_i32_to(b, dst, bi_vertex_id(b));
       break;
 
+   case nir_intrinsic_load_raw_vertex_offset_pan:   /* B1L-0090: left behind by the sysval lowering */
+      bi_mov_i32_to(b, dst, bi_imm_u32(0));
+      break;
+
    case nir_intrinsic_load_instance_id:
       bi_mov_i32_to(b, dst, bi_instance_id(b));
       break;
@@ -5314,6 +5318,24 @@
       nir_metadata_control_flow, NULL);
 }
 
+/* B1L-0090 (ios-b1lte, BSD-2): Bifrost before v9 stores vertex varyings in 32 bits only (bi_emit_store_vary:
+ * "T_size == 32 || (arch >= 9 && T_size == 16)"); Metal's _lph shaders store half. Widened here; the fragment side
+ * keeps reading half (LD_VAR converts). */
+static bool
+b1l_widen_vs_output(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   (void)data;
+   if (intr->intrinsic != nir_intrinsic_store_output || intr->src[0].ssa->bit_size != 16)
+      return false;
+   nir_alu_type t = nir_alu_type_get_base_type(nir_intrinsic_src_type(intr));
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *v = intr->src[0].ssa;
+   nir_def *w = t == nir_type_float ? nir_f2f32(b, v) : t == nir_type_int ? nir_i2i32(b, v) : nir_u2u32(b, v);
+   nir_src_rewrite(&intr->src[0], w);
+   nir_intrinsic_set_src_type(intr, t | 32);
+   return true;
+}
+
 void
 bifrost_preprocess_nir(nir_shader *nir, unsigned gpu_id)
 {
@@ -5383,6 +5405,9 @@
       if (gpu_id >= 0x9000) {
          NIR_PASS(_, nir, nir_lower_mediump_io, nir_var_shader_out,
                   BITFIELD64_BIT(VARYING_SLOT_PSIZ), false);
+      } else {
+         NIR_PASS(_, nir, nir_shader_intrinsics_pass, b1l_widen_vs_output,
+                  nir_metadata_control_flow, NULL);   /* B1L-0090 */
       }
 
       NIR_PASS(_, nir, pan_nir_lower_store_component);
