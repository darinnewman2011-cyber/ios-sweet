diff --git a/bsd/kern/kern_cs.c b/bsd/kern/kern_cs.c
--- a/bsd/kern/kern_cs.c
+++ b/bsd/kern/kern_cs.c
@@ -254,6 +254,19 @@
 
 	p = current_proc();
 
+#if defined(SWEET)
+	/*
+	 * Galaxy A8: arm64e system binaries are rewritten in place by the a8xlate translator, so their page
+	 * hashes no longer match the (unchanged) signature. Allow the page and keep CS_VALID, or launchd
+	 * refuses every translated boot task ("boot task is not a platform binary").
+	 */
+	(void)flags; (void)send_kill; (void)retval; (void)verbose;
+	if (cs_killed) {
+		*cs_killed = FALSE;
+	}
+	return 0;
+#endif
+
 	if (verbose) {
 		printf("CODE SIGNING: cs_invalid_page(0x%llx): p=%d[%s]\n",
 		    vaddr, proc_getpid(p), p->p_comm);
diff --git a/bsd/kern/mach_loader.c b/bsd/kern/mach_loader.c
--- a/bsd/kern/mach_loader.c
+++ b/bsd/kern/mach_loader.c
@@ -1339,11 +1339,17 @@
 								printf("CODE SIGNING: %s[%d]: invalid initial page at offset %lld validated:%d tainted:%d csflags:0x%x\n",
 								    vp->v_name, proc_getpid(p), (long long)(file_offset + off), valid, tainted, result->csflags);
 							}
+#if defined(SWEET)
+							/* A8: a8xlate rewrites translated arm64e binaries (header CPU subtype, code) in
+							 * place; their initial page no longer matches the signature. Keep CS_VALID so the
+							 * process keeps its platform-binary status (launchd checks it for boot tasks). */
+#else
 							if (cs_process_global_enforcement() ||
 							    (result->csflags & (CS_HARD | CS_KILL | CS_ENFORCEMENT))) {
 								ret = LOAD_FAILURE;
 							}
 							result->csflags &= ~CS_VALID;
+#endif
 						}
 						off += PAGE_SIZE;
 					}
