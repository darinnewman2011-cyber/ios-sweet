@@ -99,6 +99,12 @@ enum {
  */
 #define SWEET_FB_LOGICAL_W              1125
 #define SWEET_FB_LOGICAL_H              2436
+/*
+ * Boot-arg sweetfb_ipad=1: iPad 7 (iPad7,11) iPadOS userland. Report its 1620x2160 panel
+ * (810x1080 points @2x) whatever the real panel is; with sweetfb_fit=1 it is scaled to fit.
+ */
+#define SWEET_FB_IPAD_W                 1620
+#define SWEET_FB_IPAD_H                 2160
 #define SWEET_FB_FORMAT_BGRA            0x42475241
 
 class IOMobileFramebuffer : public IOService {
@@ -200,7 +206,12 @@ AppleCLCD::start(IOService *provider)
 	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
 	fLogicalW = fWidth;
 	fLogicalH = fHeight;
-	if (!native && fWidth <= SWEET_FB_LOGICAL_W && fHeight <= SWEET_FB_LOGICAL_H) {
+	int ipad = 0;
+	PE_parse_boot_argn("sweetfb_ipad", &ipad, sizeof(ipad));
+	if (!native && ipad) {
+		fLogicalW = SWEET_FB_IPAD_W;
+		fLogicalH = SWEET_FB_IPAD_H;
+	} else if (!native && fWidth <= SWEET_FB_LOGICAL_W && fHeight <= SWEET_FB_LOGICAL_H) {
 		fLogicalW = SWEET_FB_LOGICAL_W;
 		fLogicalH = SWEET_FB_LOGICAL_H;
 	}
