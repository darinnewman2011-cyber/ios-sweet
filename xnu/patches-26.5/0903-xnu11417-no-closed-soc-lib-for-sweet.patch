diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 92edce2..e2d2f7c 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -1172,7 +1172,9 @@ LD_KERNEL_LIBS	   = -lcc_kext
 LD_KERNEL_ARCHIVES = $(LDFLAGS_KERNEL_SDK) -lfirehose_kernel
 
 # Link binary support library
-ifneq ($(CURRENT_MACHINE_CONFIG),NONE)
+# sweet: only if the KDK ships one for this machine config (there is no libSWEET.os.*.a;
+# xnu-10063 and older never force-loaded it)
+ifneq ($(wildcard $(KDKROOT)/System/Library/KernelSupport/lib$(CURRENT_MACHINE_CONFIG).os.$(CURRENT_KERNEL_CONFIG).a),)
         LDFLAGS_KERNEL_ONLY += -rdynamic -Wl,-force_load,$(KDKROOT)/System/Library/KernelSupport/lib$(CURRENT_MACHINE_CONFIG).os.$(CURRENT_KERNEL_CONFIG).a
 endif
 
@@ -1217,6 +1219,10 @@ TIGHTBEAM_IN_SDK := 1
 else ifneq ($(wildcard $(KDKROOT)/usr/local/lib/kernel/platform/libTightbeam.a),)
 XNU_CONFIG_TIGHTBEAM := 1
 endif
+# sweet: no Tightbeam library is linked, so its kext interface cannot be exported
+ifeq ($(CURRENT_MACHINE_CONFIG),SWEET)
+XNU_CONFIG_TIGHTBEAM :=
+endif
 ifeq ($(XNU_CONFIG_TIGHTBEAM),1)
   ifeq ($(TIGHTBEAM_IN_SDK),1)
     # Force-import the Tightbeam static lib so that all of its symbols can be exported to kexts
