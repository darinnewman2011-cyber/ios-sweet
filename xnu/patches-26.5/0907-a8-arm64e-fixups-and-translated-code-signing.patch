diff --git a/bsd/kern/kern_cs.c b/bsd/kern/kern_cs.c
index c1c3929..c70f88e 100644
--- a/bsd/kern/kern_cs.c
+++ b/bsd/kern/kern_cs.c
@@ -254,6 +254,16 @@ cs_invalid_page(addr64_t vaddr, boolean_t *cs_killed)
 
 	p = current_proc();
 
+#if defined(SWEET)
+	/* A8: a8xlate rewrites translated arm64e binaries in place; their page hashes no longer match. Allow the
+	 * page and keep CS_VALID (launchd refuses boot tasks without platform-binary status). */
+	(void)flags; (void)send_kill; (void)retval; (void)verbose;
+	if (cs_killed) {
+		*cs_killed = FALSE;
+	}
+	return 0;
+#endif
+
 	if (verbose) {
 		printf("CODE SIGNING: cs_invalid_page(0x%llx): p=%d[%s]\n",
 		    vaddr, proc_getpid(p), p->p_comm);
diff --git a/bsd/kern/mach_loader.c b/bsd/kern/mach_loader.c
index 2c16ff7..1859e1b 100644
--- a/bsd/kern/mach_loader.c
+++ b/bsd/kern/mach_loader.c
@@ -1805,11 +1805,15 @@ parse_machfile(
 								printf("CODE SIGNING: %s[%d]: invalid initial page at offset %lld validated:%d tainted:%d csflags:0x%x\n",
 								    vp->v_name, proc_getpid(p), (long long)(file_offset + off), valid, tainted, result->csflags);
 							}
+#if defined(SWEET)
+							/* A8: translated binaries (rewritten header/code) keep CS_VALID and platform status */
+#else
 							if (cs_process_global_enforcement() ||
 							    (result->csflags & (CS_HARD | CS_KILL | CS_ENFORCEMENT))) {
 								ret = LOAD_FAILURE;
 							}
 							result->csflags &= ~CS_VALID;
+#endif
 						}
 						off += PAGE_SIZE;
 					}
