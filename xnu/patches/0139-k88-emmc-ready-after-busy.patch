diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 09ba744..6c61479 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1093,6 +1093,29 @@ k88_tran(uint32_t rca)
 	return R1_STATE(resp) == 4;
 }
 
+/*
+ * After an R1b command the card can still read ready for a moment before its
+ * busy period starts; at the CPU's turbo clock (xnu 0138) the next CMD6 came
+ * that early and timed out (ios6). Poll CMD13 until the card is in TRAN with
+ * READY_FOR_DATA, up to 1 s.
+ */
+static bool
+k88_wait_ready(uint32_t rca)
+{
+	for (int i = 0; i < 1000; i++) {
+		uint32_t resp = 0, st = mmc_cmd(13, rca << 16, CMDR_RESP_48 | CMDR_CRC | CMDR_INDEX, 0, &resp);
+		if (st != UINT32_MAX && !(st & INT_ERR) && R1_STATE(resp) == 4 && (resp & R1_READY)) {
+			return true;
+		}
+		if (st == UINT32_MAX || (st & INT_ERR)) {
+			mmc_abort();
+		}
+		delay(1000);
+	}
+	printf("SWEET MMC: card not ready (RCA %u) after 1 s\n", rca);
+	return false;
+}
+
 /* R1b command, then DAT0 released; true if answered without error */
 static bool
 k88_cmd_b(uint32_t idx, uint32_t arg)
@@ -1149,7 +1172,7 @@ ufs_take_over_host(void)
 		}
 	}
 	for (uint32_t rca = 1; rca <= 3 && !mmc_rca; rca++) {
-		if (k88_cmd_b(5, rca << 16) && k88_cmd_b(7, rca << 16) && k88_tran(rca)) {
+		if (k88_cmd_b(5, rca << 16) && k88_cmd_b(7, rca << 16) && k88_wait_ready(rca)) {
 			mmc_rca = rca;              /* woken from LK's sleep (LK uses RCA 2) */
 		}
 	}
@@ -1157,8 +1180,11 @@ ufs_take_over_host(void)
 		printf("SWEET MMC: card does not answer at RCA 1-3, int 0x%x\n", ufs_rd(HC_INT));
 		return ENXIO;
 	}
-	if (!k88_cmd_b(6, (3u << 24) | (185u << 16) | (1u << 8)) ||     /* HS_TIMING = high speed */
-	    !k88_cmd_b(6, (3u << 24) | (183u << 16) | (2u << 8))) {     /* BUS_WIDTH = 8 */
+	if (!k88_wait_ready(mmc_rca) ||
+	    !k88_cmd_b(6, (3u << 24) | (185u << 16) | (1u << 8)) ||     /* HS_TIMING = high speed */
+	    !k88_wait_ready(mmc_rca) ||
+	    !k88_cmd_b(6, (3u << 24) | (183u << 16) | (2u << 8)) ||     /* BUS_WIDTH = 8 */
+	    !k88_wait_ready(mmc_rca)) {
 		printf("SWEET MMC: CMD6 (high speed, 8-bit) failed\n");
 		return EIO;
 	}
