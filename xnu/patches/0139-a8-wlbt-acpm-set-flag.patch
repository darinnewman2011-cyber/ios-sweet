+	}
+	(void)runtime;
+	printf("SWEET A8 WLBT: %s: boot marker %#x (mailbox2 ISSR1-7 %#x %#x %#x %#x %#x %#x %#x)\n", when, rd(mbox2, ISSR(0)),
+	    rd(mbox2, ISSR(1)), rd(mbox2, ISSR(2)), rd(mbox2, ISSR(3)), rd(mbox2, ISSR(4)), rd(mbox2, ISSR(5)),
+	    rd(mbox2, ISSR(6)), rd(mbox2, ISSR(7)));
+	printf("SWEET A8 WLBT: %s: CTRL_NS %#x STAT %#x | INTSR0 %#x INTSR1 %#x | mbox %#x %#x %#x %#x | mgmt in w%u r%u, out "
+	    "w%u r%u, log w%u r%u, gdb4 w%u | heap words set %u | panic %08x %08x %08x %08x\n", when, rd(pmu, WIFI_CTRL_NS),
+	    rd(pmu, WIFI_STAT), rd(mbox, INTSR0), rd(mbox, INTSR1), rd(mbox, ISSR(0)), rd(mbox, ISSR(1)), rd(mbox, ISSR(2)),
+	    rd(mbox, ISSR(3)), rd(shm, mgmt_in.widx), rd(shm, mgmt_in.ridx), rd(shm, mgmt_out.widx), rd(shm, mgmt_out.ridx),
+	    rd(shm, log_in.widx), rd(shm, log_in.ridx), rd(shm, gdb4_in.widx), changed, rd(shm, panic_off), rd(shm, panic_off + 4),
+	    rd(shm, panic_off + 8), rd(shm, panic_off + 12));
+}
+
+static void
+dump_words(const char *what, uint32_t off, uint32_t words)
+{
+	for (uint32_t i = 0; i < words; i += 8) {
+		printf("SWEET A8 WLBT: %s +%03x: %08x %08x %08x %08x %08x %08x %08x %08x\n", what, i * 4, rd(shm, off + i * 4),
+		    rd(shm, off + i * 4 + 4), rd(shm, off + i * 4 + 8), rd(shm, off + i * 4 + 12), rd(shm, off + i * 4 + 16),
+		    rd(shm, off + i * 4 + 20), rd(shm, off + i * 4 + 24), rd(shm, off + i * 4 + 28));
+	}
+}
+
+static void
+final_dump(uint32_t panic_off)
+{
+	uint32_t w = rd(shm, mgmt_in.widx) % mgmt_in.num;
+	uint32_t lw = rd(shm, log_in.widx);
+
+	printf("SWEET A8 WLBT: management packets from the core: %u (MM_START_IND is channel 0, payload 0)\n", w);
+	for (uint32_t i = 0; i < w && i < 8; i++) {
+		printf("SWEET A8 WLBT: mgmt %u: %08x %08x\n", i, rd(shm, mgmt_in.buf + i * 8), rd(shm, mgmt_in.buf + i * 8 + 4));
+	}
+	printf("SWEET A8 WLBT: mxlog write index %u\n", lw);
+	dump_words("mxlog", log_in.buf, lw > 0 && lw < 64 ? ((lw + 7u) & ~7u) : 64);
+	dump_words("panic record", panic_off, 56);
+}
+
+static void
+wlbt_thread(void *arg, wait_result_t wr_)
+{
+	uint32_t size = 0, runtime, entry, panic_off, magic;
+	char build[80];
+	int error;
+
+	(void)arg;
+	(void)wr_;
+	app_state("waiting", "radio core test starts 60 s after boot");
+	sleep_ms(60000);                /* the root file system is mounted and the boot is past its busiest */
+	app_state("starting", "loading the WLBT firmware");
+	shm = ml_io_map(SHM_PA, SHM_SIZE);
+	mbox = ml_io_map(MBOX_PA, 0x1000);
+	mbox2 = ml_io_map(MBOX2_PA, 0x1000);
+	pmu = ml_io_map(PMU_PA, 0x8000);
+	if (!shm || !mbox || !pmu || !mbox2) {
+		printf("SWEET A8 WLBT: cannot map the registers\n");
+		goto out;
+	}
+	printf("SWEET A8 WLBT: 1 look: mailbox2 IS_VERSION %#x ISSR0-3 %#x %#x %#x %#x\n", rd(mbox2, IS_VERSION),
+	    rd(mbox2, ISSR(0)), rd(mbox2, ISSR(1)), rd(mbox2, ISSR(2)), rd(mbox2, ISSR(3)));
+	printf("SWEET A8 WLBT: 1 look: mailbox IS_VERSION %#x, WIFI_CTRL_NS %#x CTRL_S %#x STAT %#x, MEM_CONFIG0 %#x CONFIG1 %#x, "
+	    "ext regulator option %#x status %#x\n", rd(mbox, IS_VERSION), rd(pmu, WIFI_CTRL_NS), rd(pmu, WIFI_CTRL_S),
+	    rd(pmu, WIFI_STAT), rd(pmu, MEM_CONFIG0), rd(pmu, MEM_CONFIG1), rd(pmu, EXT_REG_OPTION), rd(pmu, EXT_REG_STATUS));
+
+	for (uint32_t off = 0; off < SHM_SIZE; off += 4) {
+		wr(shm, off, 0);
+	}
+	if ((error = load_firmware(&size))) {
+		printf("SWEET A8 WLBT: 2 load: %s: error %d (put the phone's /vendor/etc/wifi/mx140.bin there)\n", FW_PATH, error);
+		app_state("off", "WLBT firmware file missing (mx140.bin)");
+		goto out;
+	}
+	magic = rd(shm, 8);
+	runtime = rd(shm, 36);
+	entry = rd(shm, 40);
+	panic_off = rd(shm, 176);
+	for (int i = 0; i < (int)sizeof(build) - 1; i += 4) {
+		uint32_t w = rd(shm, 48 + (uint32_t)i);
+		memcpy(build + i, &w, 4);
+	}
+	build[sizeof(build) - 1] = '\0';
+	printf("SWEET A8 WLBT: 2 load: %u bytes, magic %.4s, runtime length %#x, entry %#x, panic record at %#x, build %s\n",
+	    size, (const char *)&magic, runtime, entry, panic_off, build);
+	if (memcmp(&magic, "smxf", 4) != 0 || runtime >= SHM_SIZE || runtime < size || panic_off >= runtime) {
+		printf("SWEET A8 WLBT: 2 load: not a firmware this probe understands; stopping\n");
+		goto out;
+	}
+
+	uint64_t tz = smc4(0x82000710u, 0, SHM_PA, SHM_SIZE);
+	printf("SWEET A8 WLBT: 3 TrustZone window for the shared memory: SMC returns %#llx\n", tz);
+
+	wr(pmu, MEM_CONFIG1, (SHM_PA & 0xfffffc000u) >> 12);
+	wr(pmu, MEM_CONFIG0, SHM_SIZE >> 12);
+	{
+		/* Stage 3b: the second window (BAAW1, BT-ABOX shared memory) Samsung's platform_mif_reset sets up next to the
+		 * main one; ios61's panic record shows the core in abort mode 250 ms after start without it. */
+		/* Not mapped or cleared: a second 4 MB ml_io_map panicked in kmem_alloc (ios62); the firmware does not
+		 * need the window zeroed. */
+		printf("SWEET A8 WLBT: 3b BT-ABOX window was CONFIG2 %#x CONFIG3 %#x; now %#x at %#x\n", rd(pmu, MEM_CONFIG2),
+		    rd(pmu, MEM_CONFIG3), BTABOX_SIZE, BTABOX_PA);
+		wr(pmu, MEM_CONFIG3, (BTABOX_PA & 0xfffffc000u) >> 12);
+		wr(pmu, MEM_CONFIG2, BTABOX_SIZE >> 12);
+	}
+	wr(pmu, BOOT_RST_CFG, 0);
+	for (int i = 0; i < 64; i++) {
+		wr(mbox, ISSR(i), 0);
+	}
+	wr(mbox, INTMR0, 0xffff0000u);
+	wr(mbox, INTMR1, 0x0000ffffu);
+	wr(mbox, INTCR0, 0xffff0000u);
+	wr(mbox, INTCR1, 0x0000ffffu);
+	uint32_t conf_at = mxconf_build(runtime);
+	printf("SWEET A8 WLBT: 4 configuration at %#x (%u bytes), mgmt in buf %#x idx %#x/%#x, log buf %#x, heap end %#x\n",
+	    conf_at, conf_len, mgmt_in.buf, mgmt_in.ridx, mgmt_in.widx, log_in.buf, heap_next);
+	wr(mbox, ISSR(0), entry);
+	wr(mbox, ISSR(1), conf_at);
+	wr(mbox, ISSR(2), 0xbcdeedcbu);
+	wr(mbox, ISSR(3), 0);
+	printf("SWEET A8 WLBT: 4 set up: MEM_CONFIG0 %#x CONFIG1 %#x, mailboxes %#x %#x %#x %#x\n", rd(pmu, MEM_CONFIG0),
+	    rd(pmu, MEM_CONFIG1), rd(mbox, ISSR(0)), rd(mbox, ISSR(1)), rd(mbox, ISSR(2)), rd(mbox, ISSR(3)));
+	report("before start", runtime, panic_off);
+
+	/* Stage 3c (xnu 0139): runs 61-63 panicked ~250 ms after start (R4 record v2, checksum good, panic code 4).
+	 * Samsung sends ACPM SET_FLAG right before reset release so BUCK2 is at WLBT's voltage; do the same.
+	 * The result is repeated in every watch line: the one-off line scrolls out of the 16 KB ramoops window (run 77). */
+	uint32_t fr[4] = { 0 };
+	int fe = sweet_a8_acpm_wlbt_flag(fr);
+	printf("SWEET A8 WLBT: 4c ACPM SET_FLAG (BUCK2 for WLBT): error %d, reply %#x %#x %#x %#x\n", fe, fr[0], fr[1],
+	    fr[2], fr[3]);
+	wr(pmu, EXT_REG_OPTION, rd(pmu, EXT_REG_OPTION) | 0x4u);
+	wr(pmu, WIFI_CTRL_NS, rd(pmu, WIFI_CTRL_NS) | (1u << 1));
+	wr(pmu, WIFI_CTRL_NS, rd(pmu, WIFI_CTRL_NS) & ~(1u << 2));
+	wr(pmu, WIFI_CTRL_S, rd(pmu, WIFI_CTRL_S) | (1u << 3));
+	printf("SWEET A8 WLBT: 5 started (PWRON, reset released, START)\n");
+	{
+		char d[200];
+
+		snprintf(d, sizeof(d), "radio core started; power flag %s (err %d)", fe == 0 ? "accepted" : "refused", fe);
+		app_state("starting", d);
+	}
+	for (int t = 1; t <= 20; t++) {
+		char when[80], d[200];
+
+		sleep_ms(t <= 4 ? 250 : 1000);
+		snprintf(when, sizeof(when), "watch %d (SET_FLAG err %d, reply %#x %#x %#x %#x)", t, fe, fr[0], fr[1],
+		    fr[2], fr[3]);
+		report(when, runtime, panic_off);
+		uint32_t p0 = rd(shm, panic_off), p1 = rd(shm, panic_off + 4), p2 = rd(shm, panic_off + 8),
+		    p3 = rd(shm, panic_off + 12), mw = rd(shm, mgmt_in.widx);
+		if (p0 | p1 | p2 | p3) {
+			snprintf(d, sizeof(d), "radio firmware crashed at boot step %#x (record %08x %08x %08x %08x; power flag err %d)",
+			    rd(mbox2, ISSR(0)), p0, p1, p2, p3, fe);
+			app_state("off", d);
+		} else if (mw) {
+			snprintf(d, sizeof(d), "radio firmware running, %u messages from the core (Wi-Fi scan not built yet)", mw);
+			app_state("on", d);
+		} else {
+			snprintf(d, sizeof(d), "radio core started, waiting for its first message (%d of 20)", t);
+			app_state("starting", d);
+		}
+	}
+	final_dump(panic_off);
+	wr(pmu, EXT_REG_OPTION, rd(pmu, EXT_REG_OPTION) & ~0x4u);
+	printf("SWEET A8 WLBT: done; the core is left as it is until the next boot\n");
+out:
+	(void)thread_terminate(current_thread());
+}
+
+void
+sweet_a8_wlbt_init(void)
+{
+	int on = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("a8wlbt", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	if (kernel_thread_start(wlbt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("SWEET A8 WLBT: probe armed (a8wlbt=1): it runs 60 s from now\n");
+	}
+}
+#endif /* SWEET_JACKPOTLTE */
