+/* Builds the configuration in the heap and returns its offset (mailbox 1). */
+static uint32_t
+mxconf_build(uint32_t runtime)
+{
+	uint32_t at;
+
+	heap_next = (runtime + 15u) & ~15u;
+	at = heap_alloc(sizeof(conf));
+	stream_make(&mgmt_in, 64, 8, 1, 0, 1);
+	stream_make(&mgmt_out, 64, 8, 1, 2, 0);
+	stream_make(&gdb4_in, 512, 4, 3, 2, 1);
+	stream_make(&gdb4_out, 512, 4, 3, 0, 0);
+	stream_make(&gdbm_in, 512, 4, 1, 4, 1);
+	stream_make(&gdbm_out, 512, 4, 5, 0, 0);
+	stream_make(&log_in, 4096, 4, 4, 6, 1);
+	memset(conf, 0, sizeof(conf));
+	conf_len = 0;
+	put32(0x79828486u);
+	put32(0u | (1u << 16));         /* major 0, minor 1 */
+	put_stream(&mgmt_in);
+	put_stream(&mgmt_out);
+	put_stream(&gdb4_in);
+	put_stream(&gdb4_out);
+	put_stream(&gdbm_in);
+	put_stream(&gdbm_out);
+	put_stream(&log_in);
+	for (uint32_t i = 0; i < sizeof(conf); i += 4) {
+		uint32_t w;
+
+		memcpy(&w, conf + i, 4);
+		wr(shm, at + i, w);
+	}
+	return at;
+}
+
+static void
+report(const char *when, uint32_t runtime, uint32_t panic_off)
+{
+	unsigned changed = 0;
+
+	for (uint32_t off = heap_next; off < heap_next + 0x10000 && off < SHM_SIZE; off += 4) {
+		changed += rd(shm, off) != 0;
+	}
+	(void)runtime;
+	printf("SWEET A8 WLBT: %s: boot marker %#x (mailbox2 ISSR1-7 %#x %#x %#x %#x %#x %#x %#x)\n", when, rd(mbox2, ISSR(0)),
+	    rd(mbox2, ISSR(1)), rd(mbox2, ISSR(2)), rd(mbox2, ISSR(3)), rd(mbox2, ISSR(4)), rd(mbox2, ISSR(5)),
+	    rd(mbox2, ISSR(6)), rd(mbox2, ISSR(7)));
+	printf("SWEET A8 WLBT: %s: CTRL_NS %#x STAT %#x | INTSR0 %#x INTSR1 %#x | mbox %#x %#x %#x %#x | mgmt in w%u r%u, out "
+	    "w%u r%u, log w%u r%u, gdb4 w%u | heap words set %u | panic %08x %08x %08x %08x\n", when, rd(pmu, WIFI_CTRL_NS),
+	    rd(pmu, WIFI_STAT), rd(mbox, INTSR0), rd(mbox, INTSR1), rd(mbox, ISSR(0)), rd(mbox, ISSR(1)), rd(mbox, ISSR(2)),
+	    rd(mbox, ISSR(3)), rd(shm, mgmt_in.widx), rd(shm, mgmt_in.ridx), rd(shm, mgmt_out.widx), rd(shm, mgmt_out.ridx),
+	    rd(shm, log_in.widx), rd(shm, log_in.ridx), rd(shm, gdb4_in.widx), changed, rd(shm, panic_off), rd(shm, panic_off + 4),
+	    rd(shm, panic_off + 8), rd(shm, panic_off + 12));
+}
+
+static void
+dump_words(const char *what, uint32_t off, uint32_t words)
+{
+	for (uint32_t i = 0; i < words; i += 8) {
+		printf("SWEET A8 WLBT: %s +%03x: %08x %08x %08x %08x %08x %08x %08x %08x\n", what, i * 4, rd(shm, off + i * 4),
+		    rd(shm, off + i * 4 + 4), rd(shm, off + i * 4 + 8), rd(shm, off + i * 4 + 12), rd(shm, off + i * 4 + 16),
+		    rd(shm, off + i * 4 + 20), rd(shm, off + i * 4 + 24), rd(shm, off + i * 4 + 28));
+	}
+}
+
+static void
+final_dump(uint32_t panic_off)
+{
+	uint32_t w = rd(shm, mgmt_in.widx) % mgmt_in.num;
+	uint32_t lw = rd(shm, log_in.widx);
+
+	printf("SWEET A8 WLBT: management packets from the core: %u (MM_START_IND is channel 0, payload 0)\n", w);
+	for (uint32_t i = 0; i < w && i < 8; i++) {
+		printf("SWEET A8 WLBT: mgmt %u: %08x %08x\n", i, rd(shm, mgmt_in.buf + i * 8), rd(shm, mgmt_in.buf + i * 8 + 4));
+	}
+	printf("SWEET A8 WLBT: mxlog write index %u\n", lw);
+	dump_words("mxlog", log_in.buf, lw > 0 && lw < 64 ? ((lw + 7u) & ~7u) : 64);
+	dump_words("panic record", panic_off, 56);
+}
+
+/*
+ * Stage 6 (xnu 0139): WLAN service + HIP4 + scan, once the core has sent MM_START_IND.
+ * Protocol facts read from Samsung's GPL scsc / scsc_wlan drivers (servman_messages.h, mifstream.c, cpacket_buffer.c,
+ * platform_mif.c, hip4.c/h, mbulk_def.h, mbulk.c, fapi.h, mlme.c, cfg80211_ops.c); no code copied.
+ *   service start: mgmt packet {chan 1, service 1 (WLAN), SM_MSG_START_REQ 0, ref of the HIP control block (LE32)}
+ *   HIP4 control (packed): init {0xcaaa0400, fw version, ref v4, ref v3} @0, config v3 @32, v4 @160 (120 bytes each),
+ *   scoreboard @320 (byte indices, host/fw owned), 6 queues of 256 refs @1344 + 1088 * q.
+ *   WLAN region (2 MB, 4 KB aligned): config 0, MIB (hcf minus 8-byte header) 0x2000, host buffers 0x3000 (ctl pool
+ *   0x70000, 32 x 2 KB), firmware buffers 0x80000.
+ *   mbulk header 20 bytes {next_ofs, flag, clas, pid, refcnt, dat_bufsz, sig_bufsz, len, head, chain}; the signal sits
+ *   at +24 (4 bytes the firmware reserves), data at +20 + head.
+ */
+#define INTGR1          0x01cu
+#define WL_SIZE         0x200000u
+#define WL_MIB          0x2000u
+#define WL_MIB_MAX      0x1000u
+#define WL_TX           0x3000u
+#define WL_TX_SIZE      0x7d000u
+#define WL_CTL          0x70000u
+#define WL_CTL_SLOT     0x800u
+#define WL_RX           0x80000u
+#define WL_RX_SIZE      0x100000u
+#define HC_INIT         0u
+#define HC_V3           32u
+#define HC_V4           160u
+#define HC_SCBRD        320u
+#define HC_Q(i)         (1344u + 1088u * (uint32_t)(i))
+#define FH_INT          5               /* from-host bits 0 (panic) and 1-4 are the mxconf streams' */
+#define TH_INT          7               /* to-host bits 0-6 likewise */
+#define SIG_ADD_SCAN_REQ        0x2005
+#define SIG_ADD_SCAN_CFM        0x2105
+#define SIG_SCAN_IND            0x2300
+#define SIG_SCAN_DONE_IND       0x2301
+#define SIG_ADD_VIF_REQ         0x2007
+#define SIG_ADD_VIF_CFM         0x2107
+#define SIG_DEL_VIF_REQ         0x2008
+#define SIG_CONNECT_REQ         0x200b
+#define SIG_CONNECT_CFM         0x210b
+#define SIG_CONNECT_RES         0x2200
+#define SIG_CONNECT_IND         0x2303
+#define SIG_CONNECTED_IND       0x2304
+#define SIG_DISCONNECTED_IND    0x2309
+#define SIG_PROC_STARTED_IND    0x230a
+enum { Q_FH_CTRL, Q_FH_DAT, Q_FH_RFB, Q_TH_CTRL, Q_TH_DAT, Q_TH_RFB };
+static const uint8_t q_layout[6][2] = { { 0, 64 }, { 1, 65 }, { 66, 2 }, { 67, 3 }, { 68, 4 }, { 5, 69 } };
+
+extern int IODTGetLoaderInfo(const char *key, void **infoAddr, int *infoSize);
+typedef int (*sweet_a8net_handler_t)(const char *cmd);
+extern void sweet_a8net_set_handler(int which, sweet_a8net_handler_t h);
+
+struct wnet {
+	uint8_t bssid[6];
+	char ssid[33];
+	int16_t rssi;
+	uint8_t secure;
+	uint16_t mhz;
+};
+static uint32_t wl;
+static unsigned ctl_slot;
+static uint8_t headroom, tailroom;
+static uint8_t wl_mac[6];
+static struct wnet nets[48];
+static int n_nets;
+static volatile int scan_req;
+static int scanning;
+static uint64_t scan_t0;
+static uint32_t wl_sigs, wl_scan_inds;
+static char wl_status[160];
+static char join_ssid[33];
+static volatile int join_req;
+static int vif_up, joining, connected;  /* station vif 1 added; join in progress; associated */
+static uint32_t rx_frames;
+static ifnet_t wl_ifp;
+static int dh_state, dh_tries;  /* DHCP: 0 idle, 1 DISCOVER sent, 2 REQUEST sent, 3 ACKed, 4 configured, 5 gave up */
+static char net_note[96];
+static void net_attach(void);
+static void net_rx(uint16_t dud, const uint8_t *f, uint32_t n);
+
+static inline void wl_dmb(void) { __asm__ volatile ("dmb sy" ::: "memory"); }
+static inline void wl_dsb(void) { __asm__ volatile ("dsb sy" ::: "memory"); }
+static uint8_t rd8(uint32_t off) { return *(volatile uint8_t *)(shm + off); }
+static void wr8(uint32_t off, uint8_t v) { *(volatile uint8_t *)(shm + off) = v; }
+static uint16_t rd16(uint32_t off) { return (uint16_t)(rd8(off) | (uint16_t)rd8(off + 1) << 8); }
+static void wr16(uint32_t off, uint16_t v) { wr8(off, (uint8_t)v); wr8(off + 1, (uint8_t)(v >> 8)); }
+static void put16(uint8_t *p, uint16_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+
+static void
+ring_r4(int bit)
+{
+	wl_dsb();
+	wr(mbox, INTGR1, 1u << bit);
+}
+
+static uint8_t
+q_idx(int q, int r)
+{
+	wl_dmb();
+	return rd8(wl + HC_SCBRD + q_layout[q][r]);
+}
+
+static void
+q_set(int q, int r, uint8_t v)
+{
+	wl_dmb();
+	wr8(wl + HC_SCBRD + q_layout[q][r], v);
+	wl_dsb();
+}
+
+static int
+q_put(int q, uint32_t ref)
+{
+	uint8_t w = q_idx(q, 0), r = q_idx(q, 1);
+
+	if ((uint8_t)(w + 1) == r) {
+		return ENOSPC;
+	}
+	wr(shm, wl + HC_Q(q) + 4u * w, ref);
+	q_set(q, 0, (uint8_t)(w + 1));
+	ring_r4(FH_INT);
+	return 0;
+}
+
+/* One control signal (FAPI header + body in sig[]) with optional bulk data, from the host control pool. */
+static int
+sig_send(const uint8_t *sig, uint32_t sig_len, const uint8_t *data, uint32_t data_len)
+{
+	uint32_t m = wl + WL_CTL + WL_CTL_SLOT * ctl_slot;
+	uint32_t sbuf = ((20u + 4u + sig_len + 3u) & ~3u) - 20u;
+	uint32_t dbuf = data_len ? data_len + headroom + tailroom : 0;
+
+	if (20u + sbuf + dbuf > WL_CTL_SLOT) {
+		return E2BIG;
+	}
+	ctl_slot = (ctl_slot + 1) % 32;
+	for (uint32_t o = 0; o < 20u + sbuf + dbuf + 4u; o += 4) {
+		wr(shm, m + o, 0);
+	}
+	wr8(m + 4, 1 | 4);                      /* MBULK_F_SIG | MBULK_F_OBOUND: the firmware asserts (0x84afb/0x2a01,
+	                                         * ios87) unless (flag & 0x24) == 0x04; Linux sets it last in skb_to_mbulk */
+	wr8(m + 5, 1);                          /* MBULK_CLASS_FROM_HOST_CTL */
+	wr8(m + 6, 1);                          /* host control pool */
+	wr8(m + 7, data_len ? 1 : 0);
+	wr16(m + 8, (uint16_t)dbuf);
+	wr16(m + 10, (uint16_t)sbuf);
+	wr16(m + 12, (uint16_t)data_len);
+	wr16(m + 14, (uint16_t)(sbuf + (data_len ? headroom : 0)));
+	for (uint32_t i = 0; i < sig_len; i++) {
+		wr8(m + 24 + i, sig[i]);
+	}
+	for (uint32_t i = 0; i < data_len; i++) {
+		wr8(m + 20 + sbuf + headroom + i, data[i]);
+	}
+	wl_dsb();
+	return q_put(Q_FH_CTRL, m);
+}
+
+static uint32_t
+sig_hdr(uint8_t *s, uint16_t id, uint16_t vif)
+{
+	memset(s, 0, 64);
+	put16(s, id);
+	put16(s + 4, 0xc001);                   /* SLSI_TX_PROCESS_ID_MIN */
+	put16(s + 10, vif);
+	return 12;
+}
+
+static int
+same_ssid(const char *a, const char *b)
+{
+	for (int i = 0; i < 33; i++) {
+		if (a[i] != b[i]) {
+			return 0;
+		}
+		if (!a[i]) {
+			return 1;
+		}
+	}
+	return 1;
+}
+
+static void
+wl_publish(const char *word, const char *detail)
+{
+	static char text[4096];
+	uint8_t done[48] = { 0 };
+	int n = snprintf(text, sizeof(text), "state %s %s\n", word, detail);
+
+	/* strongest first, one line per SSID */
+	for (;;) {
+		int best = -1;
+		for (int i = 0; i < n_nets; i++) {
+			if (!done[i] && (best < 0 || nets[i].rssi > nets[best].rssi)) {
+				best = i;
+			}
+		}
+		if (best < 0 || n > (int)sizeof(text) - 96) {
+			break;
+		}
+		done[best] = 1;
+		int dup = 0;
+		for (int i = 0; i < n_nets; i++) {
+			if (i != best && done[i] == 2 && same_ssid(nets[i].ssid, nets[best].ssid)) {
+				dup = 1;
+			}
+		}
+		if (dup) {
+			continue;
+		}
+		done[best] = 2;
+		n += snprintf(text + n, sizeof(text) - (size_t)n, "net %s\t%d\t%d\t%d\n", nets[best].ssid, nets[best].rssi,
+		    nets[best].secure ? 1 : 0, connected && same_ssid(nets[best].ssid, join_ssid) ? 1 : 0);
+	}
+	sweet_a8net_publish(0, text);
+}
+
+static void
+scan_result(int16_t rssi, uint16_t freq_half_mhz, const uint8_t *f, uint32_t len)
+{
+	struct wnet w;
+	int i;
+
+	if (len < 36) {
+		return;
+	}
+	memset(&w, 0, sizeof(w));
+	for (i = 0; i < 6; i++) {
+		w.bssid[i] = f[16 + i];
+	}
+	w.rssi = rssi;
+	w.mhz = (uint16_t)(freq_half_mhz / 2);
+	w.secure = (f[34] & 0x10) ? 1 : 0;        /* capability: privacy */
+	for (uint32_t p = 36; p + 2 <= len;) {
+		uint8_t id = f[p], l = f[p + 1];
+		if (p + 2 + l > len) {
+			break;
+		}
+		if (id == 0 && l <= 32) {
+			for (i = 0; i < l; i++) {
+				char c = (char)f[p + 2 + (uint32_t)i];
+				w.ssid[i] = (c < 32 || c == 127) ? '?' : c;
+			}
+			w.ssid[l] = 0;
+		} else if (id == 48) {
+			w.secure = 2;
+		}
+		p += 2u + l;
+	}
+	if (!w.ssid[0] || w.ssid[0] == '?') {
+		return;                         /* hidden network */
+	}
+	for (i = 0; i < n_nets; i++) {
+		if (memcmp(nets[i].bssid, w.bssid, 6) == 0) {
+			nets[i] = w;
+			return;
+		}
+	}
+	if (n_nets < (int)(sizeof(nets) / sizeof(nets[0]))) {
+		nets[n_nets++] = w;
+	}
+}
+
+static void
+send_scan(void)
+{
+	static const uint16_t mhz[] = { 2412, 2417, 2422, 2427, 2432, 2437, 2442, 2447, 2452, 2457, 2462, 2467, 2472,
+		                        5180, 5200, 5220, 5240, 5260, 5280, 5300, 5320,
+		                        5500, 5520, 5540, 5560, 5580, 5600, 5620, 5640, 5660, 5680, 5700, 5720,
+		                        5745, 5765, 5785, 5805, 5825 };
+	uint8_t s[64], d[160];
+	uint32_t dl = 0, ch;
+	int e;
+
+	sig_hdr(s, SIG_ADD_SCAN_REQ, 0);        /* scans go on vif 0; vif 1 exists only after MLME_ADD_VIF at connect */
+	put16(s + 12, 0x0100);                  /* scan id: ifnum 1 << 8 | SLSI_SCAN_HW_ID */
+	put16(s + 14, 2);                       /* FAPI_SCANTYPE_FULL_SCAN */
+	memcpy(s + 16, wl_mac, 6);
+	put16(s + 22, 0x0004);                  /* FAPI_REPORTMODE_REAL_TIME */
+	d[dl++] = 0;                            /* wildcard SSID element */
+	d[dl++] = 0;
+	{
+		static const uint8_t timing[19] = { 0xdd, 0x11, 0x00, 0x16, 0x32, 0x01, 0x01 };
+		memcpy(d + dl, timing, sizeof(timing));
+		dl += sizeof(timing);
+	}
+	ch = dl;
+	d[dl++] = 0xdd;
+	d[dl++] = 5;
+	d[dl++] = 0x00;
+	d[dl++] = 0x16;
+	d[dl++] = 0x32;
+	d[dl++] = 0x01;
+	d[dl++] = 0x02;
+	for (unsigned i = 0; i < sizeof(mhz) / sizeof(mhz[0]); i++) {
+		put16(d + dl, (uint16_t)(mhz[i] * 2));
+		d[dl + 2] = 0;                  /* active */
+		dl += 3;
+		d[ch + 1] = (uint8_t)(d[ch + 1] + 3);
+	}
+	n_nets = 0;
+	e = sig_send(s, 36, d, dl);
+	printf("SWEET A8 WIFI: scan request sent: error %d (%u bytes of elements)\n", e, dl);
+	scanning = (e == 0);
+	scan_t0 = mach_absolute_time();
+	wl_publish("on", e ? "scan request could not be queued" : "scanning...");
+}
+
+/* A signal with no body beyond vif + 3 spares (MLME_CONNECT_RES, MLME_DEL_VIF_REQ). */
+static int
+short_sig(uint16_t id)
+{
+	uint8_t s[64];
+
+	sig_hdr(s, id, 1);
+	return sig_send(s, 24, NULL, 0);
+}
+
+static void
+del_vif(void)
+{
+	if (vif_up) {
+		(void)short_sig(SIG_DEL_VIF_REQ);
+		vif_up = 0;
+	}
+	connected = 0;
+	dh_state = 0;
+	if (wl_ifp) {
+		ifnet_set_flags(wl_ifp, 0, IFF_RUNNING);
+	}
+}
+
+static int join_idx = -1;
+static uint64_t join_t0;
+
+static void
+send_add_vif(void)
+{
+	uint8_t s[64];
+	int e;
+
+	sig_hdr(s, SIG_ADD_VIF_REQ, 1);
+	memcpy(s + 12, wl_mac, 6);              /* interface address */
+	put16(s + 18, 2);                       /* FAPI_VIFTYPE_STATION; device address stays zero (no P2P) */
+	e = sig_send(s, 38, NULL, 0);
+	printf("SWEET A8 WIFI: add station vif: error %d\n", e);
+}
+
+static void
+send_connect(void)
+{
+	uint8_t s[64], d[40];
+	uint32_t l = (uint32_t)strlen(nets[join_idx].ssid);
+	int e;
+
+	sig_hdr(s, SIG_CONNECT_REQ, 1);
+	memcpy(s + 12, nets[join_idx].bssid, 6);
+	put16(s + 18, 0);                       /* NL80211_AUTHTYPE_OPEN_SYSTEM */
+	put16(s + 20, (uint16_t)(nets[join_idx].mhz * 2));
+	d[0] = 0;                               /* SSID element; no RSN element for an open network */
+	d[1] = (uint8_t)l;
+	memcpy(d + 2, nets[join_idx].ssid, l);
+	e = sig_send(s, 34, d, 2 + l);
+	printf("SWEET A8 WIFI: connect request to %s on %u MHz: error %d\n", nets[join_idx].ssid, nets[join_idx].mhz, e);
+}
+
+static void
+start_join(void)
+{
+	join_idx = -1;
+	for (int i = 0; i < n_nets; i++) {
+		if (same_ssid(nets[i].ssid, join_ssid) && (join_idx < 0 || nets[i].rssi > nets[join_idx].rssi)) {
+			join_idx = i;
+		}
+	}
+	if (join_idx < 0) {
+		wl_publish("on", "that network was not in the last scan; scan again and retry");
+		return;
+	}
+	if (nets[join_idx].secure) {
+		wl_publish("on", "password networks come in the next build; open networks work now");
+		return;
+	}
+	if (connected) {
+		del_vif();
+	}
+	joining = 1;
+	join_t0 = mach_absolute_time();
+	snprintf(wl_status, sizeof(wl_status), "joining %s...", join_ssid);
+	wl_publish("on", wl_status);
+	if (vif_up) {
+		send_connect();
+	} else {
+		send_add_vif();
+	}
+}
+
+static void
+join_failed(const char *what, uint16_t res)
+{
+	joining = 0;
+	snprintf(wl_status, sizeof(wl_status), "%s (result %#x)", what, res);
+	printf("SWEET A8 WIFI: %s\n", wl_status);
+	del_vif();
+	wl_publish("on", wl_status);
+}
+
+static void
+wl_signal(uint32_t sig, uint32_t sig_len, const uint8_t *dat, uint32_t dat_len)
+{
+	uint16_t id = rd16(sig);
+
+	wl_sigs++;
+	if (wl_sigs <= 200 && id != SIG_SCAN_IND && id < 0x8000) {     /* 0x8301 = firmware debug text */
+		printf("SWEET A8 WIFI: signal %#x from the firmware (%u + %u bytes): %04x %04x %04x %04x\n", id, sig_len, dat_len,
+		    rd16(sig + 10), rd16(sig + 12), rd16(sig + 14), rd16(sig + 16));
+	}
+	switch (id) {
+	case SIG_ADD_SCAN_CFM:
+		if (rd16(sig + 12) != 0) {
+			snprintf(wl_status, sizeof(wl_status), "scan refused (result %#x)", rd16(sig + 12));
+			scanning = 0;
+			wl_publish("on", wl_status);
+		}
+		break;
+	case SIG_SCAN_IND:
+		wl_scan_inds++;
+		scan_result((int16_t)rd16(sig + 14), rd16(sig + 12), dat, dat_len);
+		break;
+	case SIG_SCAN_DONE_IND:
+		scanning = 0;
+		snprintf(wl_status, sizeof(wl_status), "%d networks found (%u results)", n_nets, wl_scan_inds);
+		printf("SWEET A8 WIFI: scan done: %u results, %d networks\n", wl_scan_inds, n_nets);
+		wl_publish("on", wl_status);
+		break;
+	case SIG_ADD_VIF_CFM:
+		if (rd16(sig + 12) != 0) {
+			join_failed("could not create the station interface", rd16(sig + 12));
+		} else {
+			vif_up = 1;
+			if (joining) {
+				send_connect();
+			}
+		}
+		break;
+	case SIG_CONNECT_CFM:
+		if (rd16(sig + 12) != 0) {
+			join_failed("join refused", rd16(sig + 12));
+		}
+		break;
+	case SIG_CONNECT_IND:
+		if (rd16(sig + 12) != 0) {
+			join_failed("join failed", rd16(sig + 12));
+		} else {
+			(void)short_sig(SIG_CONNECT_RES);
+			joining = 0;
+			connected = 1;
+			rx_frames = 0;
+			dh_state = 0;
+			dh_tries = 0;
+			net_note[0] = 0;
+			net_attach();
+			snprintf(wl_status, sizeof(wl_status), "connected to %s", join_ssid);
+			printf("SWEET A8 WIFI: %s\n", wl_status);
+			wl_publish("on", wl_status);
+		}
+		break;
+	case SIG_DISCONNECTED_IND:
+		snprintf(wl_status, sizeof(wl_status), "disconnected from %s (reason %u)", join_ssid, rd16(sig + 18));
+		printf("SWEET A8 WIFI: %s\n", wl_status);
+		joining = 0;
+		del_vif();
+		wl_publish("on", wl_status);
+		break;
+	default:
+		break;
+	}
+}
+
+/* Drains one to-host queue: hands each signal to wl_signal and gives the buffers (and chains) back on TH_RFB. */
+static void
+wl_drain(int q)
+{
+	uint8_t r = q_idx(q, 1), w = q_idx(q, 0);
+
+	while (r != w) {
+		uint32_t ref = rd(shm, wl + HC_Q(q) + 4u * r);
+		if (ref >= wl && ref < wl + WL_SIZE - 64) {
+			static uint8_t rxb[8192];
+			uint16_t sbuf = rd16(ref + 10), len = rd16(ref + 12), head = rd16(ref + 14);
+			uint8_t flag = rd8(ref + 4);
+			uint32_t n = 0, c = 0;
+
+			/* Bulk data: this segment's, then any chained segments (Linux hip4_mbulk_to_skb). Beacons in
+			 * MLME_SCAN_IND arrive as a signal-only head with the frame in the chain (0 networks on ios89). */
+			for (uint32_t i = 0; i < len && n < sizeof(rxb); i++) {
+				rxb[n++] = rd8(ref + 20u + head + i);
+			}
+			if ((flag & 0xc0) == 0xc0) {
+				c = rd(shm, ref + 16);
+			}
+			for (int k = 0; k < 16 && c >= wl && c < wl + WL_SIZE - 64; k++) {
+				uint16_t cl = rd16(c + 12), ch = rd16(c + 14);
+				uint32_t next = (rd8(c + 4) & 0x80) ? rd(shm, c + 16) : 0;
+				for (uint32_t i = 0; i < cl && n < sizeof(rxb); i++) {
+					rxb[n++] = rd8(c + 20u + ch + i);
+				}
+				(void)q_put(Q_TH_RFB, c);
+				c = next;
+			}
+			if ((flag & 1) && sbuf >= 4 + 10 && (q == Q_TH_CTRL || rd16(ref + 24) != 0x1300)) {
+				wl_signal(ref + 24, sbuf - 4u, rxb, n);
+			}
+			if (q == Q_TH_DAT) {
+				rx_frames++;
+				if ((flag & 1) && sbuf >= 4 + 14 && rd16(ref + 24) == 0x1300) {
+					net_rx(rd16(ref + 24 + 12), rxb, n);
+				}
+			}
+			(void)q_put(Q_TH_RFB, ref);
+		}
+		r++;
+		q_set(q, 1, r);
+	}
+}
+
+static int
+wl_cmd(const char *cmd)
+{
+	if (cmd[0] == 's' && cmd[1] == 'c' && cmd[2] == 'a' && cmd[3] == 'n') {
+		scan_req = 1;
+	} else if (cmd[0] == 'o' && cmd[1] == 'n') {
+		scan_req = 1;
+	} else if (cmd[0] == 'j' && cmd[1] == 'o' && cmd[2] == 'i' && cmd[3] == 'n' && cmd[4] == ' ') {
+		int i;
+		for (i = 0; i < 32 && cmd[5 + i] && cmd[5 + i] != '\t' && cmd[5 + i] != '\n'; i++) {
+			join_ssid[i] = cmd[5 + i];
+		}
+		join_ssid[i] = 0;
+		join_req = i > 0;
+	}
+	return 0;
+}
+
+/* Management packets from the core: returns 1 when SM_MSG_START_CFM for WLAN arrived. */
+static int
+mgmt_poll(void)
+{
+	uint32_t r = rd(shm, mgmt_in.ridx) % mgmt_in.num, w = rd(shm, mgmt_in.widx) % mgmt_in.num;
+	int cfm = 0;
+
+	while (r != w) {
+		uint32_t a = rd(shm, mgmt_in.buf + r * 8), b = rd(shm, mgmt_in.buf + r * 8 + 4);
+		printf("SWEET A8 WIFI: mgmt packet %u: %08x %08x\n", r, a, b);
+		if ((a & 0xffffff) == 0x010101) {
+			cfm = 1;                /* channel 1, service WLAN, SM_MSG_START_CFM */
+		}
+		r = (r + 1) % mgmt_in.num;
+	}
+	wl_dsb();
+	wr(shm, mgmt_in.ridx, r);
+	ring_r4(mgmt_in.rbit);
+	return cfm;
+}
+
+static void
+mgmt_send(uint8_t chan, uint8_t a, uint8_t b, uint32_t ref)
+{
+	uint32_t w = rd(shm, mgmt_out.widx) % mgmt_out.num, at = mgmt_out.buf + w * 8;
+
+	wr(shm, at, chan | (uint32_t)a << 8 | (uint32_t)b << 16 | (ref & 0xffu) << 24);
+	wr(shm, at + 4, ref >> 8);
+	wl_dsb();
+	wr(shm, mgmt_out.widx, (w + 1) % mgmt_out.num);
+	ring_r4(mgmt_out.wbit);
+}
+
+/*
+ * ---- en2: the Wi-Fi link as an Ethernet interface for iOS ----
+ * Legacy-model ifnet with the stock ether_* demux/framer, so ARP and IPv4 are XNU's own. Frames go out as
+ * MA_UNITDATA_REQ (IEEE 802.3 frame, peer index 1 = the AP) from the host data pool, and come in as
+ * MA_UNITDATA_IND on TH_DAT (802.3 or A-MSDU). There is no IOKit network family in this kernel, so configd does not
+ * adopt the interface: a small DHCP client here sets the address and default route, and a self-test fetches
+ * http://1.1.1.1/ to prove the path. DNS for apps needs configd (next step).
+ */
+#define TXQ             64
+#define DAT_SLOTS       ((WL_CTL - WL_TX) / WL_CTL_SLOT)
+LCK_GRP_DECLARE(sweet_wl_grp, "sweet_wl");
+LCK_MTX_DECLARE(sweet_wl_txlock, &sweet_wl_grp);
+static mbuf_t txq[TXQ];
+static unsigned txq_w, txq_r, dat_slot;
+static uint16_t host_tag;
+static uint32_t tx_frames, tx_drops, rx_other;
+static uint8_t dh_ip[4], dh_srv[4], dh_mask[4], dh_gw[4], dh_dns[4];
+static uint32_t dh_xid;
+static uint64_t dh_t;
+static volatile int net_note_new;
+
+static errno_t
+en_output(ifnet_t ifp, mbuf_t m)
+{
+	int ok = 0;
+
+	(void)ifp;
+	lck_mtx_lock(&sweet_wl_txlock);
+	if (connected && txq_w - txq_r < TXQ) {
+		txq[txq_w++ % TXQ] = m;
+		ok = 1;
+	}
+	lck_mtx_unlock(&sweet_wl_txlock);
+	if (!ok) {
+		tx_drops++;
+		mbuf_freem(m);
+		return 0;
+	}
+	thread_wakeup(&wlbt_chan);
+	return 0;
+}
+
+static errno_t
+en_ioctl(ifnet_t ifp, u_long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+	case SIOCSIFMTU:
+		return 0;
+	default:
+		return ether_ioctl(ifp, (u_int32_t)cmd, data);
+	}
+}
+
+/* One Ethernet frame as MA_UNITDATA_REQ on FH_DAT; called only from the Wi-Fi thread. */
+static int
+dat_send(const uint8_t *f, uint32_t len)
+{
+	uint32_t m = wl + WL_TX + WL_CTL_SLOT * dat_slot;
+	uint32_t sbuf = ((20u + 4u + 34u + 3u) & ~3u) - 20u;
+	uint32_t dbuf = len + headroom + tailroom;
+	uint8_t s[64];
+
+	if (len < 14 || 20u + sbuf + dbuf > WL_CTL_SLOT) {
+		return E2BIG;
+	}
+	dat_slot = (dat_slot + 1) % DAT_SLOTS;
+	sig_hdr(s, 0x1000, 1);                  /* MA_UNITDATA_REQ on vif 1 */
+	host_tag = (uint16_t)(host_tag + 4);
+	put16(s + 12, host_tag);
+	put16(s + 14, 0x8000);                  /* FAPI_PRIORITY_CONTENTION */
+	put16(s + 16, 1);                       /* peer index: the AP */
+	put16(s + 18, 1);                       /* FAPI_DATAUNITDESCRIPTOR_IEEE802_3_FRAME */
+	for (uint32_t o = 0; o < 20u + sbuf + headroom; o += 4) {
+		wr(shm, m + o, 0);
+	}
+	wr8(m + 4, 1 | 4);                      /* SIG | OBOUND */
+	wr8(m + 5, 0);                          /* MBULK_CLASS_FROM_HOST_DAT, AC 0 */
+	wr8(m + 6, 0 | (1 << 3) | (1 << 1));    /* data pool 0, colour: peer 1, vif 1 */
+	wr8(m + 7, 1);
+	wr16(m + 8, (uint16_t)dbuf);
+	wr16(m + 10, (uint16_t)sbuf);
+	wr16(m + 12, (uint16_t)len);
+	wr16(m + 14, (uint16_t)(sbuf + headroom));
+	for (uint32_t i = 0; i < 34; i++) {
+		wr8(m + 24 + i, s[i]);
+	}
+	for (uint32_t i = 0; i < len; i++) {
+		wr8(m + 20 + sbuf + headroom + i, f[i]);
+	}
+	wl_dsb();
+	if (q_put(Q_FH_DAT, m) != 0) {
+		tx_drops++;
+		return ENOSPC;
+	}
+	tx_frames++;
+	return 0;
+}
+
+static void
+net_tx_drain(void)
+{
+	static uint8_t fb[1600];
+
+	for (;;) {
+		mbuf_t m = NULL;
+		lck_mtx_lock(&sweet_wl_txlock);
+		if (txq_r != txq_w) {
+			m = txq[txq_r++ % TXQ];
+		}
+		lck_mtx_unlock(&sweet_wl_txlock);
+		if (!m) {
+			return;
+		}
+		size_t len = mbuf_pkthdr_len(m);
+		if (len <= sizeof(fb) && mbuf_copydata(m, 0, len, fb) == 0) {
+			struct ifnet_stat_increment_param st = { 0 };
+			if (dat_send(fb, (uint32_t)len) == 0) {
+				st.packets_out = 1;
+				st.bytes_out = (u_int32_t)len;
+			} else {
+				st.errors_out = 1;
+			}
+			ifnet_stat_increment(wl_ifp, &st);
+		}
+		mbuf_freem(m);
+	}
+}
+
+static uint16_t
+ip_sum(const uint8_t *p, int n)
+{
+	uint32_t s = 0;
+
+	for (int i = 0; i + 1 < n; i += 2) {
+		s += (uint32_t)p[i] << 8 | p[i + 1];
+	}
+	while (s >> 16) {
+		s = (s & 0xffff) + (s >> 16);
+	}
+	return (uint16_t)~s;
+}
+
+static void
+dhcp_send(int type)
+{
+	uint8_t f[14 + 20 + 8 + 300];
+	uint8_t *ip = f + 14, *u = ip + 20, *b = u + 8, *o = b + 240;
+	uint16_t s;
+
+	memset(f, 0, sizeof(f));
+	memset(f, 0xff, 6);
+	memcpy(f + 6, wl_mac, 6);
+	f[12] = 0x08;
+	ip[0] = 0x45;
+	ip[2] = (uint8_t)((20 + 8 + 300) >> 8);
+	ip[3] = (uint8_t)(20 + 8 + 300);
+	ip[8] = 64;
+	ip[9] = 17;
+	memset(ip + 16, 0xff, 4);
+	s = ip_sum(ip, 20);
+	ip[10] = (uint8_t)(s >> 8);
+	ip[11] = (uint8_t)s;
+	u[1] = 68;
+	u[3] = 67;
+	u[4] = (uint8_t)((8 + 300) >> 8);
+	u[5] = (uint8_t)(8 + 300);
+	b[0] = 1;                               /* BOOTREQUEST, Ethernet, 6-byte address */
+	b[1] = 1;
+	b[2] = 6;
+	memcpy(b + 4, &dh_xid, 4);
+	b[10] = 0x80;                           /* broadcast the reply: no address yet */
+	memcpy(b + 28, wl_mac, 6);
+	b[236] = 0x63; b[237] = 0x82; b[238] = 0x53; b[239] = 0x63;
+	*o++ = 53; *o++ = 1; *o++ = (uint8_t)type;
+	*o++ = 61; *o++ = 7; *o++ = 1; memcpy(o, wl_mac, 6); o += 6;
+	if (type == 3) {
+		*o++ = 50; *o++ = 4; memcpy(o, dh_ip, 4); o += 4;
+		*o++ = 54; *o++ = 4; memcpy(o, dh_srv, 4); o += 4;
+	}
+	*o++ = 12; *o++ = 6; memcpy(o, "iPhone", 6); o += 6;
+	*o++ = 55; *o++ = 3; *o++ = 1; *o++ = 3; *o++ = 6;
+	*o++ = 255;
+	(void)dat_send(f, sizeof(f));
+	dh_t = mach_absolute_time();
+}
+
+static void
+dhcp_rx(const uint8_t *ip, uint32_t n)
+{
+	uint32_t ihl = (ip[0] & 15u) * 4u;
+	const uint8_t *b;
+	int type = 0;
+	uint8_t mask[4] = { 255, 255, 255, 0 }, gw[4] = { 0 }, dns[4] = { 0 }, srv[4] = { 0 };
+
+	if (n < ihl + 8 + 240 || ip[ihl + 3] != 68) {
+		return;
+	}
+	b = ip + ihl + 8;
+	if (b[0] != 2 || memcmp(b + 4, &dh_xid, 4) != 0 || b[236] != 0x63 || b[239] != 0x63) {
+		return;
+	}
+	for (uint32_t p = 240; p + 2 <= n - ihl - 8 && b[p] != 255;) {
+		uint8_t c = b[p], l = b[p + 1];
+		if (c == 0) {
+			p++;
+			continue;
+		}
+		if (p + 2 + l > n - ihl - 8) {
+			break;
+		}
+		if (c == 53 && l >= 1) {
+			type = b[p + 2];
+		} else if (c == 1 && l >= 4) {
+			memcpy(mask, b + p + 2, 4);
+		} else if (c == 3 && l >= 4) {
+			memcpy(gw, b + p + 2, 4);
+		} else if (c == 6 && l >= 4) {
+			memcpy(dns, b + p + 2, 4);
+		} else if (c == 54 && l >= 4) {
+			memcpy(srv, b + p + 2, 4);
+		}
+		p += 2u + l;
+	}
+	printf("SWEET A8 WIFI: DHCP message %d: %u.%u.%u.%u\n", type, b[16], b[17], b[18], b[19]);
+	if (type == 2 && dh_state == 1) {
+		memcpy(dh_ip, b + 16, 4);
+		memcpy(dh_srv, srv, 4);
+		dh_state = 2;
+		dhcp_send(3);
+	} else if (type == 5 && dh_state == 2) {
+		memcpy(dh_ip, b + 16, 4);
+		memcpy(dh_mask, mask, 4);
+		memcpy(dh_gw, gw, 4);
+		memcpy(dh_dns, dns, 4);
+		dh_state = 3;
+	} else if (type == 6) {
+		dh_state = 0;                   /* NAK: start over */
+	}
+}
+
+/* One received Ethernet frame (12 address bytes + type/payload): DHCP replies are ours, the rest goes to XNU. */
+static void
+net_deliver(const uint8_t *addrs, const uint8_t *rest, uint32_t rlen)
+{
+	mbuf_t m = NULL;
+	uint32_t len = 12 + rlen;
+
+	if (rlen >= 2 + 20 + 8 && rest[0] == 0x08 && rest[1] == 0x00 && rest[2 + 9] == 17 &&
+	    rlen >= 2u + (rest[2] & 15u) * 4u + 8u && rest[2 + ((rest[2] & 15) * 4) + 3] == 68) {
+		dhcp_rx(rest + 2, rlen - 2);
+		return;
+	}
+	if (!wl_ifp || len < 14 || len > 2000 || mbuf_getpacket(MBUF_DONTWAIT, &m) != 0) {
+		return;
+	}
+	if (mbuf_maxlen(m) < len) {
+		mbuf_freem(m);
+		return;
+	}
+	memcpy(mbuf_data(m), addrs, 12);
+	memcpy((uint8_t *)mbuf_data(m) + 12, rest, rlen);
+	mbuf_setlen(m, len);
+	mbuf_pkthdr_setlen(m, len);
+	mbuf_pkthdr_setrcvif(m, wl_ifp);
+	mbuf_pkthdr_setheader(m, mbuf_data(m));
+	mbuf_setdata(m, (uint8_t *)mbuf_data(m) + 14, len - 14);
+	mbuf_pkthdr_adjustlen(m, -14);
+	struct ifnet_stat_increment_param st = { 0 };
+	st.packets_in = 1;
+	st.bytes_in = len;
+	ifnet_input(wl_ifp, m, &st);
+}
+
+static void
+net_rx(uint16_t dud, const uint8_t *f, uint32_t n)
+{
+	if (dud == 1 && n >= 14) {                      /* IEEE 802.3 frame */
+		net_deliver(f, f + 12, n - 12);
+	} else if (dud == 3) {                          /* A-MSDU: DA SA len | LLC/SNAP type payload | pad to 4 */
+		for (uint32_t p = 0; p + 14 <= n;) {
+			uint32_t ml = (uint32_t)f[p + 12] << 8 | f[p + 13];
+			if (ml < 8 || p + 14 + ml > n) {
+				break;
+			}
+			net_deliver(f + p, f + p + 14 + 6, ml - 6);
+			p += (14 + ml + 3) & ~3u;
+		}
+	} else {
+		rx_other++;
+	}
+}
+
+static void
+net_attach(void)
+{
+	static const uint8_t bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	struct ifnet_init_eparams p;
+	struct sockaddr_dl sdl;
+	errno_t e;
+
+	if (wl_ifp) {
+		ifnet_set_flags(wl_ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+		return;
+	}
+	memset(&p, 0, sizeof(p));
+	p.ver = IFNET_INIT_CURRENT_VERSION;
+	p.len = sizeof(p);
+	p.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO;
+	p.uniqueid = "sweet-a8-wlan";
+	p.uniqueid_len = 13;
+	p.name = "en";
+	p.unit = 2;
+	p.family = IFNET_FAMILY_ETHERNET;
+	p.type = IFT_ETHER;
+	p.output = en_output;
+	p.demux = ether_demux;
+	p.add_proto = ether_add_proto;
+	p.del_proto = ether_del_proto;
+	p.check_multi = ether_check_multi;
+	p.framer_extended = ether_frameout_extended;
+	p.ioctl = en_ioctl;
+	p.broadcast_addr = bcast;
+	p.broadcast_len = 6;
+	e = ifnet_allocate_extended(&p, &wl_ifp);
+	if (e) {
+		printf("SWEET A8 WIFI: ifnet_allocate_extended: %d\n", e);
+		wl_ifp = NULL;
+		return;
+	}
+	ifnet_set_mtu(wl_ifp, 1500);
+	ifnet_set_hdrlen(wl_ifp, 14);
+	ifnet_set_addrlen(wl_ifp, 6);
+	ifnet_set_baudrate(wl_ifp, 72000000);
+	ifnet_set_flags(wl_ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST | IFF_UP | IFF_RUNNING, 0xffff);
+	memset(&sdl, 0, sizeof(sdl));
+	sdl.sdl_len = sizeof(sdl);
+	sdl.sdl_family = AF_LINK;
+	sdl.sdl_type = IFT_ETHER;
+	sdl.sdl_alen = 6;
+	memcpy(LLADDR(&sdl), wl_mac, 6);
+	e = ifnet_attach(wl_ifp, &sdl);
+	printf("SWEET A8 WIFI: en2 attach %d, inet plumb %d\n", e, e ? -1 : proto_plumb(PF_INET, wl_ifp));
+}
+
+static void
+sin_set(struct sockaddr_in *s, const uint8_t *a)
+{
+	memset(s, 0, sizeof(*s));
+	s->sin_len = sizeof(*s);
+	s->sin_family = AF_INET;
+	if (a) {
+		memcpy(&s->sin_addr, a, 4);
+	}
+}
+
+static void
+net_test(void *arg, wait_result_t w)
+{
+	static const uint8_t one[4] = { 1, 1, 1, 1 };
+	static const char req[] = "GET / HTTP/1.0\r\nHost: one.one.one.one\r\n\r\n";
+	struct sockaddr_in sa;
+	struct timeval tv = { 15, 0 };
+	socket_t so = NULL;
+	char line[48] = "";
+	errno_t e;
+
+	(void)arg;
+	(void)w;
+	sin_set(&sa, one);
+	sa.sin_port = htons(80);
+	e = sock_socket(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &so);
+	if (e == 0) {
+		(void)sock_setsockopt(so, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+		(void)sock_setsockopt(so, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+		e = sock_connect(so, (struct sockaddr *)&sa, 0);
+		if (e == 0) {
+			struct iovec iov = { (void *)(uintptr_t)req, sizeof(req) - 1 };
+			struct msghdr mh;
+			size_t got = 0;
+			memset(&mh, 0, sizeof(mh));
+			mh.msg_iov = &iov;
+			mh.msg_iovlen = 1;
+			e = sock_send(so, &mh, 0, &got);
+			if (e == 0) {
+				iov.iov_base = line;
+				iov.iov_len = sizeof(line) - 1;
+				e = sock_receive(so, &mh, MSG_WAITALL, &got);
+				line[got < sizeof(line) ? got : sizeof(line) - 1] = 0;
+				for (char *c = line; *c; c++) {
+					if (*c == '\r' || *c == '\n') {
+						*c = 0;
+						break;
+					}
+				}
+				if (got > 0) {
+					e = 0;
+				}
+			}
+		}
+		sock_close(so);
+	}
+	if (e == 0 && line[0]) {
+		snprintf(net_note, sizeof(net_note), "internet works (1.1.1.1 answered %s)", line);
+	} else {
+		snprintf(net_note, sizeof(net_note), "internet test failed (error %d)", e);
+	}
+	printf("SWEET A8 WIFI: %s\n", net_note);
+	net_note_new = 1;
+	thread_wakeup(&wlbt_chan);
+}
+
+static void
+net_config(void)
+{
+	struct ifaliasreq ifra;
+	struct sockaddr_in dst, gw, msk;
+	uint8_t bc[4];
+	socket_t so = NULL;
+	errno_t e, er = -1;
+	thread_t t;
+
+	memset(&ifra, 0, sizeof(ifra));
+	strlcpy(ifra.ifra_name, "en2", sizeof(ifra.ifra_name));
+	for (int i = 0; i < 4; i++) {
+		bc[i] = (uint8_t)(dh_ip[i] | ~dh_mask[i]);
+	}
+	sin_set((struct sockaddr_in *)&ifra.ifra_addr, dh_ip);
+	sin_set((struct sockaddr_in *)&ifra.ifra_broadaddr, bc);
+	sin_set((struct sockaddr_in *)&ifra.ifra_mask, dh_mask);
+	e = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	if (e == 0) {
+		e = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+	}
+	if (e == 0 && (dh_gw[0] | dh_gw[1] | dh_gw[2] | dh_gw[3])) {
+		sin_set(&dst, NULL);
+		sin_set(&gw, dh_gw);
+		sin_set(&msk, NULL);
+		er = rtrequest(RTM_ADD, (struct sockaddr *)&dst, (struct sockaddr *)&gw, (struct sockaddr *)&msk,
+		    RTF_UP | RTF_GATEWAY | RTF_STATIC, NULL);
+	}
+	snprintf(net_note, sizeof(net_note), "IP %u.%u.%u.%u, router %u.%u.%u.%u%s", dh_ip[0], dh_ip[1], dh_ip[2], dh_ip[3],
+	    dh_gw[0], dh_gw[1], dh_gw[2], dh_gw[3], e ? " (address not set)" : er ? " (no default route)" : ", testing...");
+	printf("SWEET A8 WIFI: DHCP bound: %s; address %d route %d; DNS %u.%u.%u.%u\n", net_note, e, er, dh_dns[0], dh_dns[1],
+	    dh_dns[2], dh_dns[3]);
+	net_note_new = 1;
+	if (e == 0 && kernel_thread_start(net_test, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+
+/* Called every loop pass while associated. */
+static void
+net_tick(uint64_t now, uint64_t lim3)
+{
+	net_tx_drain();
+	if (dh_state == 0 || ((dh_state == 1 || dh_state == 2) && mach_absolute_time() - dh_t > lim3)) {
+		if (dh_tries++ >= 10) {
+			dh_state = 5;
+			snprintf(net_note, sizeof(net_note), "no address from the router (DHCP got no answer)");
+			net_note_new = 1;
+			return;
+		}
+		dh_xid = (uint32_t)mach_absolute_time() ^ 0x5a3c0000u;
+		dh_state = 1;
+		dhcp_send(1);
+	} else if (dh_state == 3) {
+		dh_state = 4;
+		net_config();
+	}
+}
+
+static void
+put_cfg(uint32_t at, uint16_t ver, uint32_t mib_sz)
+{
+	wr(shm, at + 0, 0xcaba0401u);
+	wr(shm, at + 4, ver | (120u << 16));
+	wr(shm, at + 28, 64u << 24);            /* host_cache_line */
+	wr(shm, at + 32, wl + WL_TX);
+	wr(shm, at + 36, WL_TX_SIZE);
+	wr(shm, at + 40, wl + WL_RX);
+	wr(shm, at + 44, WL_RX_SIZE);
+	wr(shm, at + 48, mib_sz ? wl + WL_MIB : 0);
+	wr(shm, at + 52, mib_sz);
+	wr(shm, at + 64, FH_INT | (TH_INT << 8));
+	wr(shm, at + 68, wl + HC_SCBRD);
+	wr(shm, at + 72, 6u | (256u << 16));
+	wr(shm, at + 76, 1u);
+	for (int i = 0; i < 6; i++) {
+		wr(shm, at + 80 + 4u * (uint32_t)i, wl + HC_Q(i));
+	}
+}
+
+static void
+wifi_run(uint32_t panic_off)
+{
+	void *bpa = NULL;
+	int bsz = 0, cfm = 0;
+	uint32_t mib_sz = 0, ver, cfg;
+	uint64_t now, lim15, lim2, lim3, pub_t0 = 0;
+	char d[200];
+
+	heap_next = (heap_next + 0xfffu) & ~0xfffu;
+	wl = heap_next;
+	if (wl + WL_SIZE > SHM_SIZE) {
+		app_state("off", "radio running, but no room for the Wi-Fi buffers");
+		return;
+	}
+	heap_next += WL_SIZE;
+	for (uint32_t o = 0; o < WL_TX; o += 4) {
+		wr(shm, wl + o, 0);
+	}
+	if (IODTGetLoaderInfo("SweetWLANHCF", &bpa, &bsz) == 0 && bsz > 8) {
+		const uint8_t *h = (const uint8_t *)ml_static_ptovirt((vm_offset_t)bpa);
+		if (h[7] == 1 && (uint32_t)bsz - 8 <= WL_MIB_MAX) {
+			mib_sz = (uint32_t)bsz - 8;
+			for (uint32_t i = 0; i < mib_sz; i++) {
+				wr8(wl + WL_MIB + i, h[8 + i]);
+			}
+		}
+	}
+	put_cfg(wl + HC_V4, 4, mib_sz);
+	put_cfg(wl + HC_V3, 3, mib_sz);
+	wr(shm, wl + HC_INIT + 0, 0xcaaa0400u);
+	wr(shm, wl + HC_INIT + 8, wl + HC_V4);
+	wr(shm, wl + HC_INIT + 12, wl + HC_V3);
+	{
+		uint64_t t = mach_absolute_time();
+		wl_mac[0] = 0x02;               /* locally administered */
+		for (int i = 1; i < 6; i++) {
+			wl_mac[i] = (uint8_t)(t >> (8 * i));
+		}
+	}
+	(void)mgmt_poll();                      /* consumes MM_START_IND */
+	printf("SWEET A8 WIFI: WLAN region at %#x, MIB %u bytes; sending SM_MSG_START_REQ\n", wl, mib_sz);
+	mgmt_send(1, 1, 0, wl + HC_INIT);
+	for (int t = 0; t < 300 && !cfm; t++) {
+		sleep_ms(10);
+		cfm = mgmt_poll();
+	}
+	ver = rd(shm, wl + HC_INIT + 4);
+	cfg = ver == 3 ? HC_V3 : HC_V4;
+	headroom = rd8(wl + cfg + 28);
+	tailroom = rd8(wl + cfg + 29);
+	snprintf(d, sizeof(d), "Wi-Fi service %s (HIP v%u, MLME SAP %#x, room %u/%u, MIB %u bytes)", cfm ? "started" :
+	    "did not confirm", ver, rd16(wl + cfg + 12), headroom, tailroom, mib_sz);
+	printf("SWEET A8 WIFI: %s; compat %#x build %u\n", d, rd(shm, wl + cfg + 8), rd(shm, wl + cfg + 20));
+	if (!cfm || (ver != 3 && ver != 4)) {
+		wl_publish("off", d);
+		return;
+	}
+	wl_publish("on", d);
+	sweet_a8net_set_handler(0, wl_cmd);
+	scan_req = 1;
+	nanoseconds_to_absolutetime(15ull * NSEC_PER_SEC, &lim15);
+	nanoseconds_to_absolutetime(2ull * NSEC_PER_SEC, &lim2);
+	nanoseconds_to_absolutetime(3ull * NSEC_PER_SEC, &lim3);
+	for (;;) {
+		wl_drain(Q_TH_CTRL);
+		wl_drain(Q_TH_DAT);
+		q_set(Q_FH_RFB, 1, q_idx(Q_FH_RFB, 0));     /* host buffers given back: our pool is round-robin */
+		now = mach_absolute_time();
+		if (scanning && now - scan_t0 > lim15) {
+			scanning = 0;
+			snprintf(wl_status, sizeof(wl_status), "scan timed out: %d networks, %u results, %u signals", n_nets,
+			    wl_scan_inds, wl_sigs);
+			wl_publish("on", wl_status);
+		}
+		if (join_req && !scanning && !joining) {
+			join_req = 0;
+			start_join();
+		}
+		if (joining && mach_absolute_time() - join_t0 > lim15) {        /* join_t0 can be newer than now (ios90) */
+			join_failed("join timed out", 0);
+		}
+		if (scan_req && !scanning && !joining) {
+			scan_req = 0;
+			send_scan();
+		}
+		if (connected) {
+			net_tick(now, lim3);
+		}
+		if (connected && (net_note_new || now - pub_t0 > lim2)) {
+			static uint32_t last_rx;
+			pub_t0 = now;
+			if (net_note_new || rx_frames != last_rx) {
+				net_note_new = 0;
+				last_rx = rx_frames;
+				snprintf(wl_status, sizeof(wl_status), "connected to %s: %s (%u in / %u out)", join_ssid,
+				    net_note[0] ? net_note : "getting an address...", rx_frames, tx_frames);
+				wl_publish("on", wl_status);
+			}
+		}
+		if (rd(shm, panic_off) | rd(shm, panic_off + 12)) {
+			snprintf(d, sizeof(d), "radio firmware crashed while Wi-Fi was starting (boot step %#x, record %08x %08x)",
+			    rd(mbox2, ISSR(0)), rd(shm, panic_off + 8), rd(shm, panic_off + 12));
+			wl_publish("off", d);
+			printf("SWEET A8 WIFI: %s\n", d);
+			return;
+		}
+		sleep_ms(20);
+	}
+}
+
+static void
+wlbt_thread(void *arg, wait_result_t wr_)
+{
+	uint32_t size = 0, runtime, entry, panic_off, magic;
+	char build[80];
+	int error;
+
+	(void)arg;
+	(void)wr_;
+	app_state("waiting", "radio core test starts 60 s after boot");
+	sleep_ms(60000);                /* the root file system is mounted and the boot is past its busiest */
+	app_state("starting", "loading the WLBT firmware");
+	shm = ml_io_map(SHM_PA, SHM_SIZE);
+	mbox = ml_io_map(MBOX_PA, 0x1000);
+	mbox2 = ml_io_map(MBOX2_PA, 0x1000);
+	pmu = ml_io_map(PMU_PA, 0x8000);
+	if (!shm || !mbox || !pmu || !mbox2) {
+		printf("SWEET A8 WLBT: cannot map the registers\n");
+		goto out;
+	}
+	printf("SWEET A8 WLBT: 1 look: mailbox2 IS_VERSION %#x ISSR0-3 %#x %#x %#x %#x\n", rd(mbox2, IS_VERSION),
+	    rd(mbox2, ISSR(0)), rd(mbox2, ISSR(1)), rd(mbox2, ISSR(2)), rd(mbox2, ISSR(3)));
+	printf("SWEET A8 WLBT: 1 look: mailbox IS_VERSION %#x, WIFI_CTRL_NS %#x CTRL_S %#x STAT %#x, MEM_CONFIG0 %#x CONFIG1 %#x, "
+	    "ext regulator option %#x status %#x\n", rd(mbox, IS_VERSION), rd(pmu, WIFI_CTRL_NS), rd(pmu, WIFI_CTRL_S),
+	    rd(pmu, WIFI_STAT), rd(pmu, MEM_CONFIG0), rd(pmu, MEM_CONFIG1), rd(pmu, EXT_REG_OPTION), rd(pmu, EXT_REG_STATUS));
+
+	for (uint32_t off = 0; off < SHM_SIZE; off += 4) {
+		wr(shm, off, 0);
+	}
+	if ((error = load_firmware(&size))) {
+		printf("SWEET A8 WLBT: 2 load: %s: error %d (put the phone's /vendor/etc/wifi/mx140.bin there)\n", FW_PATH, error);
+		app_state("off", "WLBT firmware file missing (mx140.bin)");
+		goto out;
+	}
+	magic = rd(shm, 8);
+	runtime = rd(shm, 36);
+	entry = rd(shm, 40);
+	panic_off = rd(shm, 176);
+	for (int i = 0; i < (int)sizeof(build) - 1; i += 4) {
+		uint32_t w = rd(shm, 48 + (uint32_t)i);
+		memcpy(build + i, &w, 4);
+	}
+	build[sizeof(build) - 1] = '\0';
+	printf("SWEET A8 WLBT: 2 load: %u bytes, magic %.4s, runtime length %#x, entry %#x, panic record at %#x, build %s\n",
+	    size, (const char *)&magic, runtime, entry, panic_off, build);
+	if (memcmp(&magic, "smxf", 4) != 0 || runtime >= SHM_SIZE || runtime < size || panic_off >= runtime) {
+		printf("SWEET A8 WLBT: 2 load: not a firmware this probe understands; stopping\n");
+		goto out;
+	}
+
+	uint64_t tz = smc4(0x82000710u, 0, SHM_PA, SHM_SIZE);
+	printf("SWEET A8 WLBT: 3 TrustZone window for the shared memory: SMC returns %#llx\n", tz);
+
+	wr(pmu, MEM_CONFIG1, (SHM_PA & 0xfffffc000u) >> 12);
+	wr(pmu, MEM_CONFIG0, SHM_SIZE >> 12);
+	{
+		/* Stage 3b: the second window (BAAW1, BT-ABOX shared memory) Samsung's platform_mif_reset sets up next to the
+		 * main one; ios61's panic record shows the core in abort mode 250 ms after start without it. */
+		/* Not mapped or cleared: a second 4 MB ml_io_map panicked in kmem_alloc (ios62); the firmware does not
+		 * need the window zeroed. */
+		printf("SWEET A8 WLBT: 3b BT-ABOX window was CONFIG2 %#x CONFIG3 %#x; now %#x at %#x\n", rd(pmu, MEM_CONFIG2),
+		    rd(pmu, MEM_CONFIG3), BTABOX_SIZE, BTABOX_PA);
+		wr(pmu, MEM_CONFIG3, (BTABOX_PA & 0xfffffc000u) >> 12);
+		wr(pmu, MEM_CONFIG2, BTABOX_SIZE >> 12);
+	}
+	wr(pmu, BOOT_RST_CFG, 0);
+	for (int i = 0; i < 64; i++) {
+		wr(mbox, ISSR(i), 0);
+	}
+	wr(mbox, INTMR0, 0xffff0000u);
+	wr(mbox, INTMR1, 0x0000ffffu);
+	wr(mbox, INTCR0, 0xffff0000u);
+	wr(mbox, INTCR1, 0x0000ffffu);
+	uint32_t conf_at = mxconf_build(runtime);
+	printf("SWEET A8 WLBT: 4 configuration at %#x (%u bytes), mgmt in buf %#x idx %#x/%#x, log buf %#x, heap end %#x\n",
+	    conf_at, conf_len, mgmt_in.buf, mgmt_in.ridx, mgmt_in.widx, log_in.buf, heap_next);
+	wr(mbox, ISSR(0), entry);
+	wr(mbox, ISSR(1), conf_at);
+	wr(mbox, ISSR(2), 0xbcdeedcbu);
+	wr(mbox, ISSR(3), 0);
+	printf("SWEET A8 WLBT: 4 set up: MEM_CONFIG0 %#x CONFIG1 %#x, mailboxes %#x %#x %#x %#x\n", rd(pmu, MEM_CONFIG0),
+	    rd(pmu, MEM_CONFIG1), rd(mbox, ISSR(0)), rd(mbox, ISSR(1)), rd(mbox, ISSR(2)), rd(mbox, ISSR(3)));
+	report("before start", runtime, panic_off);
+
+	/* Stage 3c (xnu 0139): runs 61-63 panicked ~250 ms after start (R4 record v2, checksum good, panic code 4).
+	 * Samsung sends ACPM SET_FLAG right before reset release so BUCK2 is at WLBT's voltage; do the same.
+	 * The result is repeated in every watch line: the one-off line scrolls out of the 16 KB ramoops window (run 77). */
+	uint32_t fr[4] = { 0 };
+	int fe = sweet_a8_acpm_wlbt_flag(fr);
+	printf("SWEET A8 WLBT: 4c ACPM SET_FLAG (BUCK2 for WLBT): error %d, reply %#x %#x %#x %#x\n", fe, fr[0], fr[1],
+	    fr[2], fr[3]);
+	wr(pmu, EXT_REG_OPTION, rd(pmu, EXT_REG_OPTION) | 0x4u);
+	wr(pmu, WIFI_CTRL_NS, rd(pmu, WIFI_CTRL_NS) | (1u << 1));
+	wr(pmu, WIFI_CTRL_NS, rd(pmu, WIFI_CTRL_NS) & ~(1u << 2));
+	wr(pmu, WIFI_CTRL_S, rd(pmu, WIFI_CTRL_S) | (1u << 3));
+	printf("SWEET A8 WLBT: 5 started (PWRON, reset released, START)\n");
+	{
+		char d[200];
+
+		snprintf(d, sizeof(d), "radio core started; power flag %s (err %d)", fe == 0 ? "accepted" : "refused", fe);
+		app_state("starting", d);
+	}
+	int started = 0;
+	for (int t = 1; t <= 20; t++) {
+		char when[80], d[200];
+
+		sleep_ms(t <= 4 ? 250 : 1000);
+		snprintf(when, sizeof(when), "watch %d (SET_FLAG err %d, reply %#x %#x %#x %#x)", t, fe, fr[0], fr[1],
+		    fr[2], fr[3]);
+		report(when, runtime, panic_off);
+		uint32_t p0 = rd(shm, panic_off), p1 = rd(shm, panic_off + 4), p2 = rd(shm, panic_off + 8),
+		    p3 = rd(shm, panic_off + 12), mw = rd(shm, mgmt_in.widx);
+		if (p0 | p1 | p2 | p3) {
+			snprintf(d, sizeof(d), "radio firmware crashed at boot step %#x (record %08x %08x %08x %08x; power flag err %d)",
+			    rd(mbox2, ISSR(0)), p0, p1, p2, p3, fe);
+			app_state("off", d);
+		} else if (mw) {
+			snprintf(d, sizeof(d), "radio firmware running, %u messages from the core; starting Wi-Fi", mw);
+			app_state("on", d);
+			started = 1;
+			break;
+		} else {
+			snprintf(d, sizeof(d), "radio core started, waiting for its first message (%d of 20)", t);
+			app_state("starting", d);
+		}
+	}
+	if (started) {
+		wifi_run(panic_off);
+		goto out;
+	}
+	final_dump(panic_off);
+	wr(pmu, EXT_REG_OPTION, rd(pmu, EXT_REG_OPTION) & ~0x4u);
+	printf("SWEET A8 WLBT: done; the core is left as it is until the next boot\n");
+out:
+	(void)thread_terminate(current_thread());
+}
+
+void
+sweet_a8_wlbt_init(void)
+{
+	int on = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("a8wlbt", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	if (kernel_thread_start(wlbt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("SWEET A8 WLBT: probe armed (a8wlbt=1): it runs 60 s from now\n");
+	}
+}
