+ * its map; it sees MAILBOX_WLBT 0x120c0000 at 0xa20c0000, so that is ISSR0 of the block at 0x120e0000. */
+#define MBOX2_PA        0x120e0000u
+static int wlbt_chan;
+static uint32_t heap_next;
+static uint8_t conf[200];
+static uint32_t conf_len;
