diff --git a/bsd/dev/sweet_a8acpm.c b/bsd/dev/sweet_a8acpm.c
index 2f4a199..00614b7 100644
--- a/bsd/dev/sweet_a8acpm.c
+++ b/bsd/dev/sweet_a8acpm.c
@@ -53,7 +53,10 @@ int sweet_a8_acpm_codec_write(uint8_t reg, uint8_t val);
 #define INTCR1          0x20u
 #define INTSR1          0x28u
 #define CH_MFD          2
-#define CH_DVFS         4       /* the "acpm" node's channel (cal-if); 5 is ACPM->AP notices, queue of 1 (run 59) */
+#define CH_CORE         4       /* the "acpm" node: owned by the ACPM framework (run 81: owner 1); loopback, plugin attach */
+#define CH_FVP          5       /* the "acpm_dvfs" node: owned by plugin 3 exynos7885_acpm_fvp (run 81: owner 8) */
+static int ch_dvfs = CH_CORE;  /* DVFS requests; the fvp plugin's first request channel once it is attached */
+static int fvp_ch[4], n_fvp_ch;
 #define FREQ_REQ        0
 #define FREQ_GET        1
 #define TYPE_CODEC      7
@@ -106,6 +109,143 @@ chan_setup(int i)
 	return 0;
 }
 
+static int acpm_send(int i, uint32_t *cmd);
+
+static uint8_t
+s_rd8(uint32_t off)
+{
+	return (uint8_t)(s_rd(off & ~3u) >> (8 * (off & 3u)));
+}
+
+/*
+ * xnu 0139, run 80: every DVFS request on channel 4 is consumed (send rear catches up) but never answered, and ACPM's
+ * own log shows fw_ipc returning 0xffffffff. Samsung's acpm.c plugins_init() attaches "dynamic plugins" (struct plugin,
+ * fw_header/common.h: id, base_addr, acpm_ops, plugin_ops, extern_func_mask, timer{period, multiplier}, u8 is_attached,
+ * size, u8 stay_attached, fw_name = 44 bytes) and reads the DVFS plugin's fvmap; booting from S-Boot nobody does.
+ * Dump the plugin table and the channel owners, and run Samsung's IPC loopback test (cmd0 = 1 << 23 | 3 << 26).
+ */
+static void
+acpm_dump_plugins(void)
+{
+	uint32_t np = s_rd(INITDATA + 4), pl = s_rd(INITDATA), nc = s_rd(INITDATA + 12), cb = s_rd(INITDATA + 8);
+	uint32_t cmd[16] = { (1u << 23) | (3u << 26), 0, 0, 0 };
+	int e;
+
+	printf("SWEET ACPM: plugin table at %#x, %u plugins\n", pl, np);
+	for (uint32_t i = 0; i < np && i < 16 && pl && pl + 44 * (i + 1) <= SRAM_SIZE; i++) {
+		uint32_t p = pl + 44 * i, fn = s_rd(p + 40);
+		char name[33];
+		unsigned n = 0;
+
+		if (fn && fn < SRAM_SIZE - 32) {
+			for (; n < 32; n++) {
+				uint8_t c = s_rd8(fn + n);
+				if (c == 0) {
+					break;
+				}
+				name[n] = (c >= 32 && c < 127) ? (char)c : '?';
+			}
+		}
+		name[n] = 0;
+		printf("SWEET ACPM: plugin %u: id %u base %#x ops %#x/%#x mask %#x timer %u/%u attached %u size %#x stay %u name '%s'\n",
+		    i, s_rd(p), s_rd(p + 4), s_rd(p + 8), s_rd(p + 12), s_rd(p + 16), s_rd(p + 20), s_rd(p + 24),
+		    s_rd8(p + 28), s_rd(p + 32), s_rd8(p + 36), name);
+	}
+	for (uint32_t i = 0; i < nc && i < 16 && cb && cb + 72 * (i + 1) <= SRAM_SIZE; i++) {
+		uint32_t c = cb + 72 * i;
+		printf("SWEET ACPM: channel entry %u: id %u field %#x owner %d type %u ap_poll %u\n", i, s_rd(c), s_rd(c + 4),
+		    (int)s_rd(c + 8), s_rd(c + 12), s_rd(c + 68));
+	}
+	e = acpm_send(CH_CORE, cmd);
+	printf("SWEET ACPM: loopback test on channel %d: error %d, reply %#x %#x %#x %#x\n", CH_CORE, e, cmd[0], cmd[1],
+	    cmd[2], cmd[3]);
+}
+
+extern int IODTGetLoaderInfo(const char *key, void **infoAddr, int *infoSize);
+
+/*
+ * Run 81: plugin 3 'exynos7885_acpm_fvp.fw' (stay 1, attached 0, base 0x7801, size 0x3000) owns the DVFS channels
+ * (0, 1, 5, 6, 8: owner 8), so every DVFS request on the framework's channel 4 was refused (fw_ipc -1) and the WLBT
+ * firmware never got SET_FLAG. Samsung's acpm.c plugins_init(): copy the plugin's firmware to SRAM + (base & ~1), then
+ * attach it on the "acpm" channel with cmd0 = 1 << 25 (DP_A) | id << 26. The firmware is built into Samsung's kernel
+ * (CONFIG_EXTRA_FIRMWARE, 12288 bytes); our boot image carries it as the blob "SweetACPMFVP" (mkpayload --blob, never
+ * in git). DVFS requests then go to channel 5 (the "acpm_dvfs" node), if its queue looks sane after the attach.
+ */
+static void
+acpm_attach_plugins(void)
+{
+	uint32_t np = s_rd(INITDATA + 4), pl = s_rd(INITDATA);
+	void *bpa = NULL;
+	int bsz = 0;
+	const uint8_t *blob = NULL;
+
+	if (IODTGetLoaderInfo("SweetACPMFVP", &bpa, &bsz) == 0 && bsz > 0) {
+		blob = (const uint8_t *)ml_static_ptovirt((vm_offset_t)bpa);
+	}
+	for (uint32_t i = 0; i < np && i < 16 && pl && pl + 44 * (i + 1) <= SRAM_SIZE; i++) {
+		uint32_t p = pl + 44 * i, id = s_rd(p), base = s_rd(p + 4) & ~1u, size = s_rd(p + 32), fn = s_rd(p + 40);
+		uint32_t cmd[16] = { 0 };
+		char name[33];
+		unsigned n = 0;
+		int e;
+
+		if (!(s_rd8(p + 28) == 0 && s_rd8(p + 36) == 1)) {
+			continue;
+		}
+		if (fn && fn < SRAM_SIZE - 32) {
+			for (; n < 32; n++) {
+				uint8_t c = s_rd8(fn + n);
+				if (c == 0) {
+					break;
+				}
+				name[n] = (c >= 32 && c < 127) ? (char)c : '?';
+			}
+		}
+		name[n] = 0;
+		int fvp = 0;
+		for (unsigned k = 0; k + 3 <= n; k++) {     /* no strstr in the kernel (build #113) */
+			if (name[k] == 'f' && name[k + 1] == 'v' && name[k + 2] == 'p') {
+				fvp = 1;
+			}
+		}
+		if (!fvp) {
+			printf("SWEET ACPM: plugin %u '%s' wants loading; no firmware for it here\n", i, name);
+			continue;
+		}
+		if (blob == NULL) {
+			printf("SWEET ACPM: plugin %u '%s' wants loading; no SweetACPMFVP blob in this boot image\n", i, name);
+			continue;
+		}
+		if (base == 0 || (bsz & 3) != 0 || (uint32_t)bsz > size || base + (uint32_t)bsz > SRAM_SIZE) {
+			printf("SWEET ACPM: plugin %u '%s': blob %d bytes does not fit (base %#x size %#x)\n", i, name, bsz, base, size);
+			continue;
+		}
+		for (uint32_t o = 0; o < (uint32_t)bsz; o += 4) {
+			uint32_t w;
+			memcpy(&w, blob + o, 4);
+			s_wr(base + o, w);
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		cmd[0] = (1u << 25) | (id << 26);
+		e = acpm_send(CH_CORE, cmd);
+		printf("SWEET ACPM: plugin %u '%s': %d bytes loaded at %#x, attach (id %u): error %d, reply %#x %#x; attached now %u\n",
+		    i, name, bsz, base, id, e, cmd[0], cmd[1], s_rd8(p + 28));
+	}
+	/* ios82 (run 66): the fvp plugin attached, but channel 5 is type 2 with a 1-entry queue, so front + 1 == rear always
+	 * ("queue full"). Use the plugin's own type-1 (AP request, polled) channels instead: owner == 1 << plugin id. */
+	uint32_t chans = s_rd(INITDATA + 8), apmax = s_rd(INITDATA + 24);
+	for (uint32_t i = 0; i < apmax && i < 8 && n_fvp_ch < 4 && chans && chans + 72 * (i + 1) <= SRAM_SIZE; i++) {
+		uint32_t c = chans + 72 * i;
+		if (s_rd(c + 8) == (1u << 3) && s_rd(c + 12) == 1 && chan_setup((int)i) == 0 && ch[i].len > 1) {
+			fvp_ch[n_fvp_ch++] = (int)i;
+		}
+	}
+	if (n_fvp_ch) {
+		ch_dvfs = fvp_ch[0];
+	}
+	printf("SWEET ACPM: DVFS requests go to channel %d (%d fvp request channels)\n", ch_dvfs, n_fvp_ch);
+}
+
 static int
 acpm_init(void)
 {
@@ -121,10 +261,13 @@ acpm_init(void)
 	}
 	printf("SWEET ACPM: framework: plugins %u, channels %u, ap channels %u, INTSR1 %#x\n",
 	    s_rd(INITDATA + 4), s_rd(INITDATA + 12), s_rd(INITDATA + 24), *(volatile uint32_t *)(mbox + INTSR1));
-	if (chan_setup(CH_MFD) || chan_setup(CH_DVFS)) {
+	if (chan_setup(CH_MFD) || chan_setup(CH_CORE)) {
 		return ENXIO;
 	}
 	acpm_ready = 1;
+	acpm_dump_plugins();
+	acpm_attach_plugins();
+	acpm_dump_plugins();
 	return 0;
 }
 
@@ -195,7 +338,7 @@ static int
 dvfs(uint32_t domain, uint32_t khz, uint32_t func, uint32_t *out)
 {
 	uint32_t cmd[16] = { domain, khz, func, 0 };
-	int e = acpm_send(CH_DVFS, cmd);
+	int e = acpm_send(ch_dvfs, cmd);
 	if (out != NULL) {
 		*out = cmd[1];
 	}
@@ -360,4 +503,36 @@ sweet_a8_acpm_mfd(unsigned type, uint8_t reg, int write, uint8_t *val)
 	}
 	return (cmd[1] >> 24) & 0xff ? EIO : 0;
 }
+/*
+ * xnu 0139: Samsung's platform_mif_reset calls exynos_acpm_set_flag() immediately before WLBT reset release, "to ensure
+ * BUCK2 gets the right voltage" (cal-if/acpm_dvfs.c: DVFS channel, cmd { 7, 1, SET_FLAG = 6, 0 }, reply wanted).
+ */
+int sweet_a8_acpm_wlbt_flag(uint32_t *reply);
+int
+sweet_a8_acpm_wlbt_flag(uint32_t *reply)
+{
+	uint32_t cmd[16] = { 7, 1, 6, 0 };
+	int e;
+
+	if (acpm_init()) {
+		return ENXIO;
+	}
+	e = acpm_send(ch_dvfs, cmd);
+	for (int k = 0; e != 0 && k < n_fvp_ch; k++) {       /* which fvp channel cal-if uses is not known yet: try each */
+		if (fvp_ch[k] == ch_dvfs) {
+			continue;
+		}
+		uint32_t c2[16] = { 7, 1, 6, 0 };
+		e = acpm_send(fvp_ch[k], c2);
+		printf("SWEET ACPM: SET_FLAG on channel %d: error %d, reply %#x %#x %#x %#x\n", fvp_ch[k], e, c2[0], c2[1],
+		    c2[2], c2[3]);
+		if (e == 0) {
+			memcpy(cmd, c2, sizeof(c2));
+		}
+	}
+	for (int i = 0; i < 4; i++) {
+		reply[i] = cmd[i];
+	}
+	return e;
+}
 #endif /* SWEET_JACKPOTLTE */
diff --git a/bsd/dev/sweet_a8wlbt.c b/bsd/dev/sweet_a8wlbt.c
index f638996..ad4388d 100644
--- a/bsd/dev/sweet_a8wlbt.c
+++ b/bsd/dev/sweet_a8wlbt.c
@@ -1,411 +1,1671 @@
-/* Copyright (c) 2026 Darin. MIT License (see LICENSE); keep this notice. Written by Claude (Anthropic) for the ios-sweet Galaxy A8 port. */
-/*
- * Galaxy A8 (2018, jackpotlte) Wi-Fi / Bluetooth, stage 2: wake Samsung's WLBT ("Maxwell") core and see whether its
- * firmware runs. Boot-arg a8wlbt=1; nothing happens without it.
- *
- * Facts (stock BOOT.img device tree; Samsung's SM-A530F kernel, GPL-2.0, read for facts only:
- * drivers/misc/samsung/scsc/platform_mif.c, mif_reg_S5E7885.h, mxman.c, fwhdr.c, mx140_file.c):
- *   shared memory 0xE9000000, 4 MB (reserved-memory wifibt_if): the firmware runs from it, R4-relative address 0
- *   mailbox 0x120C0000 (MAILBOX_WLBT): ISSR(n) = 0x80 + 4n are the mailboxes; INTMR0/1, INTCR0/1 masks and clears
- *   PMU 0x11C80000: WIFI_CTRL_NS 0x140 (PWRON bit 1, RESET_SET bit 2), WIFI_CTRL_S 0x144 (START bit 3),
- *        WIFI_STAT 0x148, WIFI2AP_MEM_CONFIG0 0x7300 (size >> 12) / CONFIG1 0x7304 (base >> 12),
- *        WLBT_BOOT_TEST_RST_CFG 0x7330 (0: boot from DRAM), EXT_REGULATOR_SHARED_OPTION 0x3648 bit 2
- *   SMC 0x82000710 (WLBT_TZASC = 0, base, size): lets the core reach the shared memory through TrustZone
- *   start: firmware image copied to offset 0; mailbox 0 = entry point (header +40), 1 = the configuration's
- *        address (0 here: there is none yet), 2 = 0xbcdeedcb, 3 = start flags (0); then PWRON, RESET_SET off, START.
- *   firmware: /sweet/fw/mx140.bin (from the phone's /vendor/etc/wifi; not in git). Header "smxf" at +8, runtime
- *        length +36, entry +40, build id +48, R4 panic record offset +176.
- *
- * Stage 2 result (ios60n): the core ran and wrote its panic record (version 2, 0xd4 bytes) with mailbox 1 = 0.
- *
- * Stage 3 (this file): mailbox 1 now points at a configuration block in the heap right after the firmware's runtime
- * length, laid out as Samsung's mxconf (facts from mxconf.h, mifstream.c, cpacket_buffer.c, mifintrbit.c, mxman.c,
- * mxmgmt_transport.c, gdb_transport.c, mxlog_transport.c; packed little-endian):
- *   u32 magic 0x79828486; u16 major 0, minor 1; then four stream pairs/streams. A stream = buffer offset, packet
- *   count, packet size, read-index offset, write-index offset (u32 each, offsets relative to the shared memory),
- *   u8 read interrupt bit, u8 write interrupt bit. Pairs are (to AP, from AP).
- *   management (8-byte packets, 64), gdb R4 and gdb M4 (4-byte packets, 512 each), mxlog (to AP only, 4-byte, 4096).
- *   Interrupt bits in the order Linux allocates them (to-host bits count up from 0; from-host R4/M4 from 1, bit 0
- *   reserved for the gdb out streams): mgmt in r1 w0, mgmt out r1 w2, gdb R4 in r3 w2, out r3 w0, gdb M4 in r1 w4,
- *   out r5 w0, mxlog in r4 w6. To-AP buffers start filled with 0xff.
- * The probe polls (no interrupt handler): it reports the to-AP write indices and, at the end, the management packets
- * (MM_START_IND = channel 0 payload 0 is what Linux waits for), the first mxlog words and the whole panic record.
- * Logged as "SWEET A8 WLBT:". The core is left as it ends; a reboot resets it.
- */
-#if defined(SWEET_JACKPOTLTE)
-#include <sys/param.h>
-#include <sys/systm.h>
-#include <sys/errno.h>
-#include <sys/vnode.h>
-#include <sys/fcntl.h>
-#include <sys/uio.h>
-#include <kern/clock.h>
-#include <kern/kalloc.h>
-#include <kern/thread.h>
-#include <kern/sched_prim.h>
