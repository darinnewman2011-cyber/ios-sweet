+/*
+ * Write statistics, printed every 10 s by wst_thread() so the first failure
+ * stays inside the last 16 KB that ramoops keeps. where: 1 outside USERDATA,
+ * 2 CMD24, 3 data error, 4 data timeout, 5 busy, 6 card status, 7 not back in
+ * TRAN, 8 no extent, 9 beyond the file, 10 strategy bounds. a/b: rintsts, r1.
+ */
+static struct {
+	uint64_t ok, fail, lba;
+	uint32_t where, a, b;
+	int err;
+} wst;
+
+static int
+wst_fail(int err, uint32_t where, uint64_t lba, uint32_t a, uint32_t b)
+{
+	if (!wst.fail++) {
+		wst.err = err;
+		wst.where = where;
+		wst.lba = lba;
+		wst.a = a;
+		wst.b = b;
+	}
+	return err;
+}
