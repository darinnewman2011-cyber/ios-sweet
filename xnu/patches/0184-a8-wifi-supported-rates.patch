+/*
+ * xnu 0184: unifiSupportedDataRates (PSID 0x07F9) has no default in this firmware's MIB (mib_out.xml) and the
+ * hcf does not set it; the pre-join probe advertised only OFDM rates and every 2.4 GHz join died in mlme_conmgr
+ * Synchronising -> Detached (APs there require the CCK basic rates). Octet string N, rates in 500 kb/s units.
+ */
+static void
+wl_set_rates(void)
+{
+	static const uint8_t m[20] = { 0xf9, 0x07, 15, 0, 0xa1, 13, 12, 0x02, 0x04, 0x0b, 0x0c, 0x12, 0x16, 0x18,
+		                       0x24, 0x30, 0x48, 0x60, 0x6c, 0 };
+	uint8_t s[64];
+	int e;
+
+	sig_hdr(s, 0x2002, 0);
+	e = sig_send(s, 24, m, sizeof(m));
+	printf("SWEET A8 WIFI: supported rates (1-54 Mb/s) set: error %d\n", e);
+}
