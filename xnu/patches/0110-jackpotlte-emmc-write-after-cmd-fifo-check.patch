diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 966a6cb..6d7b0c3 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -341,7 +341,9 @@ ufs_sync_cache(void)
 #define MMC_STATUS      0x048
 #define STATUS_BUSY             (1u << 9)       /* DAT0 low: card busy */
 #define STATUS_FIFO_FULL        (1u << 3)
+#define STATUS_FIFO_EMPTY       (1u << 2)
 #define STATUS_FCNT(s)          (((s) >> 17) & 0x1fff)
+#define STATUS_FCNT_MASK        (0x1fffu << 17)
 #define MMC_HCON        0x070
 #define MMC_UHS_REG     0x074
 #define MMC_BMOD        0x080
@@ -367,11 +369,13 @@ static uint64_t mmc_wr_lo, mmc_wr_hi;           /* writable sectors [lo, hi): US
  * stays inside the last 16 KB that ramoops keeps. where: 1 outside USERDATA,
  * 2 CMD24, 3 data error, 4 data timeout, 5 busy, 6 card status, 7 not back in
  * TRAN, 8 no extent, 9 beyond the file, 10 strategy bounds, 11 verify kept
- * failing. a/b: rintsts, r1.
+ * failing, 12 FIFO not empty after reset (a/b: status, ctrl). a/b: rintsts, r1.
  */
 static struct {
 	uint64_t ok, fail, lba;
 	uint64_t wbad, rbad, zero, bad_lba;     /* write verification, see file_write_verified() */
+	uint64_t bad_want, bad_got;             /* first 8 bytes sent / read back at bad_lba */
+	uint64_t dirty;                         /* FIFO not empty after reset (write refused) */
 	uint32_t where, a, b;
 	int err;
 } wst;
@@ -534,16 +538,21 @@ mmc_write_sector(uint64_t lba, const uint32_t *src)
 		printf("SWEET MMC: refusing write at 0x%llx (writable 0x%llx-0x%llx)\n", lba, mmc_wr_lo, mmc_wr_hi);
 		return wst_fail(EPERM, 1, lba, 0, 0);
 	}
+	/*
+	 * The FIFO must be empty before CMD24: whatever it holds goes out first.
+	 * ios16 (0109) found written sectors holding 0xff, their old contents
+	 * and code bytes from some read, with no error from card or controller.
+	 * So the reset is checked, and (as in Linux dw_mmc) the sector goes into
+	 * the FIFO only after the command, not before it as in 0106.
+	 */
 	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) | CTRL_FIFO_RESET);
 	(void)mmc_wait(MMC_CTRL, CTRL_FIFO_RESET, 0, 10 * NSEC_PER_MSEC);
+	if (!mmc_wait(MMC_STATUS, STATUS_FCNT_MASK | STATUS_FIFO_EMPTY, STATUS_FIFO_EMPTY, 10 * NSEC_PER_MSEC)) {
+		wst.dirty++;
+		return wst_fail(EIO, 12, lba, ufs_rd(MMC_STATUS), ufs_rd(MMC_CTRL));
+	}
 	ufs_wr(MMC_BLKSIZ, 512);
 	ufs_wr(MMC_BYTCNT, 512);
-	/*
-	 * Fill the FIFO before CMD24 (64 x 64-bit entries hold the whole sector):
-	 * with it empty after the command the controller reports HTO (data
-	 * starvation by host), which ios10/ios12 most likely failed on.
-	 */
-	mmc_fifo_fill(src, &n);
 	st = mmc_cmd(24, (uint32_t)lba,
 	    CMD_RESP_EXP | CMD_RESP_CRC | CMD_DAT_EXP | CMD_READ_WRITE | CMD_PRV_DAT_WAIT, &resp);
 	if (st == UINT32_MAX || (st & MMC_WR_ERROR) || (resp & R1_ERRORS)) {
@@ -878,6 +887,10 @@ file_write_verified(uint64_t dev, const uint32_t *src)
 		}
 		if (!wst.bad_lba) {
 			wst.bad_lba = dev;
+			wst.bad_want = ((uint64_t)src[1] << 32) | src[0];
+			wst.bad_got = ((uint64_t)wverify[1] << 32) | wverify[0];
+			printf("SWEET MMC: first verify mismatch at 0x%llx: sent %016llx got %016llx (%s)\n",
+			    dev, wst.bad_want, wst.bad_got, sector_zero(wverify) ? "zeros" : "data");
 		}
 		error = mmc_read_sector(dev, wverify);
 		if (error) {
@@ -935,9 +948,10 @@ wst_thread(__unused void *arg, __unused wait_result_t wr)
 		(void)assert_wait_deadline(&wst_chan, THREAD_UNINT, deadline);
 		thread_block(THREAD_CONTINUE_NULL);
 		printf("SWEET ROOT: %llu sectors written, %llu failed; first failure err %d where %u at 0x%llx (%#x %#x); "
-		    "verify: %llu rewrites, %llu read glitches, %llu zero readbacks, first at 0x%llx\n",
+		    "verify: %llu rewrites, %llu read glitches, %llu zero readbacks, first at 0x%llx "
+		    "(sent %016llx got %016llx); %llu dirty FIFO\n",
 		    wst.ok, wst.fail, wst.err, wst.where, wst.lba, wst.a, wst.b,
-		    wst.wbad, wst.rbad, wst.zero, wst.bad_lba);
+		    wst.wbad, wst.rbad, wst.zero, wst.bad_lba, wst.bad_want, wst.bad_got, wst.dirty);
 	}
 }
 
