diff --git a/bsd/dev/sweet_a8wlbt.c b/bsd/dev/sweet_a8wlbt.c
index 76d1beb..fa017a8 100644
--- a/bsd/dev/sweet_a8wlbt.c
+++ b/bsd/dev/sweet_a8wlbt.c
@@ -675,6 +675,22 @@ short_sig(uint16_t id)
 	return sig_send(s, 24, NULL, 0);
 }
 
+/*
+ * xnu 0181: MLME_SET_REQ (0x2002, vif 0) with one MIB entry, as slsi_mlme_set does. Android sets the country
+ * (unifiDefaultCountry, PSID 0x1F4D) right after Wi-Fi starts; the firmware otherwise stays on its world
+ * domain. The confirm (0x2102) carries the rejected entries, if any (printed as a plain signal).
+ */
+static void
+wl_set_country(const char *cc)
+{
+	uint8_t s[64], m[10] = { 0x4d, 0x1f, 5, 0, 0xa1, 3, (uint8_t)cc[0], (uint8_t)cc[1], 0, 0 };
+	int e;
+
+	sig_hdr(s, 0x2002, 0);
+	e = sig_send(s, 24, m, sizeof(m));
+	printf("SWEET A8 WIFI: country %c%c set: error %d\n", cc[0], cc[1], e);
+}
+
 static void
 del_vif(void)
 {
@@ -2886,6 +2902,19 @@ wifi_run(uint32_t panic_off)
 			printf("SWEET A8 WIFI: a8join: will join %s after the scan\n", join_ssid);
 		}
 	}
+	{
+		/* xnu 0181: boot-arg a8country=XX (default US, a8country=0 skips); a8bton=1 starts the BT service too */
+		char cc[4] = "US";
+		uint32_t bton = 0;
+		PE_parse_boot_argn("a8country", cc, sizeof(cc));
+		if (cc[0] != '0' && cc[0] && cc[1]) {
+			wl_set_country(cc);
+		}
+		if (PE_parse_boot_argn("a8bton", &bton, sizeof(bton)) && bton == 1) {
+			bt_want = 1;
+			printf("SWEET A8 WIFI: a8bton=1: starting the BT service as well\n");
+		}
+	}
 	scan_req = 1;
 	nanoseconds_to_absolutetime(15ull * NSEC_PER_SEC, &lim15);
 	nanoseconds_to_absolutetime(2ull * NSEC_PER_SEC, &lim2);
