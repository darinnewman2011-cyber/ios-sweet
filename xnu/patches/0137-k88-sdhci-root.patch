+#else /* SWEET_K88 */
+/*
+ * ZTE K88 (MSM8952): eMMC on the Qualcomm SDHCI (SD Host Controller spec
+ * 3.0, HOST_VERSION 0x4702) at 0x07824900. LK leaves the card selected and
+ * in TRAN, HS200 8-bit, clock on (shim/k88 diag: HOST_CTRL 0x30, CLK 0x0007,
+ * CTRL2 0x0003). Like the A8 driver this reuses that state and moves data by
+ * PIO through the buffer data port, polling the interrupt status registers:
+ * no ADMA descriptors, no interrupt. The RCA is LK's; it is found with CMD13
+ * at init. The same function names as the DW-MSHC code above, so the file
+ * root and verification code below run unchanged.
+ */
+#define HC_BLKSIZE      0x04                    /* 16-bit block size, 16-bit block count */
+#define HC_ARG          0x08
+#define HC_XFER         0x0c                    /* 16-bit transfer mode, 16-bit command */
+#define XFER_BLKCNT_EN          (1u << 1)
+#define XFER_AUTO_CMD12         (1u << 2)
+#define XFER_READ               (1u << 4)
+#define XFER_MULTI              (1u << 5)
+#define CMDR_RESP_48            (2u << 0)
+#define CMDR_RESP_48B           (3u << 0)
+#define CMDR_CRC                (1u << 3)
+#define CMDR_INDEX              (1u << 4)
+#define CMDR_DATA               (1u << 5)
+#define CMDR_ABORT              (3u << 6)
+#define HC_RESP0        0x10
+#define HC_RESP3        0x1c                    /* auto CMD12 response */
+#define HC_DATA         0x20
+#define HC_PRESENT      0x24
+#define PRES_CMD_INHIBIT        (1u << 0)
+#define PRES_DAT_INHIBIT        (1u << 1)
+#define PRES_DAT0               (1u << 20)
+#define HC_RESET        0x2f                    /* byte */
+#define RESET_CMD               (1u << 1)
+#define RESET_DAT               (1u << 2)
+#define HC_INT          0x30                    /* normal [15:0], error [31:16], write 1 to clear */
+#define INT_CMD_COMPLETE        (1u << 0)
+#define INT_XFER_COMPLETE       (1u << 1)
+#define INT_BUF_WRITE           (1u << 4)
+#define INT_BUF_READ            (1u << 5)
+#define INT_ERR                 (1u << 15)
+#define INT_ERR_MASK            0xffff8000u
+#define HC_INT_EN       0x34                    /* status enable, same layout */
+#define HC_SIG_EN       0x38                    /* signal enable: 0 = polled */
+#define HC_VERSION      0xfc
+
+#define MMC_CMD_NS      (100ull * NSEC_PER_MSEC)
+#define MMC_DATA_NS     (500ull * NSEC_PER_MSEC)
+#define R1_ERRORS       0xfdf80000u
+#define R1_STATE(r)     (((r) >> 9) & 0xf)
+#define R1_READY        (1u << 8)
+#define MMC_MULTI_MAX   128u                    /* 64 KiB per command */
+
+static int mmc_wait_tran(uint64_t lba);
+
+static uint32_t mmc_rca;
+
+static void
+hc_reset(uint8_t what)
+{
+	*(volatile uint8_t *)(su.regs + HC_RESET) = what;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	(void)mmc_wait(HC_RESET & ~3u, (uint32_t)what << 24, 0, 10 * NSEC_PER_MSEC);
+}
+
+/*
+ * Issue a command: returns the interrupt status (INT_ERR set on any error,
+ * UINT32_MAX if the controller stayed busy), *resp = RESP0.
+ */
+static uint32_t
+mmc_cmd(uint32_t idx, uint32_t arg, uint32_t cmdr, uint32_t xfer, uint32_t *resp)
+{
+	uint32_t inhibit = PRES_CMD_INHIBIT | ((cmdr & CMDR_DATA) || (cmdr & 3) == CMDR_RESP_48B ? PRES_DAT_INHIBIT : 0);
+
+	if ((cmdr & CMDR_ABORT) == CMDR_ABORT) {
+		inhibit = PRES_CMD_INHIBIT;
+	}
+	if (!mmc_wait(HC_PRESENT, inhibit, 0, MMC_DATA_NS)) {
+		return UINT32_MAX;
+	}
+	ufs_wr(HC_INT, 0xffffffff);
+	ufs_wr(HC_ARG, arg);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ufs_wr(HC_XFER, ((idx << 8 | cmdr) << 16) | xfer);    /* the command half starts it */
+	if (!mmc_wait(HC_INT, INT_CMD_COMPLETE | INT_ERR, INT_CMD_COMPLETE, MMC_CMD_NS) &&
+	    !(ufs_rd(HC_INT) & INT_ERR)) {
+		*resp = 0;
+		return UINT32_MAX;
+	}
+	*resp = ufs_rd(HC_RESP0);
+	uint32_t st = ufs_rd(HC_INT);
+	ufs_wr(HC_INT, INT_CMD_COMPLETE);
+	return st;
+}
+
+/* After an error: clear the status, reset the CMD and DAT lines. */
+static void
+mmc_abort(void)
+{
+	uint32_t resp = 0;
+
+	ufs_wr(HC_INT, 0xffffffff);
+	hc_reset(RESET_CMD | RESET_DAT);
+	(void)mmc_cmd(12, 0, CMDR_RESP_48B | CMDR_CRC | CMDR_INDEX | CMDR_ABORT, 0, &resp);
+	(void)mmc_wait(HC_PRESENT, PRES_DAT0, PRES_DAT0, MMC_DATA_NS);
+	hc_reset(RESET_CMD | RESET_DAT);
+	ufs_wr(HC_INT, 0xffffffff);
+}
+
+/* Wait for one of the bits in want, or an error; returns the status. */
+static uint32_t
+hc_wait_int(uint32_t want, uint64_t ns)
+{
+	uint64_t deadline;
+
+	nanoseconds_to_absolutetime(ns, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		uint32_t st = ufs_rd(HC_INT);
+		if (st & (want | INT_ERR)) {
+			return st;
+		}
+		if (mach_absolute_time() > deadline) {
+			return 0;
+		}
+	}
+}
+
+/* n sectors (1..MMC_MULTI_MAX) at lba: CMD17/18 or CMD24/25, auto CMD12 for n > 1. */
+static int
+mmc_xfer(uint64_t lba, uint32_t n, uint32_t *buf, bool write)
+{
+	uint32_t st, resp = 0, idx, xfer;
+
+	if (n == 0 || n > MMC_MULTI_MAX || lba + n - 1 > UINT32_MAX) {
+		return EINVAL;
+	}
+	if (write && (lba < mmc_wr_lo || lba + n > mmc_wr_hi)) {
+		printf("SWEET MMC: refusing write of %u at 0x%llx (writable 0x%llx-0x%llx)\n", n, lba, mmc_wr_lo, mmc_wr_hi);
+		return wst_fail(EPERM, 1, lba, n, 0);
+	}
+	ufs_wr(HC_BLKSIZE, (n << 16) | 512);
+	xfer = write ? 0 : XFER_READ;
+	if (n > 1) {
+		xfer |= XFER_MULTI | XFER_BLKCNT_EN | XFER_AUTO_CMD12;
+		idx = write ? 25 : 18;
+	} else {
+		idx = write ? 24 : 17;
+	}
+	st = mmc_cmd(idx, (uint32_t)lba, CMDR_RESP_48 | CMDR_CRC | CMDR_INDEX | CMDR_DATA, xfer, &resp);
+	if (st == UINT32_MAX || (st & INT_ERR) || (resp & R1_ERRORS)) {
+		goto fail;
+	}
+	for (uint32_t b = 0; b < n; b++) {
+		uint32_t *p = buf + b * (UFS_BLOCK / 4);
+
+		st = hc_wait_int(write ? INT_BUF_WRITE : INT_BUF_READ, MMC_DATA_NS);
+		if (!(st & (write ? INT_BUF_WRITE : INT_BUF_READ)) || (st & INT_ERR)) {
+			goto fail;
+		}
+		ufs_wr(HC_INT, write ? INT_BUF_WRITE : INT_BUF_READ);
+		if (write) {
+			for (uint32_t i = 0; i < UFS_BLOCK / 4; i++) {
+				ufs_wr(HC_DATA, p[i]);
+			}
+		} else {
+			for (uint32_t i = 0; i < UFS_BLOCK / 4; i++) {
+				p[i] = ufs_rd(HC_DATA);
+			}
+		}
+	}
+	/* Transfer complete comes after the card's programming busy (writes) and auto CMD12. */
+	st = hc_wait_int(INT_XFER_COMPLETE, 4 * MMC_DATA_NS);
+	if (!(st & INT_XFER_COMPLETE) || (st & INT_ERR)) {
+		goto fail;
+	}
+	ufs_wr(HC_INT, INT_XFER_COMPLETE);
+	if (n > 1 && (ufs_rd(HC_RESP3) & R1_ERRORS)) {
+		resp = ufs_rd(HC_RESP3);
+		goto fail;
+	}
+	return write ? mmc_wait_tran(lba) : 0;
+fail:
+	if (!wst.mfail++) {
+		printf("SWEET MMC: CMD%u of %u at 0x%llx failed: int 0x%x r1 0x%x present 0x%x\n",
+		    idx, n, lba, st, resp, ufs_rd(HC_PRESENT));
+	}
+	mmc_abort();
+	return write ? wst_fail(EIO, 3, lba, st, resp) : EIO;
+}
+
+/* After a write or an R1b command: DAT0 released, then CMD13 until TRAN and ready. */
+static int
+mmc_wait_tran(uint64_t lba)
+{
+	uint32_t st, resp = 0;
+
+	if (!mmc_wait(HC_PRESENT, PRES_DAT0, PRES_DAT0, MMC_DATA_NS)) {
+		printf("SWEET MMC: 0x%llx: card still busy\n", lba);
+		return wst_fail(ETIMEDOUT, 5, lba, 0, 0);
+	}
+	for (int i = 0; i < 1000; i++) {
+		st = mmc_cmd(13, mmc_rca << 16, CMDR_RESP_48 | CMDR_CRC | CMDR_INDEX, 0, &resp);
+		if (st != UINT32_MAX && !(st & INT_ERR)) {
+			if (resp & R1_ERRORS) {
+				printf("SWEET MMC: 0x%llx: card status 0x%x\n", lba, resp);
+				return wst_fail(EIO, 6, lba, st, resp);
+			}
+			if (R1_STATE(resp) == 4 && (resp & R1_READY)) {
+				return 0;
+			}
+		} else {
+			mmc_abort();
+		}
+		delay(10);
+	}
+	printf("SWEET MMC: 0x%llx: card not back in TRAN, r1 0x%x\n", lba, resp);
+	return wst_fail(ETIMEDOUT, 7, lba, 0, resp);
+}
+
+static int
+mmc_read_sector(uint64_t lba, uint32_t *dst)
+{
+	int error = mmc_xfer(lba, 1, dst, false);
+	if (error) {
+		printf("SWEET MMC: read 0x%llx failed\n", lba);
+	}
+	return error;
+}
+
+static int
+mmc_write_sector(uint64_t lba, const uint32_t *src)
+{
+	return mmc_xfer(lba, 1, (uint32_t *)(uintptr_t)src, true);
+}
+
+static int
+mmc_xfer_multi(uint64_t lba, uint32_t n, uint32_t *buf, bool write)
+{
+	if (n < 2) {
+		return EINVAL;
+	}
+	return mmc_xfer(lba, n, buf, write);
+}
+
+/* count sectors at lba into the bounce buffer, up to 64 KiB per command. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	uint32_t *b = (uint32_t *)(su.dma + DMA_BOUNCE);
+
+	if (count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	for (uint32_t i = 0; i < count;) {
+		uint32_t m = MIN(count - i, MMC_MULTI_MAX);
+		int error = mmc_xfer(lba + i, m, b + i * (UFS_BLOCK / 4), false);
+		if (error) {
+			return error;
+		}
+		i += m;
+	}
+	return 0;
+}
+
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	printf("SWEET MMC: refusing raw write of %u blocks at 0x%llx\n", count, lba);
+	return EROFS;
+}
+
+/* CMD6 SWITCH EXT_CSD[32] FLUSH_CACHE = 1 (R1b); harmless if the cache is off. */
+static int
+ufs_sync_cache(void)
+{
+	static bool logged;
+	uint32_t resp = 0, st;
+
+	if (!mmc_wr_hi) {
+		return 0;
+	}
+	st = mmc_cmd(6, (3u << 24) | (32u << 16) | (1u << 8), CMDR_RESP_48B | CMDR_CRC | CMDR_INDEX, 0, &resp);
+	if (st != UINT32_MAX && !(st & INT_ERR)) {
+		(void)hc_wait_int(INT_XFER_COMPLETE, 4 * MMC_DATA_NS);
+		ufs_wr(HC_INT, INT_XFER_COMPLETE);
+	}
+	int error = (st == UINT32_MAX || (st & INT_ERR)) ? EIO : mmc_wait_tran(0);
+	if (error && !logged) {
+		printf("SWEET MMC: cache flush failed (int 0x%x r1 0x%x), ignoring\n", st, resp);
+		logged = true;
+	}
+	return 0;
+}
+
+/*
+ * Take the controller back from LK (verified with shim/k88 diag11 on
+ * 2026-11-14). LK's exit (target_uninit: mmc_put_card_to_sleep, then
+ * sdhci_mode_disable) leaves HC_MODE 0 (legacy mode), its HS400 vendor
+ * settings, the GCC card clock at the HS200 rate, and the card asleep
+ * (CMD7 deselect + CMD5 sleep) at LK's RCA 2. So, as LK's own
+ * sdhci_msm_init does: vendor function register to its default, SDHCI mode
+ * on, reset all, power-control requests acknowledged, bus power on (1.8 V),
+ * card clock 400 kHz from GCC (the SDHCI divider is not used by this
+ * controller), wake the card (CMD5 + CMD7), then high speed, 8-bit, 50 MHz.
+ */
+#define K88_SDCORE_PA           0x07824000ull   /* sdhci-msm core_mem */
+#define CORE_HC_MODE            0x078
+#define CORE_PWRCTL_STATUS      0x0dc
+#define CORE_PWRCTL_MASK        0x0e0
+#define CORE_PWRCTL_CLEAR       0x0e4
+#define CORE_PWRCTL_CTL         0x0e8
+#define HC_VENDOR_FUNC          0x10c
+#define HC_VENDOR_CAPS0         0x11c
+#define K88_GCC_SDCC1_PA        0x01842000ull   /* SDCC1 apps RCG (MSM8916/8952 GCC) */
+#define GCC_CMD                 0x004
+#define GCC_CFG                 0x008
+#define GCC_M                   0x00c
+#define GCC_N                   0x010
+#define GCC_D                   0x014
+
+static volatile uint32_t *k88_core, *k88_gcc;
+
+static void
+k88_pwrack(void)
+{
+	uint32_t ps = 0;
+
+	for (int i = 0; i < 50 && !(ps = k88_core[CORE_PWRCTL_STATUS / 4]); i++) {
+		delay(1000);
+	}
+	if (ps) {
+		k88_core[CORE_PWRCTL_CLEAR / 4] = ps;
+		k88_core[CORE_PWRCTL_CTL / 4] = ((ps & 3) ? 1 : 0) | ((ps & 0xc) ? 4 : 0);
+	}
+}
+
+/* card clock: 400 kHz (XO 19.2 MHz / 12, M/N 1/4) or 50 MHz (GPLL0 800 MHz / 16) */
+static void
+k88_rate(bool fast)
+{
+	ufs_wr(0x2c, ufs_rd(0x2c) & ~4u);
+	if (fast) {
+		k88_gcc[GCC_CFG / 4] = (1u << 8) | 31;
+	} else {
+		k88_gcc[GCC_M / 4] = 1;
+		k88_gcc[GCC_N / 4] = ~3u & 0xff;
+		k88_gcc[GCC_D / 4] = ~4u & 0xff;
+		k88_gcc[GCC_CFG / 4] = (2u << 12) | 23;
+	}
+	k88_gcc[GCC_CMD / 4] |= 1;
+	for (int i = 0; i < 100 && (k88_gcc[GCC_CMD / 4] & 1); i++) {
+		delay(1000);
+	}
+	ufs_wr(0x2c, ufs_rd(0x2c) | 4);
+	delay(2000);
+}
+
+static bool
+k88_tran(uint32_t rca)
+{
+	uint32_t resp = 0, st = mmc_cmd(13, rca << 16, CMDR_RESP_48 | CMDR_CRC | CMDR_INDEX, 0, &resp);
+	if (st == UINT32_MAX || (st & INT_ERR)) {
+		mmc_abort();
+		return false;
+	}
+	return R1_STATE(resp) == 4;
+}
+
+/* R1b command, then DAT0 released; true if answered without error */
+static bool
+k88_cmd_b(uint32_t idx, uint32_t arg)
+{
+	uint32_t resp = 0, st = mmc_cmd(idx, arg, CMDR_RESP_48B | CMDR_CRC | CMDR_INDEX, 0, &resp);
+	if (st == UINT32_MAX || (st & INT_ERR) || (resp & R1_ERRORS)) {
+		mmc_abort();
+		return false;
+	}
+	(void)mmc_wait(HC_PRESENT, PRES_DAT0, PRES_DAT0, MMC_DATA_NS);
+	ufs_wr(HC_INT, 0xffffffff);
+	return true;
+}
+
+static int
+ufs_take_over_host(void)
+{
+	uint32_t resp = 0;
+
+	k88_core = (volatile uint32_t *)ml_io_map(K88_SDCORE_PA, 0x1000);
+	k88_gcc = (volatile uint32_t *)ml_io_map(K88_GCC_SDCC1_PA, 0x1000);
+	printf("SWEET MMC: SDHCI version 0x%x, HC_MODE 0x%x, vendor 0x%x, GCC cfg 0x%x, present 0x%x\n",
+	    ufs_rd(HC_VERSION) >> 16, k88_core[CORE_HC_MODE / 4], ufs_rd(HC_VENDOR_FUNC), k88_gcc[GCC_CFG / 4],
+	    ufs_rd(HC_PRESENT));
+	ufs_wr(HC_VENDOR_FUNC, 0xa1c);
+	k88_core[CORE_HC_MODE / 4] |= 1 | (1u << 13);   /* HC_MODE_EN, FF_CLK_SW_RST_DIS */
+	k88_core[CORE_PWRCTL_MASK / 4] = 0xf;
+	delay(2000);
+	*(volatile uint8_t *)(su.regs + HC_RESET) = 1; /* reset all */
+	(void)mmc_wait(0x2c, 1u << 24, 0, 100 * NSEC_PER_MSEC);
+	k88_pwrack();
+	ufs_wr(HC_VENDOR_CAPS0, ufs_rd(0x40) | (1u << 26));     /* 1.8 V */
+	ufs_wr(HC_SIG_EN, 0);
+	ufs_wr(HC_INT_EN, 0x03ff0033u);
+	ufs_wr(HC_INT, 0xffffffff);
+	*(volatile uint8_t *)(su.regs + 0x29) = 0x0b;   /* bus power on, 1.8 V */
+	k88_pwrack();
+	*(volatile uint8_t *)(su.regs + 0x28) = 0;      /* 1-bit, normal speed, no DMA */
+	ufs_wr(0x3c, ufs_rd(0x3c) & 0xffffu);           /* HOST_CTRL2: legacy timing */
+	ufs_wr(0x2c, (0x0eu << 16) | 1);
+	(void)mmc_wait(0x2c, 2, 2, 100 * NSEC_PER_MSEC);
+	k88_rate(false);
+
+	mmc_rca = 0;
+	for (uint32_t rca = 1; rca <= 3 && !mmc_rca; rca++) {
+		if (k88_tran(rca)) {
+			mmc_rca = rca;
+		}
+	}
+	for (uint32_t rca = 1; rca <= 3 && !mmc_rca; rca++) {
+		if (k88_cmd_b(5, rca << 16) && k88_cmd_b(7, rca << 16) && k88_tran(rca)) {
+			mmc_rca = rca;              /* woken from LK's sleep (LK uses RCA 2) */
+		}
+	}
+	if (!mmc_rca) {
+		printf("SWEET MMC: card does not answer at RCA 1-3, int 0x%x\n", ufs_rd(HC_INT));
+		return ENXIO;
+	}
+	if (!k88_cmd_b(6, (3u << 24) | (185u << 16) | (1u << 8)) ||     /* HS_TIMING = high speed */
+	    !k88_cmd_b(6, (3u << 24) | (183u << 16) | (2u << 8))) {     /* BUS_WIDTH = 8 */
+		printf("SWEET MMC: CMD6 (high speed, 8-bit) failed\n");
+		return EIO;
+	}
+	*(volatile uint8_t *)(su.regs + 0x28) = 0x24;   /* 8-bit, high speed */
+	k88_rate(true);
+	if (!k88_tran(mmc_rca)) {
+		printf("SWEET MMC: card lost after switching to 50 MHz\n");
+		return EIO;
+	}
+	(void)mmc_cmd(13, mmc_rca << 16, CMDR_RESP_48 | CMDR_CRC | CMDR_INDEX, 0, &resp);
+	printf("SWEET MMC: card in TRAN at RCA %u (r1 0x%x), 8-bit high speed 50 MHz\n", mmc_rca, resp);
+	return 0;
+}
+#endif /* SWEET_K88 */
+
 /*
  * File-backed root (boot-arg sweetrootino=N): the iOS root is a plain file in
  * Android's ext4 USERDATA (/data/sweet/root.img, created from TWRP outside the
@@ -1380,6 +1824,47 @@ ufs_find_partition(const char *want)
 	return ENOENT;
 }
 
+#if defined(SWEET_K88)
+/*
+ * K88 root device: the 16 GB eMMC's last three partitions, cache (1 GiB),
+ * system (3 GiB) and userdata (10 GiB), sit back to back (verified in TWRP:
+ * sectors 1179648..30535646), and none alone holds the 13 GiB iOS image.
+ * Darin agreed (2026-11-14) to give all three to iOS, so the root device is
+ * the range from cache's first sector to userdata's last; the GPT is left as
+ * it is. It is presented as a fully written one-extent "root file", so the
+ * read, in-place write and read-back code of the file root runs unchanged
+ * and writes stay inside [cache start, userdata end).
+ */
+static struct ext4_run k88_run;
+
+static int
+k88_span(void)
+{
+	uint64_t first = su.first_block, cache_blocks = su.nblocks;
+	int error = ufs_find_partition("userdata");
+	if (error) {
+		return error;
+	}
+	uint64_t end = su.first_block + su.nblocks;
+	if (su.first_block < first + cache_blocks) {
+		printf("SWEET ROOT: userdata (0x%llx) is not after cache (0x%llx)\n", su.first_block, first);
+		return ENXIO;
