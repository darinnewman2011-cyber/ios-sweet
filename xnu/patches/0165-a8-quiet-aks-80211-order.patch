diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
index d11fe26..44b70ac 100644
--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -232,10 +232,20 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 		break;
 	}
 
-	char name[32];
-	proc_selfname(name, sizeof(name));
-	IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
-	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	/*
+	 * xnu 0165: the selectors the system needs are known by now and the same few calls (searchd 35, ReportCrash
+	 * 17, ...) repeated hundreds of times filled TWRP's 16 KB console tail; log the first 48 calls and the first
+	 * 32 failures only.
+	 */
+	static uint32_t logged, failed;
+	if (logged < 48 || (ret != kIOReturnSuccess && failed < 32)) {
+		char name[32];
+		logged++;
+		failed += ret != kIOReturnSuccess;
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	}
 	return ret;
 }
