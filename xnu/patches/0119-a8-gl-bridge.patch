+static uint32_t gMaliSurfacesLogged;
+
+/* An IOSurface's pixels as a buffer (as y2sios' RedwoodMali surfaceBuffer()): the same surface is the same buffer. */
+IOReturn
+RedwoodMaliUserClient::surfaceBuffer(struct redwood_surface * request)
+{
+	SweetSurface * s = sweet_surface_copy(request->surface);
+	struct mali_buffer * b = NULL;
+	uint64_t size;
+	uintptr_t kernel;
+
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	size = round_page_64(s->allocSize);
+	kernel = s->kernelAddress();
+	if (s->memory == NULL || kernel == 0 || size == 0 || size > MALI_BUFFER_MAX || size > s->memory->getLength()) {
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	request->size = size;
+	request->offset = s->offset;
+	request->rowBytes = s->bytesPerRow;
+	request->width = s->width;
+	request->height = s->height;
+	request->pixelFormat = s->pixelFormat;
+	request->planes = s->planeCount;
+	for (uint32_t i = 0; i < 2; i++) {
+		bool real = i < s->planeCount;
+
+		request->planeOffset[i] = real ? s->planes[i].offset : (i == 0 ? s->offset : 0);
+		request->planeRowBytes[i] = real ? s->planes[i].bytesPerRow : (i == 0 ? s->bytesPerRow : 0);
+	}
+	if (request->handle == kRedwoodDescribe) {
+		request->handle = 0;
+		s->release();
+		return kIOReturnSuccess;
+	}
+	IOLockLock(gMaliLock);
+	for (uint32_t i = 0; i < MALI_BUFFERS; i++) {
+		if (fBuffers[i].memory != NULL && fBuffers[i].surface == s) {
+			b = &fBuffers[i];
+			request->handle = i + 1;
+			break;
+		}
+	}
+	if (b != NULL) {
+		s->release();
+	} else if ((b = newBuffer(s->memory, size, SWEET_MALI_MAP_NOEXEC, &request->handle)) != NULL) {
+		s->memory->retain();
+		b->memory = s->memory;
+		b->surface = s;                        /* (takes the reference) */
+		b->kernel = kernel;
+		if (gMaliSurfacesLogged++ < 8) {
+			IOLog("SWEET MALI: %s imports IOSurface %u (%ux%u, format %#x, %llu KB) as buffer %u at %#llx\n", fName, s->id,
+			    s->width, s->height, s->pixelFormat, size >> 10, request->handle, b->address);
+		}
+	} else {
+		s->release();
+	}
+	IOLockUnlock(gMaliLock);
+	return b != NULL ? kIOReturnSuccess : kIOReturnNoMemory;
+}
+
+void
+sweet_mali_surface_for_cpu(SweetSurface * s, uintptr_t kaddr)
+{
+	uint64_t fence = s->gpuFence;
+	static uint32_t late;
+
+	if (fence == 0 || fence == s->gpuSeen || kaddr == 0) {
+		return;
+	}
+	if (!sweet_mali_wait(fence, MALI_SURFACE_WAIT_MS) && late++ < 8) {
+		IOLog("SWEET MALI: IOSurface %u: job %llu not done after %u ms; shown as it is\n", s->id, fence, MALI_SURFACE_WAIT_MS);
+	}
+	sweet_mali_to_memory((const void *) kaddr, s->allocSize);
+	s->gpuSeen = fence;
+}
