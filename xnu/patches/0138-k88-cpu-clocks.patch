+#if defined(SWEET_K88)
+/*
+ * MSM8952 CPU clocks and VDD_APC (verified with the K88 boot shim, diag12-19).
+ * LK leaves the boot cluster (MPIDR 0x1xx, RCG 0xb011050) on GPLL0 800 MHz and
+ * the other (0x0xx, RCG 0xb111050) on XO 19.2 MHz, both A53SS PLLs off, VDD_APC
+ * (PM8950 S5) at 1.225 V. Turbo: S5 to the CPR open-loop fuse voltage + 25 mV,
+ * mem-acc 0xffff, PLL1 L 79 (1516.8 MHz), PLL0 L 63 (1209.6 MHz); nominal
+ * (k88clock=1): PLL1 L 70 (1344), PLL0 L 57 (1094.4), voltage unchanged.
+ * c0's PLL and RCG only work while that cluster is powered, and a c0 core
+ * restarted at XO hangs, so c0 is switched once its first core runs XNU.
+ * Boot-arg k88clock: 0 = leave LK's clocks, 1 = nominal, 2 = turbo (default).
+ */
+#define K88_SPMI_CORE   0x0200f000UL
+#define K88_SPMI_OBS    0x02c00000UL
+#define K88_SPMI_CHNLS  0x02400000UL
+#define K88_PLL_C1      0x0b016000UL
+#define K88_PLL_C0      0x0b116000UL
+#define K88_RCG_C1      0x0b011050UL
+#define K88_RCG_C0      0x0b111050UL
+#define K88_MEMACC      0x01942130UL
+#define K88_QFPROM_ROW  (0x0005c000UL + 8 * 0x1b)
+
+static uint32_t k88_clock_mode = 2;
+static uint32_t k88_c0_l;
+
+static volatile uint32_t *
+k88_map(uintptr_t pa)
+{
+	return (volatile uint32_t *)(ml_io_map(pa & ~0xfffUL, 0x1000) + (pa & 0xfff));
+}
+
+static int
+k88_spmi_chan(unsigned sid, unsigned periph)
+{
+	volatile uint32_t *core = k88_map(K88_SPMI_CORE + 0x800);
+	for (int ch = 0; ch < 256; ch++) {
+		if (((core[ch] >> 8) & 0xfff) == ((sid << 8) | periph)) {
+			return ch;
+		}
+	}
+	return -1;
+}
+
+/* opc 1 = EXT_READL through the observer channel, 0 = EXT_WRITEL through chnls; one byte */
+static uint32_t
+k88_spmi(int write, unsigned sid, unsigned addr, uint8_t v)
+{
+	int ch = k88_spmi_chan(sid, addr >> 8);
+	if (ch < 0) {
+		return 0x1ff;
+	}
+	volatile uint32_t *b = k88_map((write ? K88_SPMI_CHNLS : K88_SPMI_OBS) + 0x8000UL * ch);
+	if (write) {
+		b[0x10 / 4] = v;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	b[0] = ((write ? 0u : 1u) << 27) | ((addr & 0xff) << 4);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t st = b[0x08 / 4];
+		if (st & 1) {
+			return (st & 0xe) ? 0x100 | st : (write ? 0 : (b[0x18 / 4] & 0xff));
+		}
+		IODelay(1);
+	}
+	return 0x1fe;
+}
+
+/* A53SS PLL: off, L, outputs, bypass, reset release, lock (status bit 16), output on */
+static int
+k88_pll_set(uintptr_t pa, uint32_t l)
+{
+	volatile uint32_t *p = k88_map(pa);
+	p[0] = 0;
+	p[1] = l;
+	p[2] = 0;
+	p[3] = 1;
+	p[4] |= 9;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	p[0] = 2;
+	IODelay(1000);
+	p[0] = 6;
+	for (int i = 0; i < 100; i++) {
+		if (p[7] & (1u << 16)) {
+			p[0] = 7;
+			return 0;
+		}
+		IODelay(1000);
+	}
+	return -1;
+}
+
+/* RCG source switch: CFG = src << 8 | div 1, UPDATE, wait for it to clear */
+static int
+k88_rcg_src(uintptr_t pa, uint32_t src)
+{
+	volatile uint32_t *r = k88_map(pa);
+	r[1] = (src << 8) | 1;
+	r[0] |= 1;
+	for (int i = 0; i < 100; i++) {
+		if (!(r[0] & 1)) {
+			return 0;
+		}
+		IODelay(1000);
+	}
+	return -1;
+}
+
+/* Before any secondary starts: voltage, mem-acc, boot cluster (c1) to its PLL. */
+static void
+k88_clock_boot_cluster(void)
+{
+	PE_parse_boot_argn("k88clock", &k88_clock_mode, sizeof(k88_clock_mode));
+	if (k88_clock_mode == 0) {
+		IOLog("SWEET K88 CLOCK: off (k88clock=0), LK's clocks kept\n");
+		return;
+	}
+	uint32_t l1 = 70;
+	k88_c0_l = 57;
+	if (k88_clock_mode >= 2) {
+		uint32_t fuse = *k88_map(K88_QFPROM_ROW) & 0x3f;
+		int uv = 1350000 + ((fuse & 0x20) ? -1 : 1) * (int)(fuse & 0x1f) * 10000 + 25000;
+		uv = uv < 1130000 ? 1130000 : (uv > 1350000 ? 1350000 : uv);
+		uint32_t vset = (uint32_t)(uv - 80000) / 5000;
+		uint32_t before = k88_spmi(0, 1, 0x2041, 0);
+		uint32_t wr = k88_spmi(1, 1, 0x2041, (uint8_t)vset);
+		IODelay(2000);
+		uint32_t now = k88_spmi(0, 1, 0x2041, 0);
+		IOLog("SWEET K88 CLOCK: fuse 0x%x -> %d uV, S5 VSET 0x%x -> 0x%x (write %u)\n",
+		    fuse, uv, before, now, wr);
+		if (wr == 0 && now == vset) {
+			*k88_map(K88_MEMACC) = 0xffff;
+			__asm__ volatile ("dsb sy" ::: "memory");
+			l1 = 79;
+			k88_c0_l = 63;
+		} else {
+			IOLog("SWEET K88 CLOCK: voltage not confirmed, nominal clocks instead\n");
+		}
+	}
+	int e1 = k88_pll_set(K88_PLL_C1, l1);
+	int e2 = e1 ? -1 : k88_rcg_src(K88_RCG_C1, 5);
+	IOLog("SWEET K88 CLOCK: boot cluster PLL1 L %u (%u kHz): pll %d rcg %d\n",
+	    l1, l1 * 19200, e1, e2);
+}
+
+/* Once the first c0 core runs (its cluster powered): PLL0, then c0 off XO onto it. */
+static void
+k88_clock_c0(void)
+{
+	if (k88_clock_mode == 0 || k88_c0_l == 0) {
+		return;
+	}
+	int e1 = k88_pll_set(K88_PLL_C0, k88_c0_l);
+	int e2 = e1 ? -1 : k88_rcg_src(K88_RCG_C0, 5);
+	IOLog("SWEET K88 CLOCK: second cluster PLL0 L %u (%u kHz): pll %d rcg %d\n",
+	    k88_c0_l, k88_c0_l * 19200, e1, e2);
+	k88_c0_l = 0;
+}
+#endif /* SWEET_K88 */
+
 class SweetCPU : public IOCPU {
 	OSDeclareDefaultStructors(SweetCPU);
 	const OSSymbol *cpuName = NULL;
@@ -156,6 +315,9 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 		panic("SWEET CPU: expected boot MPIDR 0x%x as logical CPU 0, got 0x%x as %u",
 		    SWEET_BOOT_MPIDR, topology->boot_cpu->phys_id, topology->boot_cpu->cpu_id);
 	}
+#if defined(SWEET_K88)
+	k88_clock_boot_cluster();
+#endif
 	for (unsigned int i = 0; i < topology->num_cpus; i++) {
 		SweetCPU *cpu = __atomic_load_n(&sweet_cpus[i], __ATOMIC_ACQUIRE);
 		kern_return_t kr = processor_start(cpu->machProcessor);
@@ -163,7 +325,12 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 			panic("SWEET CPU: cpu=%u processor_start failed: %d", i, kr);
 		}
 		/* processor_start() is asynchronous for secondaries in this XNU. */
+#if defined(SWEET_K88)
+		/* the second cluster's first core still runs at XO 19.2 MHz */
+		nanoseconds_to_deadline(30 * NSEC_PER_SEC, &deadline);
+#else
 		nanoseconds_to_deadline(5 * NSEC_PER_SEC, &deadline);
+#endif
 		while (__atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE) == 0 ||
 		    !sweet_cpu_signal_is_enabled(i)) {
 			if (mach_absolute_time() > deadline) {
@@ -175,6 +342,11 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 		}
 		IOLog("SWEET CPU: cpu=%u mpidr=0x%x came alive; SGI1 OK\n",
 		    i, topology->cpus[i].phys_id);
+#if defined(SWEET_K88)
+		if (topology->cpus[i].phys_id < 0x100) {
+			k88_clock_c0();
+		}
+#endif
 	}
 	/* Publish exactly once, after every selected CPU has completed initCPU(). */
 	ml_cpu_init_completed();
