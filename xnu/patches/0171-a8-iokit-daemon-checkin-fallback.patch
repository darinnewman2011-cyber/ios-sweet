+/*
+ * xnu 0171: the root keeps one busy count from StartIOKitMatching until the IOKit daemon (driverkitd on iOS)
+ * checks in through kext_request (OSKext: sendAllKextPersonalitiesToCatalog -> IOService::iokitDaemonLaunched).
+ * On the A8 that check-in never completes, so IOKit is never quiet, configd's InterfaceNamer never says so, and
+ * every SCNetworkInterfaceCopyAll (wifid, CoreWiFi) blocks in __wait_for_IOKit_to_quiesce. If the daemon has not
+ * checked in by then, do what its check-in does. OSKext's own path skips a second release once the daemon is
+ * marked active.
+ */
+extern "C" void sweet_iokit_daemon_fallback(void);
+extern "C" void
+sweet_iokit_daemon_fallback(void)
+{
+	if (OSKext::iokitDaemonActive()) {
+		IOLog("SWEET IOKIT: the IOKit daemon checked in; root busy %u\n", IOService::getServiceRoot()->getBusyState());
+		return;
+	}
+	IOLog("SWEET IOKIT: no IOKit daemon check-in; marking it launched (root busy %u)\n",
+	    IOService::getServiceRoot()->getBusyState());
+	OSKext::setIOKitDaemonActive();
+	OSKext::setDeferredLoadSucceeded(TRUE);
+	IOService::iokitDaemonLaunched();
+	IOLog("SWEET IOKIT: root busy now %u\n", IOService::getServiceRoot()->getBusyState());
+}
