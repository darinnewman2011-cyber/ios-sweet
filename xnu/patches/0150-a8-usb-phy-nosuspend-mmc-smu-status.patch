 {
+#if defined(SWEET_JACKPOTLTE)
+	/*
+	 * xnu 0150: Linux dwc3_send_gadget_ep_cmd clears GUSB2PHYCFG.SUSPHY and ENBLSLPM before every endpoint
+	 * command: with the USB 2.0 PHY allowed to suspend, commands never complete (ios108u: SETEPCONFIG on ep0
+	 * timed out with CMDACT stuck after DEPSTARTCFG had passed).
+	 */
+	dwc_wr(0xc200, dwc_rd(0xc200) & ~((1u << 6) | (1u << 8)));
+#endif
 	dwc_wr(DEPCMDPAR0(ep), p0);
 	dwc_wr(DEPCMDPAR1(ep), p1);
 	dwc_wr(DEPCMDPAR2(ep), p2);
