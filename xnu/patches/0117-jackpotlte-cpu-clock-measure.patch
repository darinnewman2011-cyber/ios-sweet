diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 519516d..b0b8907 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1058,9 +1058,66 @@ run_ok:
 
 static int wst_chan;
 
+#if defined(SWEET_JACKPOTLTE)
+/* osfmk/kern/processor.h and sched_prim.h, not exported to the BSD layer */
+extern processor_t cpu_to_processor(int cpu);
+extern processor_t thread_bind(processor_t processor);
+extern unsigned int real_ncpus;
+
+/*
+ * The clock of the CPU this runs on, in MHz: its PMU cycle counter against the 26 MHz generic timer for 5 ms.
+ * The device tree's cpufreq domains say the A53s (CPUs 0-5) go to 1690 MHz and the A73s (6-7) to 2184 MHz; this
+ * shows what S-Boot left them at, before any DVFS of ours.
+ */
+static uint64_t
+cpu_mhz_here(void)
+{
+	uint64_t pmcr, freq, t0, t1, c0, c1;
+
+	__asm__ volatile ("mrs %0, pmcr_el0" : "=r"(pmcr));
+	pmcr = (pmcr | 1) & ~8ull;                       /* E on, D (count every 64th cycle) off */
+	__asm__ volatile ("msr pmccfiltr_el0, xzr\n msr pmcr_el0, %0\n msr pmcntenset_el0, %1\n isb"
+	    : : "r"(pmcr), "r"(1ull << 31) : "memory");
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(freq));
+	__asm__ volatile ("isb\n mrs %0, cntvct_el0\n mrs %1, pmccntr_el0" : "=r"(t0), "=r"(c0));
+	do {
+		__asm__ volatile ("isb\n mrs %0, cntvct_el0\n mrs %1, pmccntr_el0" : "=r"(t1), "=r"(c1));
+	} while (t1 - t0 < freq / 200);
+	return (c1 - c0) * freq / (t1 - t0) / 1000000;
+}
+
+/* Once, from wst_thread: every CPU's clock, by binding this thread to each in turn. */
+static void
+sweet_cpu_clocks(void)
+{
+	char line[160];
+	int n = 0;
+
+	for (int cpu = 0; cpu < (int)real_ncpus && cpu < 8; cpu++) {
+		processor_t p = cpu_to_processor(cpu);
+		uint64_t mpidr;
+
+		if (p == PROCESSOR_NULL) {
+			continue;
+		}
+		thread_bind(p);
+		thread_block(THREAD_CONTINUE_NULL);             /* now on that CPU */
+		__asm__ volatile ("mrs %0, mpidr_el1" : "=r"(mpidr));
+		n += snprintf(line + n, sizeof(line) - n, " cpu%d(%s) %llu", cpu, (mpidr & 0xff00) ? "A53" : "A73",
+		    cpu_mhz_here());
+	}
+	thread_bind(PROCESSOR_NULL);
+	thread_block(THREAD_CONTINUE_NULL);
+	printf("SWEET CPU: MHz%s (DT maximum: A53 1690, A73 2184)\n", line);
+}
+#endif
+
 static void
 wst_thread(__unused void *arg, __unused wait_result_t wr)
 {
+#if defined(SWEET_JACKPOTLTE)
+	int clocks = 0;
+#endif
 	for (;;) {
 		uint64_t deadline;
 		clock_interval_to_deadline(30, NSEC_PER_SEC, &deadline);
@@ -1074,6 +1131,11 @@ wst_thread(__unused void *arg, __unused wait_result_t wr)
 		    wst.wbad, wst.rbad, wst.zero, wst.bad_lba, wst.bad_want, wst.bad_got, wst.dirty,
 		    wst.multi, wst.mfail, wst.mbad);
 		sweet_mali_status();
+#if defined(SWEET_JACKPOTLTE)
+		if (clocks++ % 4 == 0) {                        /* 30 s after boot, then every 2 minutes */
+			sweet_cpu_clocks();
+		}
+#endif
 	}
 }
 
