diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index e47fc90..67e06ad 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -611,6 +611,314 @@ mmc_abort(void)
 	(void)mmc_wait(MMC_STATUS, STATUS_BUSY, 0, MMC_DATA_NS);
 }
 
+/*
+ * xnu 0144: IDMAC (the controller's own DMA) for multi-sector transfers,
+ * boot-arg sweetmmcdma=1. PIO moved every word through the CPU (~1 MB/s
+ * before 0111, a few MB/s after). Facts from Samsung's dw_mmc.c /
+ * dw_mmc-exynos.h / include/linux/mmc/dw_mmc.h (Exynos7885-Dev
+ * lineage-18.1, read only): 64-bit descriptors des0 control (OWN 31, CH 4,
+ * FD 3, LD 2, DIC 1), des2 buffer 1 size (13 bits, Samsung uses <= 4 KiB),
+ * des4/5 buffer address, des6/7 next descriptor; with the flash memory
+ * protector (FMP, present on this SoC) a descriptor grows to 32 words (IVs
+ * and keys, all zero here = no encryption), so slots are 128 bytes and the
+ * chain pointers are explicit. Registers DBADDRL 0x88 / DBADDRU 0x8c,
+ * IDSTS64 0x90, IDINTEN64 0x94, PLDMND 0x84; start = CTRL.DMA_ENABLE|USE_IDMAC, then
+ * BMOD DE|FB, then PLDMND = 1; stop = clear both, CTRL DMA_RESET, BMOD
+ * SWR. No SysMMU sits in front of this controller (no iommus in the DT).
+ * The CPU caches are not coherent with it: buffers are cleaned before a
+ * write and flushed before and after a read. Descriptors live in the first
+ * 16 KiB of su.dma (the UFS request lists, unused on the A8). Polled, no IRQ.
+ * Any failure stops the DMA, sends CMD12 and redoes the range by PIO; after
+ * MMC_DMA_GIVEUP failures DMA is switched off for the boot.
+ */
+#define MMC_PLDMND      0x084
+#define MMC_DBADDRL     0x088
+#define MMC_DBADDRU     0x08c
+#define MMC_IDSTS64     0x090
+#define MMC_IDINTEN64   0x094
+#define CTRL_DMA_RESET          (1u << 2)
+#define BMOD_SWR                (1u << 0)
+#define BMOD_FB                 (1u << 1)
+#define IDS_TI                  (1u << 0)
+#define IDS_RI                  (1u << 1)
+#define IDS_FBE                 (1u << 2)
+#define IDS_DU                  (1u << 4)
+#define IDS_CES                 (1u << 5)
+#define IDS_ALL                 0x337u
+#define DES0_DIC                (1u << 1)
+#define DES0_LD                 (1u << 2)
+#define DES0_FD                 (1u << 3)
+#define DES0_CH                 (1u << 4)
+#define DES0_OWN                (1u << 31)
+#define MMC_DESC_SLOT   128u
+#define MMC_DESC_MAX    (0x4000u / MMC_DESC_SLOT)       /* 128 */
+#define MMC_DMA_CHUNK   4096u
+#define MMC_DMA_GIVEUP  8
+
+static uint32_t mmc_dma;                        /* boot-arg sweetmmcdma */
+/*
+ * xnu 0146: Samsung's dw_mmc picks the IDMAC layout from HCON at run time (bits 17:16 = 0: internal DMA,
+ * bit 27 ADDR_CONFIG: 1 = 64-bit DBADDRL/U 0x88/0x8c, IDSTS64 0x90, 32-byte+ descriptors; 0 = 32-bit DBADDR 0x88,
+ * IDSTS 0x8c, IDINTEN 0x90, 16-byte descriptors des0 ctrl / des1 size / des2 buffer / des3 next). 0144 assumed
+ * 64-bit; on ios103t-105t IDSTS64 read 0 and no descriptor was ever taken. In 32-bit mode a transfer whose buffer or
+ * descriptors sit above 4 GiB goes by PIO (EINVAL before any register is touched, not counted as a failure).
+ */
+#define MMC_DBADDR32    0x088
+#define MMC_IDSTS32     0x08c
+#define MMC_IDINTEN32   0x090
+static int mmc_dma64 = -1;                      /* -1: HCON not read yet */
+/*
+ * xnu 0148: ios107u (HCON: IDMAC 64-bit) still never had a descriptor taken. The DT links this controller to the
+ * Exynos SMU (mmc-exynos-smu = /smu, samsung,exynos-smu), the access-control unit in front of the IDMAC, and Samsung's
+ * driver sets it up through the secure world at probe (dw_mci_probe: access_control_sec_cfg, then _init;
+ * crypto/fmp/smu_dev.c): SMC_CMD_FMP_SECURITY 0xC2001810 (0, SMU_EMBEDDED 0, CFG_DESCTYPE 3 = FMP descriptors) and
+ * SMC_CMD_SMU 0xC2001850 (SMU_INIT 0, SMU_EMBEDDED 0, 0). PIO (CPU reads of the FIFO) never needed it. Done once
+ * before the first DMA; the MPS entry-0 registers (controller +0x1200) are logged before and after.
+ */
+#define MMC_MPSBEGIN0   0x1200
+#define MMC_MPSEND0     0x1204
+#define MMC_MPSLUN0     0x1208
+#define MMC_MPSCTRL0    0x120c
+static uint64_t
+mmc_smc4(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) :: "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	    "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	return x0;
+}
+
+static void
+mmc_smu_show(const char *when)
+{
+	printf("SWEET MMC: SMU %s: MPSBEGIN0 0x%08x MPSEND0 0x%08x MPSLUN0 0x%08x MPSCTRL0 0x%08x\n", when,
+	    ufs_rd(MMC_MPSBEGIN0), ufs_rd(MMC_MPSEND0), ufs_rd(MMC_MPSLUN0), ufs_rd(MMC_MPSCTRL0));
+}
+static uint64_t mmc_dma_above4g;                /* 32-bit mode: transfers left to PIO */
+static uint32_t mmc_hcon;                       /* xnu 0150: kept for the 30 s status line */
+static uint32_t mmc_fifoth0, mmc_fifoth1;       /* xnu 0153: FIFOTH before / after */
+static char mmc_hs400_note[160] = "HS400 off (sweeths400=0)";     /* xnu 0162 */
+static uint64_t mmc_smc_sec = ~0ull, mmc_smc_init = ~0ull;
+static uint32_t mmc_dma_chk[MMC_MULTI_MAX * UFS_BLOCK / 4] __attribute__((aligned(64)));
+static uint64_t mmc_dma_check_lba;
+static struct {
+	uint64_t xfers, sectors, fail;
+	uint32_t rint, ids, n, write, where, r1, d0;
+	uint64_t checked, mismatch;              /* DMA reads compared with a PIO read of the same sectors */
+	uint64_t lba;
+	uint64_t rd_bytes, rd_abs;              /* every file read, PIO or DMA: throughput for the status line */
+} mdma;
+
+static uint64_t
+mmc_kva_pa(const void *va)
+{
+	uintptr_t v = (uintptr_t)va;
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(v & ~(uintptr_t)PAGE_MASK));
+
+	return pn ? ptoa_64(pn) + (v & PAGE_MASK) : 0;
+}
+
+static void
+mmc_dma_stop(void)
+{
+	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) & ~(CTRL_USE_IDMAC | CTRL_DMA_ENABLE));
+	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) | CTRL_DMA_RESET);
+	(void)mmc_wait(MMC_CTRL, CTRL_DMA_RESET, 0, 10 * NSEC_PER_MSEC);
+	ufs_wr(MMC_BMOD, (ufs_rd(MMC_BMOD) & ~(BMOD_IDMAC_ENABLE | BMOD_FB)) | BMOD_SWR);
+	(void)mmc_wait(MMC_BMOD, BMOD_SWR, 0, 10 * NSEC_PER_MSEC);
+	ufs_wr(mmc_dma64 == 0 ? MMC_IDSTS32 : MMC_IDSTS64, IDS_ALL);
+}
+
+static int
+mmc_xfer_dma(uint64_t lba, uint32_t n, uint32_t *buf, bool write)
+{
+	uint8_t *dbase = (uint8_t *)su.dma;
+	uint32_t bytes = n * UFS_BLOCK, nd = 0, st, resp = 0, r = 0, ids = 0, where = 0;
+	uint64_t deadline;
+
+	if (((uintptr_t)buf & 7) != 0) {
+		return EINVAL;
+	}
+	if (mmc_dma64 < 0) {
+		uint32_t hcon = ufs_rd(MMC_HCON);
+
+		mmc_hcon = hcon;
+		mmc_dma64 = (hcon >> 27) & 1;
+		printf("SWEET MMC: VERID 0x%x HCON 0x%08x: DMA interface %u (0 = IDMAC), IDMAC %s-bit, descriptors at 0x%llx\n",
+		    ufs_rd(0x06c), hcon, (hcon >> 16) & 3, mmc_dma64 ? "64" : "32", su.dma_pa);
+		if (((hcon >> 16) & 3) != 0) {
+			printf("SWEET MMC: no internal DMA on this controller, DMA off\n");
+			mmc_dma = 0;
+			return EINVAL;
+		}
+		mmc_smu_show("before");
+		uint64_t sec = mmc_smc4(0xC2001810ull, 0, 0, 3);
+		uint64_t init = mmc_smc4(0xC2001850ull, 0, 0, 0);
+		printf("SWEET MMC: SMC FMP_SECURITY(0, 0, 3) -> 0x%llx, SMC SMU(INIT, EMBEDDED) -> 0x%llx\n", sec, init);
+		mmc_smc_sec = sec;
+		mmc_smc_init = init;
+		mmc_smu_show("after");
+		/*
+		 * xnu 0153: FIFO thresholds for the IDMAC. ios109u: SMU open (MPSCTRL0 0xf1), first descriptor taken,
+		 * then the data stayed in the FIFO (RXDR). Our driver never wrote FIFOTH (0x4c); Samsung's probe sets
+		 * MSIZE 2 (8 transfers), RX_WMARK depth/2 - 1, TX_WMARK depth/2, the depth being the bootloader's RX_WMARK + 1
+		 * (no fifo-depth in this DT). A burst larger than the RX watermark allows never starts.
+		 */
+		{
+			uint32_t f = ufs_rd(0x04c), depth = 1 + ((f >> 16) & 0xfff);
+
+			if (depth < 16 || depth > 4096) {
+				depth = 64;
+			}
+			mmc_fifoth0 = f;
+			ufs_wr(0x04c, (2u << 28) | ((depth / 2 - 1) << 16) | (depth / 2));
+			mmc_fifoth1 = ufs_rd(0x04c);
+			printf("SWEET MMC: FIFOTH 0x%08x -> 0x%08x (FIFO depth %u)\n", mmc_fifoth0, mmc_fifoth1, depth);
+		}
+	}
+	/* descriptors: one per 4 KiB piece that does not cross a 4 KiB boundary */
+	for (uint32_t off = 0; off < bytes;) {
+		const uint8_t *p = (const uint8_t *)buf + off;
+		uint32_t len = MIN(bytes - off, MMC_DMA_CHUNK - (uint32_t)((uintptr_t)p & (MMC_DMA_CHUNK - 1)));
+		uint64_t pa = mmc_kva_pa(p);
+		volatile uint32_t *d = (volatile uint32_t *)(void *)(dbase + nd * MMC_DESC_SLOT);
+		uint64_t next = su.dma_pa + (nd + 1) * MMC_DESC_SLOT;
+
+		if (!pa || nd >= MMC_DESC_MAX) {
+			return EINVAL;
+		}
+		if (!mmc_dma64 && ((pa + len - 1) >> 32 || (next + MMC_DESC_SLOT - 1) >> 32)) {
+			mmc_dma_above4g++;
+			return EINVAL;
+		}
+		for (uint32_t k = 0; k < MMC_DESC_SLOT / 4; k++) {
+			d[k] = 0;
+		}
+		d[0] = DES0_OWN | DES0_DIC | DES0_CH;
+		if (mmc_dma64) {
+			d[2] = len & 0x1fff;
+			d[4] = (uint32_t)pa;
+			d[5] = (uint32_t)(pa >> 32);
+			d[6] = (uint32_t)next;
+			d[7] = (uint32_t)(next >> 32);
+		} else {
+			d[1] = len & 0x1fff;
+			d[2] = (uint32_t)pa;
+			d[3] = (uint32_t)next;
+		}
+		if (write) {
+			clean_dcache64((addr64_t)pa, len, TRUE);
+		} else {
+			flush_dcache64((addr64_t)pa, len, TRUE);
+		}
+		off += len;
+		nd++;
+	}
+	volatile uint32_t *first = (volatile uint32_t *)(void *)dbase;
+	volatile uint32_t *last = (volatile uint32_t *)(void *)(dbase + (nd - 1) * MMC_DESC_SLOT);
+	first[0] |= DES0_FD;
+	last[0] = (last[0] & ~(DES0_CH | DES0_DIC)) | DES0_LD;
+	clean_dcache64((addr64_t)su.dma_pa, nd * MMC_DESC_SLOT, TRUE);
+
+	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) | CTRL_FIFO_RESET);
+	(void)mmc_wait(MMC_CTRL, CTRL_FIFO_RESET, 0, 10 * NSEC_PER_MSEC);
+	mmc_dma_stop();                         /* clean IDMAC state, descriptor pointer back to DBADDR */
+	if (mmc_dma64) {
+		ufs_wr(MMC_IDINTEN64, 0);
+		ufs_wr(MMC_DBADDRL, (uint32_t)su.dma_pa);
+		ufs_wr(MMC_DBADDRU, (uint32_t)(su.dma_pa >> 32));
+	} else {
+		ufs_wr(MMC_IDINTEN32, 0);
+		ufs_wr(MMC_DBADDR32, (uint32_t)su.dma_pa);
+	}
+	ufs_wr(MMC_BLKSIZ, 512);
+	ufs_wr(MMC_BYTCNT, bytes);
+	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) | CTRL_USE_IDMAC | CTRL_DMA_ENABLE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ufs_wr(MMC_BMOD, ufs_rd(MMC_BMOD) | BMOD_IDMAC_ENABLE | BMOD_FB);
+	ufs_wr(MMC_PLDMND, 1);
+	st = mmc_cmd(write ? 25 : 18, (uint32_t)lba, CMD_RESP_EXP | CMD_RESP_CRC | CMD_DAT_EXP | CMD_PRV_DAT_WAIT |
+	    CMD_SEND_STOP | (write ? CMD_READ_WRITE : 0), &resp);
+	if (st == UINT32_MAX || (st & MMC_WR_ERROR) || (resp & R1_ERRORS)) {
+		r = st;
+		where = 1;
+		goto fail;
+	}
+	nanoseconds_to_absolutetime(4 * MMC_DATA_NS, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		r = ufs_rd(MMC_RINTSTS);
+		ids = ufs_rd(mmc_dma64 ? MMC_IDSTS64 : MMC_IDSTS32);
+		/*
+		 * xnu 0156: the descriptors are in cached memory and the IDMAC writes their OWN bits behind the cache:
+		 * drop the last descriptor's line before looking (it was cleaned before the start and the CPU has not
+		 * written it since, so nothing dirty is lost). ios103t-109u read a stale OWN = 1 every time and gave
+		 * up on transfers whose data-over had already arrived.
+		 */
+		flush_dcache64((addr64_t)(su.dma_pa + (nd - 1) * MMC_DESC_SLOT), MMC_DESC_SLOT, TRUE);
+		if ((r & MMC_WR_ERROR) || (ids & (IDS_FBE | IDS_DU | IDS_CES))) {
+			where = 2;
+			goto fail;
+		}
+		/*
+		 * ios103t: every DMA read ended with rintsts 0x402c (data over, auto
+		 * CMD12 done, no error) but IDSTS64 0 and was given up; whether the
+		 * IDMAC moved the data is checked by the PIO compare in mmc_xfer_multi.
+		 * Data over is enough here once the IDMAC has let go of the last
+		 * descriptor (OWN clear).
+		 */
+		if ((r & INT_DATA_OVER) && ((ids & (write ? IDS_TI : IDS_RI)) || !(last[0] & DES0_OWN))) {
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			where = 3;
+			goto fail;
+		}
+	}
+	if (!mmc_wait(MMC_RINTSTS, INT_ACD, INT_ACD, MMC_CMD_NS) || (ufs_rd(MMC_RESP1) & R1_ERRORS)) {
+		r = ufs_rd(MMC_RINTSTS);
+		resp = ufs_rd(MMC_RESP1);
+		where = 4;
+		goto fail;
+	}
+	mmc_dma_stop();
+	if (!write) {
+		for (uint32_t off = 0; off < bytes;) {
+			const uint8_t *p = (const uint8_t *)buf + off;
+			uint32_t len = MIN(bytes - off, MMC_DMA_CHUNK - (uint32_t)((uintptr_t)p & (MMC_DMA_CHUNK - 1)));
+			flush_dcache64((addr64_t)mmc_kva_pa(p), len, TRUE);
+			off += len;
+		}
+	}
+	mdma.xfers++;
+	mdma.sectors += n;
+	return write ? mmc_wait_tran(lba) : 0;
+fail:
+	mmc_dma_stop();
+	if (!mdma.fail++) {
+		mdma.rint = r;
+		mdma.ids = ids;
+		mdma.where = where;
+		mdma.r1 = resp;
+		flush_dcache64((addr64_t)su.dma_pa, MMC_DESC_SLOT, TRUE);  /* xnu 0156: the IDMAC's view, not the cache's */
+		mdma.d0 = ((volatile uint32_t *)(void *)su.dma)[0];
+		mdma.n = n;
+		mdma.write = write;
+		mdma.lba = lba;
+		printf("SWEET MMC: DMA CMD%u of %u at 0x%llx failed: rintsts 0x%x idsts 0x%x r1 0x%x; redoing by PIO\n",
+		    write ? 25 : 18, n, lba, r, ids, resp);
+	}
+	if (mdma.fail >= MMC_DMA_GIVEUP && mmc_dma) {
+		mmc_dma = 0;
+		printf("SWEET MMC: %llu DMA failures, DMA off for this boot\n", mdma.fail);
+	}
+	mmc_abort();
+	return EIO;
+}
+
 static int
 mmc_xfer_multi(uint64_t lba, uint32_t n, uint32_t *buf, bool write)
 {
@@ -624,6 +932,25 @@ mmc_xfer_multi(uint64_t lba, uint32_t n, uint32_t *buf, bool write)
 		printf("SWEET MMC: refusing write of %u at 0x%llx (writable 0x%llx-0x%llx)\n", n, lba, mmc_wr_lo, mmc_wr_hi);
 		return wst_fail(EPERM, 1, lba, n, 0);
 	}
+	/* sweetmmcdma=1: reads only; 2: writes too. The first 64 DMA reads are read again by PIO and compared. */
+	if (mmc_dma && (!write || mmc_dma >= 2) && mmc_xfer_dma(lba, n, buf, write) == 0) {
+		if (write || mdma.checked >= 64) {
+			return 0;
+		}
+		mdma.checked++;
+		mmc_dma_check_lba = lba;
+		uint32_t keep = mmc_dma;
+		mmc_dma = 0;
+		int e = mmc_xfer_multi(lba, n, mmc_dma_chk, false);
+		mmc_dma = keep;
+		if (e == 0 && memcmp(mmc_dma_chk, buf, n * UFS_BLOCK) == 0) {
+			return 0;
+		}
+		mdma.mismatch++;
+		mmc_dma = 0;
+		memcpy(buf, mmc_dma_chk, n * UFS_BLOCK);
+		return e;
+	}
 	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) | CTRL_FIFO_RESET);
 	(void)mmc_wait(MMC_CTRL, CTRL_FIFO_RESET, 0, 10 * NSEC_PER_MSEC);
 	if (!mmc_wait(MMC_STATUS, STATUS_FCNT_MASK | STATUS_FIFO_EMPTY, STATUS_FIFO_EMPTY, 10 * NSEC_PER_MSEC)) {
@@ -882,6 +1209,43 @@ ext4_map_file(uint32_t ino)
 	return error;
 }
 
+/*
+ * xnu 0178 (boot-arg sweetrootraw=1): the iOS root is the partition itself, an HFS volume written raw onto
+ * USERDATA (no ext4, no root.img). One identity run maps all of it, so the file-backed read and write paths
+ * (bounds, multi-block transfers, read-back) work unchanged and sweetrootrw=1 makes it writable. Refused
+ * unless an HFS+ / HFSX volume header sits at byte 1024, so an Android ext4 USERDATA is never written.
+ */
+static int
+raw_map_partition(uint64_t part_blocks)
+{
+	uint8_t vh[512];
+	int error = part_read(1024, vh, sizeof(vh));
+
+	if (error) {
+		return error;
+	}
+	if (vh[0] != 'H' || (vh[1] != '+' && vh[1] != 'X')) {
+		printf("SWEET ROOT: sweetrootraw: no HFS volume header on the partition (0x%02x%02x), refusing\n",
+		    vh[0], vh[1]);
+		return EINVAL;
+	}
+	xf.bsz = 4096;
+	uint64_t fblocks = part_blocks * UFS_BLOCK / xf.bsz;
+	if (fblocks == 0 || fblocks > UINT32_MAX) {
+		return EINVAL;
+	}
+	xf.run = kalloc_data(sizeof(*xf.run), Z_WAITOK | Z_ZERO);
+	if (!xf.run) {
+		return ENOMEM;
+	}
+	xf.run[0].fblk = 0;
+	xf.run[0].len = (uint32_t)fblocks;
+	xf.run[0].pblk = 0;
+	xf.nrun = 1;
+	xf.size = fblocks * xf.bsz;
+	return 0;
+}
+
 /*
  * Partition sector of file sector lba, UINT64_MAX for a hole or an unwritten
  * extent; *n = sectors (<= count) that continue the same way.
@@ -1137,6 +1501,21 @@ wst_thread(__unused void *arg, __unused wait_result_t wr)
 		    wst.multi, wst.mfail, wst.mbad);
 		sweet_mali_status();
 #if defined(SWEET_JACKPOTLTE)
+		{
+			uint64_t ns;
+			absolutetime_to_nanoseconds(mdma.rd_abs, &ns);
+			printf("SWEET MMC: %s; read %llu MiB in %llu ms (%llu KB/s); %llu DMA transfers, %llu sectors, "
+			    "%llu failed (first: CMD%u of %u at 0x%llx rintsts 0x%x idsts 0x%x where %u r1 0x%x des0 0x%x); checked %llu, mismatched %llu; IDMAC %d-bit, %llu PIO above 4 GiB\n",
+			    mmc_dma ? "DMA" : "PIO", mdma.rd_bytes >> 20, ns / NSEC_PER_MSEC,
+			    ns ? mdma.rd_bytes * (NSEC_PER_SEC / 1000) / ns : 0, mdma.xfers, mdma.sectors, mdma.fail,
+			    mdma.write ? 25 : 18, mdma.n, mdma.lba, mdma.rint, mdma.ids, mdma.where, mdma.r1, mdma.d0,
+			    mdma.checked, mdma.mismatch, mmc_dma64 < 0 ? 0 : (mmc_dma64 ? 64 : 32), mmc_dma_above4g);
+			printf("SWEET MMC: FIFOTH 0x%08x -> 0x%08x now 0x%08x\n", mmc_fifoth0, mmc_fifoth1, ufs_rd(0x04c));
+			printf("SWEET MMC: %s\n", mmc_hs400_note);
