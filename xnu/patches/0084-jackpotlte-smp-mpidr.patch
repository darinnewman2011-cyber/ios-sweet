diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index a4e76a4..2328611 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -76,8 +76,7 @@ SweetCPU::start(IOService *provider)
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
-	/* MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76 */
-	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
+	if (!SWEET_MPIDR_VALID(cpu->phys_id) ||
 	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
 		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
@@ -85,7 +84,7 @@ SweetCPU::start(IOService *provider)
 	if (!IOCPU::start(provider)) {
 		return false;
 	}
-	cpuName = OSSymbol::withCStringNoCopy("Kryo 470");
+	cpuName = OSSymbol::withCStringNoCopy(SWEET_CPU_NAME);
 	if (cpuName == NULL) {
 		return false;
 	}
@@ -147,9 +146,10 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 		}
 		IOSleep(1);
 	}
-	/* The supplied ADT has cpu0 as the boot CPU and ascending A55 nodes. */
-	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0) {
-		panic("SWEET CPU: expected boot MPIDR 0 and logical CPU 0");
+	/* The supplied ADT lists the boot CPU first (mkadt.py: cpu0 "running"). */
+	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != SWEET_BOOT_MPIDR) {
+		panic("SWEET CPU: expected boot MPIDR 0x%x as logical CPU 0, got 0x%x as %u",
+		    SWEET_BOOT_MPIDR, topology->boot_cpu->phys_id, topology->boot_cpu->cpu_id);
 	}
 	for (unsigned int i = 0; i < topology->num_cpus; i++) {
 		SweetCPU *cpu = __atomic_load_n(&sweet_cpus[i], __ATOMIC_ACQUIRE);
@@ -242,7 +242,7 @@ SweetCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
 {
 	const ml_topology_cpu_t *cpu = &ml_get_topology_info()->cpus[getCPUNumber()];
 	/* cpu_start() passes NULL,NULL: x20/x21 are set by LowResetVectorBase. */
-	if (start_paddr != 0 || arg_paddr != 0 || cpu->phys_id == 0 ||
+	if (start_paddr != 0 || arg_paddr != 0 || cpu->phys_id == SWEET_BOOT_MPIDR ||
 	    __atomic_load_n(&initialized, __ATOMIC_ACQUIRE) != 0) {
 		panic("SWEET CPU: cpu=%u unsupported restart", getCPUNumber());
 	}
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index e163b08..7f07330 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -25,6 +25,21 @@
  */
 #define SWEET_SMP_MAX_CPUS         8
 
+#if defined(SWEET_JACKPOTLTE)
+/*
+ * Exynos 7885: A53 MPIDRs 0x100-0x103 and 0x200-0x201, A73 0x0/0x1 (Aff0 =
+ * core, Aff1 = cluster). S-Boot enters the kernel on 0x100, the ADT's cpu0.
+ */
+#define SWEET_BOOT_MPIDR          0x100
+#define SWEET_MPIDR_VALID(m)      ((m) == 0x0 || (m) == 0x1 || ((m) >= 0x100 && (m) <= 0x103) || 	                           (m) == 0x200 || (m) == 0x201)
+#define SWEET_CPU_NAME            "Exynos 7885"
+#else
+/* SM7150: MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76; boots on 0 */
+#define SWEET_BOOT_MPIDR          0x0
+#define SWEET_MPIDR_VALID(m)      ((m) <= 0x700 && ((m) & 0xff) == 0)
+#define SWEET_CPU_NAME            "Kryo 470"
+#endif
+
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__              8
 #define __ARM_VMSA__              8
