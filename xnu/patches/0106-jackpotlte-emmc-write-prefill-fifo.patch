+/* HTO (data starvation by host) only means the FIFO ran empty; the transfer resumes once it is refilled. */
+#define INT_HTO                 (1u << 10)
+#define MMC_WR_ERROR            (INT_ERROR & ~INT_HTO)
+
+/* Push the rest of the 128 words of src into the FIFO, as far as it has room. */
+static void
+mmc_fifo_fill(const uint32_t *src, uint32_t *np)
+{
+	uint32_t n = *np;
+
+	/* A 64-bit FIFO takes whole 64-bit entries (Linux dw_mmc: writeq). */
+	while (n < 128 && !(ufs_rd(MMC_STATUS) & STATUS_FIFO_FULL)) {
+		if (mmc_fifo64) {
+			*(volatile uint64_t *)(su.regs + MMC_FIFO) = ((uint64_t)src[n + 1] << 32) | src[n];
+			n += 2;
+		} else {
+			ufs_wr(MMC_FIFO, src[n++]);
+		}
+	}
+	*np = n;
+}
