diff --git a/bsd/dev/sweet_a8wlbt.c b/bsd/dev/sweet_a8wlbt.c
index d8eed73..5db0b07 100644
--- a/bsd/dev/sweet_a8wlbt.c
+++ b/bsd/dev/sweet_a8wlbt.c
@@ -407,6 +407,7 @@ static char wl_status[160];
 static char join_ssid[33];
 static volatile int join_req;
 static int vif_up, joining, connected;  /* station vif 1 added; join in progress; associated */
+static int a80211_on;                   /* boot-arg a8wifi80211=1: answer IO80211 (iokit/Kernel/arm/SweetA8WiFi.cpp) */
 static uint32_t rx_frames;
 static ifnet_t wl_ifp;
