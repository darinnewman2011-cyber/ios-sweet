-		ifmr->ifm_current = ifmr->ifm_active = IFM_ETHER | IFM_AUTO;
+		/* IO80211's interface list keeps only interfaces whose media is IEEE 802.11 */
+		ifmr->ifm_current = ifmr->ifm_active = (a80211_on ? IFM_IEEE80211 : IFM_ETHER) | IFM_AUTO;
