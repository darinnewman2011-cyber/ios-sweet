diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..3e6aeef 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -222,6 +222,137 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#elif defined(SWEET_GICV2)
+/*
+ * GIC-400 (GICv2) as the Galaxy A8 (jackpotlte) shim drives it, seen from
+ * the non-secure side: secure firmware owns Group 0, NS writes to
+ * GICD_IGROUPR are ignored and everything we enable is a Group 1 IRQ taken
+ * through sleh_irq(). The CPU interface is MMIO (GICC), not ICC_* sysregs.
+ * Verified on the phone by shim/a8 milestone 2: GICD_CTLR=1, priority 0xA0,
+ * PMR 0xF0, GICC_CTLR=1 delivers the virtual timer (INTID 27) and SGIs.
+ *
+ * ADT /arm-io/gic "reg": GICD base, size, GICC base, size (GICH/GICV may
+ * follow and are unused).
+ */
+#include <pexpert/arm/protos.h>
+
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+
+/* GICv2 SGIs target CPU interfaces, not MPIDRs: each CPU records its own. */
+static uint8_t sweet_gic_cpu_mask[MAX_CPUS];
+
+#define gicd_read32(offset) (*(volatile uint32_t *)(gicd_base + (offset)))
+#define gicd_write32(offset, data) (*(volatile uint32_t *)(gicd_base + (offset)) = (data))
+#define gicc_read32(offset) (*(volatile uint32_t *)(gicc_base + (offset)))
+#define gicc_write32(offset, data) (*(volatile uint32_t *)(gicc_base + (offset)) = (data))
+
+void
+pe_init_fiq()
+{
+	int error;
+	DTEntry entry;
+
+	// Only the boot processor parses the DT (SecureDT* is not thread-safe).
+	if (!gicd_base) {
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+
+		void const *prop;
+		unsigned int prop_size;
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC MMIO regions in DT", __func__);
+		}
+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
+		}
+
+		/* Read only on the boot CPU, before RO-late lockdown. */
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		uint64_t const *reg = (uint64_t const *)prop;
+
+		gicc_base = ml_io_map(soc_base_phys + reg[2], reg[3]);
+		if (!gicc_base) {
+			panic("%s: cannot map GICC region", __func__);
+		}
+		/* Publish gicd_base last: it is the "initialized" flag above. */
+		vm_offset_t gicd = ml_io_map(soc_base_phys + reg[0], reg[1]);
+		if (!gicd) {
+			panic("%s: cannot map GICD region", __func__);
+		}
+		gicd_base = gicd;
+
+		kprintf("SWEET GIC: GICv2 GICD 0x%llx GICC 0x%llx, virtual timer INTID %u\n",
+		    soc_base_phys + reg[0], soc_base_phys + reg[2], sweet_vtimer_intid);
+
+		gicd_write32(GICD_CTLR, GICD_CTLR_ENABLEGRP1);
+	}
+
+	/* SGI/PPI enable, priority and target registers are banked per CPU. */
+	unsigned int cpu = ml_get_cpu_number_local();
+	if (cpu >= MAX_CPUS) {
+		panic("%s: CPU number %u out of range", __func__, cpu);
+	}
+	uint8_t mask = (uint8_t)gicd_read32(GICD_ITARGETSR0);
+	if (mask == 0 || (mask & (mask - 1)) != 0) {
+		panic("%s: cpu %u has invalid GIC CPU interface mask 0x%x", __func__, cpu, mask);
+	}
+	sweet_gic_cpu_mask[cpu] = mask;
+
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ISENABLER0, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+
+	gicc_write32(GICC_PMR, 0xF0);
+	gicc_write32(GICC_BPR, 0);
+	gicc_write32(GICC_CTLR, GICC_CTLR_ENABLEGRP1);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
+
+/* sleh_irq(): returns the raw IAR value; GICv2 SGIs carry the source CPU. */
+uint32_t
+sweet_gic_ack(void)
+{
+	return gicc_read32(GICC_IAR);
+}
+
+void
+sweet_gic_eoi(uint32_t iar)
+{
+	gicc_write32(GICC_EOIR, iar);
+}
+
+void
+sweet_gic_send_sgi(unsigned int cpu, unsigned int sgi)
+{
+	uint8_t mask = cpu < MAX_CPUS ? sweet_gic_cpu_mask[cpu] : 0;
+	if (mask == 0 || sgi >= 16) {
+		panic("%s: invalid SGI %u to cpu %u (mask 0x%x)", __func__, sgi, cpu, mask);
+	}
+	/* Make prior stores visible to the target before it takes the SGI. */
+	__builtin_arm_dsb(DSB_ISHST);
+	gicd_write32(GICD_SGIR, ((uint32_t)mask << GICD_SGIR_TARGET_SHIFT) | sgi);
+}
 #else
 void
 pe_init_fiq()
