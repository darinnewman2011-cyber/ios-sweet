+/*
+ * CMD18 / CMD25: n sectors (up to MMC_MULTI_MAX) in one command, the
+ * controller sending CMD12 after the last block (SEND_STOP, as Linux dw_mmc
+ * does without CMD23). One command per sector kept the root at ~1 MB/s: every
+ * sector paid a FIFO reset, a command and, for writes, the card programming a
+ * lone sector plus CMD13 polling. On any error the transfer is stopped with
+ * CMD12 and the caller redoes the range one sector at a time.
+ */
+#define CMD_STOP_ABORT          (1u << 14)
+#define CMD_SEND_STOP           (1u << 12)
+#define INT_ACD                 (1u << 14)      /* auto CMD12 done */
+#define MMC_RESP1       0x034                   /* auto CMD12 response */
+#define MMC_MULTI_MAX   128u                    /* 64 KiB per command */
+
+static void
+mmc_abort(void)
+{
+	uint32_t resp = 0;
+
+	(void)mmc_cmd(12, 0, CMD_RESP_EXP | CMD_RESP_CRC | CMD_STOP_ABORT, &resp);
+	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) | CTRL_FIFO_RESET);
+	(void)mmc_wait(MMC_CTRL, CTRL_FIFO_RESET, 0, 10 * NSEC_PER_MSEC);
+	(void)mmc_wait(MMC_STATUS, STATUS_BUSY, 0, MMC_DATA_NS);
+}
+
+static int
+mmc_xfer_multi(uint64_t lba, uint32_t n, uint32_t *buf, bool write)
+{
+	uint32_t st, resp = 0, words = n * (UFS_BLOCK / 4), w = 0, r = 0;
+	uint64_t deadline;
+
+	if (n < 2 || n > MMC_MULTI_MAX || lba + n - 1 > UINT32_MAX) {
+		return EINVAL;
+	}
+	if (write && (lba < mmc_wr_lo || lba + n > mmc_wr_hi)) {
+		printf("SWEET MMC: refusing write of %u at 0x%llx (writable 0x%llx-0x%llx)\n", n, lba, mmc_wr_lo, mmc_wr_hi);
+		return wst_fail(EPERM, 1, lba, n, 0);
+	}
+	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) | CTRL_FIFO_RESET);
+	(void)mmc_wait(MMC_CTRL, CTRL_FIFO_RESET, 0, 10 * NSEC_PER_MSEC);
+	if (!mmc_wait(MMC_STATUS, STATUS_FCNT_MASK | STATUS_FIFO_EMPTY, STATUS_FIFO_EMPTY, 10 * NSEC_PER_MSEC)) {
+		wst.dirty += write;
+		return EIO;
+	}
+	ufs_wr(MMC_BLKSIZ, 512);
+	ufs_wr(MMC_BYTCNT, n * 512);
+	st = mmc_cmd(write ? 25 : 18, (uint32_t)lba, CMD_RESP_EXP | CMD_RESP_CRC | CMD_DAT_EXP | CMD_PRV_DAT_WAIT |
+	    CMD_SEND_STOP | (write ? CMD_READ_WRITE : 0), &resp);
+	if (st == UINT32_MAX || (st & MMC_WR_ERROR) || (resp & R1_ERRORS)) {
+		r = st;
+		goto fail;
+	}
+	nanoseconds_to_absolutetime(4 * MMC_DATA_NS, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		uint32_t s = ufs_rd(MMC_STATUS);
+		r = ufs_rd(MMC_RINTSTS);
+		if (write) {
+			mmc_fifo_fill(buf, &w, words);
+			ufs_wr(MMC_RINTSTS, INT_TXDR | INT_HTO);
+		} else {
+			for (uint32_t c = STATUS_FCNT(s); c && w < words; c--) {
+				buf[w++] = ufs_rd(MMC_FIFO);
+				if (mmc_fifo64) {
+					buf[w++] = ufs_rd(MMC_FIFO + 4);
+				}
+			}
+			/* HTO on a read: the FIFO was full and the card clock stopped until it was drained. */
+			ufs_wr(MMC_RINTSTS, INT_RXDR | INT_HTO);
+		}
+		if (r & MMC_WR_ERROR) {
+			goto fail;
+		}
+		if ((r & INT_DATA_OVER) && w >= words) {
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			goto fail;
+		}
+	}
+	if (!mmc_wait(MMC_RINTSTS, INT_ACD, INT_ACD, MMC_CMD_NS) || (ufs_rd(MMC_RESP1) & R1_ERRORS)) {
+		r = ufs_rd(MMC_RINTSTS);
+		resp = ufs_rd(MMC_RESP1);
+		goto fail;
+	}
+	return write ? mmc_wait_tran(lba) : 0;
+fail:
+	if (!wst.mfail++) {
+		printf("SWEET MMC: CMD%u of %u at 0x%llx failed: rintsts 0x%x r1 0x%x, %u words; retrying per sector\n",
+		    write ? 25 : 18, n, lba, r, resp, w);
+	}
+	mmc_abort();
+	return EIO;
+}
