@@ -366,10 +366,12 @@ static uint64_t mmc_wr_lo, mmc_wr_hi;           /* writable sectors [lo, hi): US
  * Write statistics, printed every 30 s by wst_thread() so the first failure
  * stays inside the last 16 KB that ramoops keeps. where: 1 outside USERDATA,
  * 2 CMD24, 3 data error, 4 data timeout, 5 busy, 6 card status, 7 not back in
- * TRAN, 8 no extent, 9 beyond the file, 10 strategy bounds. a/b: rintsts, r1.
+ * TRAN, 8 no extent, 9 beyond the file, 10 strategy bounds, 11 verify kept
+ * failing. a/b: rintsts, r1.
  */
 static struct {
 	uint64_t ok, fail, lba;
+	uint64_t wbad, rbad, zero, bad_lba;     /* write verification, see file_write_verified() */
 	uint32_t where, a, b;
