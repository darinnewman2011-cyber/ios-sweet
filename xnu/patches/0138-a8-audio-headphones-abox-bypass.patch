+/* xnu 0138: any SPEEDY device behind ACPM (type = its 4-bit address: codec 3, codec's analog part 7, PMIC 1) */
+int sweet_a8_acpm_mfd(unsigned type, uint8_t reg, int write, uint8_t *val);
+int
+sweet_a8_acpm_mfd(unsigned type, uint8_t reg, int write, uint8_t *val)
+{
+	uint32_t cmd[16] = { ((type & 0xfu) << 8) | reg, write ? (1u | ((uint32_t)*val << 8)) : 0u };
+	int e;
+
+	if (acpm_init()) {
+		return ENXIO;
+	}
+	e = acpm_send(CH_MFD, cmd);
+	if (e) {
+		return e;
+	}
+	if (!write) {
+		*val = (uint8_t)(cmd[1] >> 8);
+	}
+	return (cmd[1] >> 24) & 0xff ? EIO : 0;
+}
 #endif /* SWEET_JACKPOTLTE */
diff --git a/bsd/dev/sweet_a8audio.c b/bsd/dev/sweet_a8audio.c
