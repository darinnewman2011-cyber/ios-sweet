--- /dev/null
+++ b/bsd/dev/sweet_a8audio.c
@@ -0,0 +1,1221 @@
+/* Copyright (c) 2026 Darin. MIT License (see LICENSE); keep this notice. Written by Claude (Anthropic) for the ios-sweet Galaxy A8 port. */
+/*
+ * Galaxy A8 (2018, jackpotlte) audio, headphones first: ABOX (the Exynos 7885's audio block) driven from the AP with
+ * its own CPU off, no firmware ("bypass", the way Scion drives the S9's ABOX: github.com/Scion-Project/scion-kernel,
+ * drivers/audio/abox/hakios.exynos_abox.c, APSL-2.0, read for the method; nothing copied):
+ *
+ *   RDMA0 (a ring in memory) -> SPUS chain 0, no ASRC -> SIFS1 -> UAIF0 (I2S master, 48 kHz, 2 x 16 bits)
+ *        -> COD3035 codec (I2S slave) -> its headphone amplifier
+ *
+ * Facts (Samsung's SM-A530F kernel, GPL-2.0, read for facts only: sound/soc/samsung/abox/abox.[ch],
+ * sound/soc/codecs/cod3035x.[ch], drivers/base/regmap/regmap-i2c.c, cal-if/exynos7885/cmucal-{sfr,node}.c,
+ * pinctrl-exynos.c; vendor/etc/mixer_paths.xml; the live device tree):
+ *   - The codec is reached through ACPM, never directly: regmap "speedy" turns every register access into
+ *     exynos_acpm_{read,write}_reg(i2c address, reg). Main part = type 3, the analog/DNC part ("cod3035a") = type 7.
+ *     Its supply (LDO36) is always on.
+ *   - ABOX SFR 0x14A50000: SYSPOWER_CTRL 0x10, QCHANNEL_DISABLE 0x38, ROUTE_CTRL0 0x40 ([3:0] = UAIF0's source:
+ *     1 SIFS0, 2 SIFS1), SPUS_CTRL0 0x200 (chain n at 4n: bit 3 IN (0 RDMA), bits 2:1 OUT (0 SIFS1, 1 SIFS0,
+ *     2 SIFS2), bit 0 ASRC), SPUS_CTRL1 0x204 ([18:16] SIFS1's SPUS OUT), UAIF n at 0x500 + 0x10n (CTRL0: bit 0
+ *     SPK_ENABLE, 1 MIC_ENABLE, 2 MODE master; CTRL1: 28:24 FORMAT ((ch - 1) | 1 << 3 for 16 bit), 23 BCLK
+ *     polarity, 22 WS mode (0 I2S), 20:18 SLOT_MAX, 17:12 SBIT_MAX), RDMA n at 0x1000 + 0x100n (CTRL0 bit 0 ENABLE,
+ *     BUF_STR 0x08, BUF_END 0x0C, BUF_OFFSET 0x10 (period), STR_POINT 0x14, VOL_FACTOR 0x18, STATUS 0x30:
+ *     31 progress, 28:16 RBUF_OFFSET, 12:0 RBUF_CNT). The codec's MCLK is UAIF2 with only MIC_ENABLE set
+ *     (abox_enable_mclk: UAIF2 CTRL0 = 2).
+ *   - CMU_DISPAUD 0x14800000 (also the display's: only the audio entries below are touched): PLL_AUD CON0 0x160
+ *     (31 ENABLE, 29 STABLE, 25:16 M, 13:8 P, 2:0 S), CON3 0x16C (15:0 K), 1179.648 MHz = M 45 P 1 S 0 K 24319 from
+ *     26 MHz; DIV_AUDIF 0x1800 (24.576 MHz = /48), DIV_UAIF0 0x181C (1.536 MHz = 32 fs = /16), DIV_UAIF2 0x1820,
+ *     MUX_UAIF0 0x100C (0 = the divider); gates (bit 21 CG_VAL, bit 20 MANUAL): ABOX ACLK 0x200C, BCLK_UAIF0 0x2014,
+ *     BCLK_UAIF2 0x2018, RSTNSYNC UAIF0 0x20BC, UAIF2 0x20C0. pd-dispaud is on while the panel is.
+ *   - Pins: pinctrl 0x148F0000, gpb0 (CON 0x0, 4 bits a pin; PUD 0x8): gpb0-0 MCLK, gpb0-1..4 UAIF0, function 2.
+ *   - ABOX SysMMU 0x14A30000: CTRL 0x0, bit 2 = translating.
+ *   - abox_rmem 0xE9400000 (4 MB, below 4 GB, outside XNU's RAM): the ring.
+ *   - Codec: cod3035x_codec_initialize(), cod3035x_dai_set_fmt() (I2S, 16 bit, BCLK 32 fs), playback_hw_params() ->
+ *     cod3035x_lassenA_normal(), DAPM DAC (0x40 PDB_DACDIG bit 5, RSTB_DAT_DA bit 4), HP On (0x77 bit 4),
+ *     hpdrv_ev: cod3035x_hp_playback_init() then post_hpdrv_normal(); mute = DVOL 0x51/0x52 = 0xFF.
+ *
+ * Boot-arg a8audio=N runs the first N steps once (from the storage status thread, 30 s after boot):
+ *   1 look     ABOX/CMU/pins/SysMMU registers and the codec's first registers (both types), read only
+ *   2 clocks   PLL_AUD, AUDIF, UAIF0 (and UAIF2 for MCLK), the gates
+ *   3 pins     gpb0-0..4 to function 2; MCLK on (UAIF2 CTRL0 = 2)
+ *   4 codec    initialisation, I2S slave format, 48 kHz mode, DAC and headphone driver on, muted
+ *   5 UAIF0    route SPUS 0 -> SIFS1 -> UAIF0, UAIF0 master 2 x 16 bits on, SYSPOWER on, SysMMU passing
+ *   6 tone     RDMA0 on a ring of 1 kHz at -20 dBFS for a8audiosecs (default 3, 1..10), unmuted at a low headphone
+ *              volume; RDMA0's STATUS sampled; then muted and stopped
+ * a8audiovol=N  headphone digital volume register (0x51/0x52) for the tone (default 0x6C, quieter than Samsung's
+ *               0x54; larger = quieter).
+ */
+#if defined(SWEET_JACKPOTLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <mach/vm_statistics.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void delay(int usec);
+int sweet_a8_acpm_mfd(unsigned type, uint8_t reg, int write, uint8_t *val);  /* sweet_a8acpm.c (xnu 0138) */
+void sweet_a8_audio_run(void);
+
+#define ABOX_PA         0x14a50000u
+#define CMU_PA          0x14800000u
+#define GPIO_PA         0x148f0000u
+#define MMU_PA          0x14a30000u
+#define RMEM_PA         ring_pa         /* run 74: abox_rmem 0xe9400000 never read; default now the framebuffer region's tail */
+static uint32_t ring_pa = 0xed3f0000u;   /* fb_handover 0xEC000000 + 20 MB - 64 KB: plain DRAM the display DMA reads; a8ringpa= */
+
+#define SYSPOWER        0x10u
+#define QCH_DISABLE     0x38u
+#define ROUTE0          0x40u
+#define SPUS0           0x200u
+#define SPUS1           0x204u
+#define UAIF(n, r)      (0x500u + 0x10u * (n) + (r))
+#define RDMA0(r)        (0x1000u + (r))
+#define R_CTRL0         0x00u
+#define R_BUF_STR       0x08u
+#define R_BUF_END       0x0cu
+#define R_BUF_OFFSET    0x10u
+#define R_STR_POINT     0x14u
+#define R_VOL           0x18u
+#define R_STATUS        0x30u
+
+#define PLL_CON0        0x160u
+#define PLL_CON3        0x16cu
+#define DIV_AUDIF       0x1800u
+#define DIV_UAIF0       0x181cu
+#define DIV_UAIF2       0x1820u
+#define MUX_UAIF0       0x100cu
+#define GATE_ACLK       0x200cu
+#define GATE_BCLK0      0x2014u
+#define GATE_BCLK2      0x2018u
+#define GATE_RST0       0x20bcu
+#define GATE_RST2       0x20c0u
+#define GATE_ON         ((1u << 21) | (1u << 20))
+
+#define MAIN            3u      /* codec types on ACPM */
+#define ANALOG          7u
+
+#define RATE            48000u
+#define PERIOD          480u    /* frames: 10 ms */
+#define PERIODS         10u     /* the ring holds exactly 100 cycles of 1 kHz */
+#define RING_BYTES      (PERIOD * PERIODS * 4u)
+
+static vm_offset_t abox, cmu, gpio, mmu, ring;
+
+static inline uint32_t rd(vm_offset_t b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static uint32_t
+wr(vm_offset_t b, const char *name, uint32_t o, uint32_t v)
+{
+	uint32_t was = rd(b, o), now;
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	now = rd(b, o);
+	printf("SWEET AUDIO: %s %#x -> %#x (reads %#x)\n", name, was, v, now);
+	return now;
+}
+static uint32_t
+wr_bits(vm_offset_t b, const char *name, uint32_t o, uint32_t mask, uint32_t v)
+{
+	return wr(b, name, o, (rd(b, o) & ~mask) | (v & mask));
+}
+
+static int cerr;                /* first codec access error of the run */
+static uint8_t
+c_rd(unsigned type, uint8_t reg)
+{
+	uint8_t v = 0;
+	int e = sweet_a8_acpm_mfd(type, reg, 0, &v);
+	if (e && !cerr) {
+		cerr = e;
+		printf("SWEET AUDIO: codec type %u read %#x failed (%d)\n", type, reg, e);
+	}
+	return v;
+}
+static void
+c_wr(unsigned type, uint8_t reg, uint8_t v)
+{
+	uint8_t val = v;
+	int e = sweet_a8_acpm_mfd(type, reg, 1, &val);
+	if (e && !cerr) {
+		cerr = e;
+		printf("SWEET AUDIO: codec type %u write %#x = %#x failed (%d)\n", type, reg, v, e);
+	}
+}
+static void
+c_bits(uint8_t reg, uint8_t mask, uint8_t v)
+{
+	c_wr(MAIN, reg, (uint8_t)((c_rd(MAIN, reg) & ~mask) | (v & mask)));
+}
+
+static void
+codec_dump(unsigned type, uint8_t first)
+{
+	char line[100];
+	int n = 0;
+	for (unsigned r = first; r < first + 16u; r++) {
+		uint8_t v = 0;
+		int e = sweet_a8_acpm_mfd(type, (uint8_t)r, 0, &v);
+		n += snprintf(line + n, sizeof(line) - n, e ? " ??" : " %02x", v);
+	}
+	printf("SWEET AUDIO: codec type %u %#04x..:%s\n", type, first, line);
+}
+
+static void
+step_look(void)
+{
+	printf("SWEET AUDIO: 1 look: ABOX IP_INDEX %#x VERSION %#x SYSPOWER %#x/%#x QCH_DISABLE %#x ROUTE0 %#x SPUS0 %#x SPUS1 %#x\n",
+	    rd(abox, 0x0), rd(abox, 0x4), rd(abox, SYSPOWER), rd(abox, 0x14), rd(abox, QCH_DISABLE), rd(abox, ROUTE0),
+	    rd(abox, SPUS0), rd(abox, SPUS1));
+	printf("SWEET AUDIO: 1 look: UAIF0 %#x %#x st %#x, UAIF2 %#x %#x, RDMA0 ctrl %#x buf %#x..%#x status %#x vol %#x\n",
+	    rd(abox, UAIF(0, 0)), rd(abox, UAIF(0, 4)), rd(abox, UAIF(0, 0xc)), rd(abox, UAIF(2, 0)), rd(abox, UAIF(2, 4)),
+	    rd(abox, RDMA0(R_CTRL0)), rd(abox, RDMA0(R_BUF_STR)), rd(abox, RDMA0(R_BUF_END)), rd(abox, RDMA0(R_STATUS)),
+	    rd(abox, RDMA0(R_VOL)));
+	printf("SWEET AUDIO: 1 look: PLL_AUD %#x K %#x, DIV AUDIF %#x UAIF0 %#x UAIF2 %#x, MUX UAIF0 %#x, gates ACLK %#x BCLK0 %#x "
+	    "BCLK2 %#x RST0 %#x RST2 %#x\n", rd(cmu, PLL_CON0), rd(cmu, PLL_CON3), rd(cmu, DIV_AUDIF), rd(cmu, DIV_UAIF0),
+	    rd(cmu, DIV_UAIF2), rd(cmu, MUX_UAIF0), rd(cmu, GATE_ACLK), rd(cmu, GATE_BCLK0), rd(cmu, GATE_BCLK2),
+	    rd(cmu, GATE_RST0), rd(cmu, GATE_RST2));
+	printf("SWEET AUDIO: 1 look: gpb0 con %#x dat %#x pud %#x; SysMMU ctrl %#x\n", rd(gpio, 0x0), rd(gpio, 0x4), rd(gpio, 0x8),
+	    rd(mmu, 0x0));
+	printf("SWEET AUDIO: 1 look: SPUS sample banks 0x220..: %#x %#x %#x %#x %#x %#x %#x %#x\n", rd(abox, 0x220), rd(abox, 0x224),
+	    rd(abox, 0x228), rd(abox, 0x22c), rd(abox, 0x230), rd(abox, 0x234), rd(abox, 0x238), rd(abox, 0x23c));
+	codec_dump(MAIN, 0x00);
+	codec_dump(MAIN, 0x40);
+	codec_dump(ANALOG, 0x40);
+}
+
+static bool
+step_clocks(void)
+{
+	uint32_t c0 = rd(cmu, PLL_CON0);
+	bool right = (c0 & (1u << 31)) && (c0 & (1u << 29)) && ((c0 >> 16) & 0x3ff) == 45 && ((c0 >> 8) & 0x3f) == 1 &&
+	    (c0 & 7) == 0 && (rd(cmu, PLL_CON3) & 0xffff) == 24319;
+
+	printf("SWEET AUDIO: 2 clocks: PLL_AUD %s\n", right ? "already at 1179.648 MHz" : "to 1179.648 MHz");
+	if (!right) {
+		(void)wr_bits(cmu, "PLL_AUD CON0 (off)", PLL_CON0, 1u << 31, 0);
+		(void)wr_bits(cmu, "PLL_AUD CON3 (K 24319)", PLL_CON3, 0xffff, 24319);
+		(void)wr_bits(cmu, "PLL_AUD CON0 (M 45 P 1 S 0)", PLL_CON0, (0x3ffu << 16) | (0x3fu << 8) | 7u, (45u << 16) | (1u << 8));
+		(void)wr_bits(cmu, "PLL_AUD CON0 (on)", PLL_CON0, 1u << 31, 1u << 31);
+		for (int i = 0; i < 100 && !(rd(cmu, PLL_CON0) & (1u << 29)); i++) {
+			delay(100);
+		}
+		if (!(rd(cmu, PLL_CON0) & (1u << 29))) {
+			printf("SWEET AUDIO: 2 clocks: PLL_AUD did not lock (%#x)\n", rd(cmu, PLL_CON0));
+			return false;
+		}
+	}
+	(void)wr_bits(cmu, "DIV_AUDIF (/48: 24.576 MHz)", DIV_AUDIF, 0x1ff, 47);
+	(void)wr_bits(cmu, "DIV_UAIF0 (/16: 1.536 MHz)", DIV_UAIF0, 0x1f, 15);
+	(void)wr_bits(cmu, "MUX_UAIF0 (the divider)", MUX_UAIF0, 1, 0);
+	(void)wr_bits(cmu, "gate ABOX ACLK", GATE_ACLK, GATE_ON, GATE_ON);
+	(void)wr_bits(cmu, "gate BCLK_UAIF0", GATE_BCLK0, GATE_ON, GATE_ON);
+	(void)wr_bits(cmu, "gate BCLK_UAIF2", GATE_BCLK2, GATE_ON, GATE_ON);
+	(void)wr_bits(cmu, "gate RSTNSYNC UAIF0", GATE_RST0, GATE_ON, GATE_ON);
+	(void)wr_bits(cmu, "gate RSTNSYNC UAIF2", GATE_RST2, GATE_ON, GATE_ON);
+	printf("SWEET AUDIO: 2 clocks: DIV_UAIF2 (the codec's MCLK) left at %#x\n", rd(cmu, DIV_UAIF2));
+	/*
+	 * Q-channels (as Scion's S9 driver asks them on, as clk_enable() does): CLOCK_REQ (bit 1) unless the hardware
+	 * gates the clock itself (ENABLE, bit 0). CMU_DISPAUD: DMYQCH ABOX 0x3000, DMYQCH CPU 0x3004 (ABOX's CPU clock,
+	 * which Samsung's abox_enable() turns on even before firmware), QCH BUS 0x300C, UAIF0 0x3010, UAIF2 0x3014.
+	 */
+	static const struct { uint32_t off; const char *name; } qch[] = {
+		{ 0x3000, "QCH ABOX (dummy)" }, { 0x3004, "QCH CPU (dummy)" }, { 0x300c, "QCH BUS" },
+		{ 0x3010, "QCH UAIF0" }, { 0x3014, "QCH UAIF2" },
+	};
+	for (unsigned i = 0; i < sizeof(qch) / sizeof(qch[0]); i++) {
+		uint32_t v = rd(cmu, qch[i].off);
+		if (!(v & 1) && !(v & 2)) {
+			(void)wr_bits(cmu, qch[i].name, qch[i].off, 2, 2);
+		} else {
+			printf("SWEET AUDIO: 2 clocks: %s = %#x, left\n", qch[i].name, v);
+		}
+	}
+	/*
+	 * Run 72: RDMA0 never read memory with any format. Its way to DRAM: ABOX's ASB/SysMMU/PPMU, LHS_AXI_D_ABOX
+	 * (CMU_DISPAUD) and LHM_AXI_D_ABOX (CMU_CORE 0x12000000). Their gates held on (CG_VAL|MANUAL) and their
+	 * Q-channels forced on (ENABLE 0, CLOCK_REQ 1). Offsets: Samsung cmucal-sfr.c for the 7885 (facts only).
+	 */
+	static const struct { uint32_t off; const char *name; } path_gate[] = {
+		{ 0x2020, "gate ABOX CCLK_ASB" }, { 0x2024, "gate ABOX CCLK_CA7" }, { 0x2088, "gate LHS_AXI_D_ABOX" },
+		{ 0x209c, "gate PPMU_ABOX ACLK" }, { 0x20d0, "gate SMMU_ABOX" },
+	};
+	static const struct { uint32_t off; const char *name; } path_qch[] = {
+		{ 0x3034, "QCH LHS_AXI_D_ABOX" }, { 0x303c, "QCH PPMU_ABOX" }, { 0x3044, "QCH SMMU_ABOX" },
+	};
+	for (unsigned i = 0; i < sizeof(path_gate) / sizeof(path_gate[0]); i++) {
+		(void)wr_bits(cmu, path_gate[i].name, path_gate[i].off, GATE_ON, GATE_ON);
+	}
+	for (unsigned i = 0; i < sizeof(path_qch) / sizeof(path_qch[0]); i++) {
+		(void)wr_bits(cmu, path_qch[i].name, path_qch[i].off, 3, 2);
+	}
+	vm_offset_t core = ml_io_map(0x12000000u, 0x4000);
+	if (core) {
+		(void)wr_bits(core, "CMU_CORE gate LHM_AXI_D_ABOX", 0x2070, GATE_ON, GATE_ON);
+		(void)wr_bits(core, "CMU_CORE QCH LHM_AXI_D_ABOX", 0x3034, 3, 2);
+	}
+	return true;
+}
+
+static bool
+step_pins(void)
+{
+	(void)wr_bits(gpio, "gpb0 CON (0..4 function 2)", 0x0, 0xfffff, 0x22222);
+	(void)wr_bits(gpio, "gpb0 PUD (0..4 none)", 0x8, 0xfffff, 0);
+	(void)wr(abox, "UAIF2 CTRL0 (MCLK out)", UAIF(2, 0), 0x2);
+	return (rd(gpio, 0x0) & 0xfffff) == 0x22222;
+}
+
+static bool
+step_codec(void)
+{
+	static const uint8_t init[][2] = {
+		/* cod3035x_codec_initialize(), dis_ovp_det_mode off, no DTV antenna */
+		{ 0x05, 0x00 }, { 0x06, 0x00 }, { 0x07, 0x53 }, { 0x08, 0x53 }, { 0x3d, 0xd7 }, { 0x84, 0xbe },
+		{ 0xa6, 0x42 }, { 0x93, 0x00 }, { 0x94, 0x00 }, { 0x8e, 0xc0 }, { 0x8f, 0xc0 }, { 0x9a, 0x01 },
+		{ 0x44, 0xff }, { 0xb0, 0xa0 }, { 0xb4, 0x01 }, { 0xb5, 0xfc }, { 0xb6, 0xff }, { 0xb7, 0xb7 },
+		{ 0xb8, 0x55 }, { 0xba, 0x02 }, { 0xbb, 0x66 }, { 0xbe, 0x60 }, { 0x54, 0x8f }, { 0x55, 0x78 },
+		{ 0x57, 0x00 }, { 0xe1, 0xf1 }, { 0xe3, 0x00 }, { 0xe5, 0x00 }, { 0xe7, 0x00 }, { 0xe8, 0x00 },
+		{ 0xe9, 0x00 }, { 0xea, 0x01 }, { 0xf2, 0x03 }, { 0xf3, 0x1f }, { 0xf4, 0x55 }, { 0x5a, 0x44 },
+		{ 0xf5, 0x1a }, { 0xf6, 0xc6 }, { 0x1b, 0x01 },
+	};
+	cerr = 0;
+	printf("SWEET AUDIO: 4 codec: initialisation (%u registers)\n", (unsigned)(sizeof(init) / sizeof(init[0])));
+	for (unsigned i = 0; i < sizeof(init) / sizeof(init[0]); i++) {
+		c_wr(MAIN, init[i][0], init[i][1]);
+	}
+	c_wr(MAIN, 0x80, 0x02);                 /* PDB_ACC1, 100 ms, then 3 */
+	delay(100000);
+	c_wr(MAIN, 0x80, 0x03);
+	c_bits(0x81, 0x08, 0x08);               /* T_PDB_IMP */
+	c_wr(MAIN, 0x30, 0x0a);                 /* HP analog volume, Samsung's default */
+	c_wr(MAIN, 0x31, 0x0a);
+	c_wr(MAIN, 0x51, 0xff);                 /* DAC muted */
+	c_wr(MAIN, 0x52, 0xff);
+	c_wr(MAIN, 0x10, 0x10);                 /* PD_REF */
+	/* cod3035x_dai_set_fmt: I2S, 16 bits, BCLK 32 fs */
+	c_wr(MAIN, 0x41, 0x00);
+	c_wr(MAIN, 0x42, 0x10);
+	c_wr(MAIN, 0x43, 0x20);
+	/* cod3035x_lassenA_normal (48 kHz) */
+	c_wr(MAIN, 0xf2, 0x03);
+	c_wr(MAIN, 0xf3, 0x1f);
+	c_wr(MAIN, 0xf5, 0x1a);
+	c_wr(MAIN, 0xf6, 0xc7);
+	c_wr(MAIN, 0x58, 0x81);
+	c_bits(0x50, 0x08, 0x00);               /* DAC1_INGN_MODE off */
+	c_bits(0x53, 0x01, 0x00);               /* UHQA off */
+	c_wr(MAIN, 0x7a, 0x2f);
+	c_wr(MAIN, 0x7b, 0x80);
+	delay(100);
+	c_wr(ANALOG, 0x50, 0x1a);
+	c_wr(ANALOG, 0x51, 0x68);
+	delay(200);
+	c_wr(ANALOG, 0x41, 0x01);
+	c_wr(ANALOG, 0x42, 0xda);
+	c_wr(ANALOG, 0x43, 0x32);
+	c_wr(ANALOG, 0x44, 0x32);
+	c_wr(ANALOG, 0x4a, 0xfe);
+	c_wr(ANALOG, 0x4b, 0x85);
+	c_wr(ANALOG, 0x4c, 0x00);
+	c_wr(ANALOG, 0x4d, 0x83);
+	c_wr(ANALOG, 0x4e, 0x10);
+	delay(100);
+	c_wr(MAIN, 0xbb, 0x33);
+	c_wr(MAIN, 0x7d, 0x8b);
+	delay(1000);
+	/* DAC (dac_ev PRE_PMU): digital power on, reset pulse */
+	c_bits(0x40, 0x20, 0x20);
+	c_bits(0x40, 0x10, 0x00);
+	c_bits(0x40, 0x10, 0x10);
+	/* HP On, then hpdrv_ev: hp_playback_init, post_hpdrv_normal (DAC stays muted until the tone) */
+	c_bits(0x77, 0x10, 0x10);
+	c_bits(0x45, 0x10, 0x10);
+	c_wr(MAIN, 0x73, 0x20);
+	c_wr(MAIN, 0x74, 0x89);
+	delay(100);
+	c_wr(MAIN, 0x33, 0x00);
+	c_wr(MAIN, 0xbb, 0x33);
+	c_bits(0x37, 0x84, 0x84);               /* EN_HP_MIXL_DCTL | EN_HP_MIXR_DCTR */
+	c_bits(0x18, 0x12, 0x12);               /* PW_AUTO_DA | APW_HP */
+	delay(135000);
+	c_bits(0x3e, 0xd0, (2u << 6) | 0x10);   /* LOCK_UP_TIME 1.5, OVP_APON */
+	printf("SWEET AUDIO: 4 codec: done, %s; 0x18 %#x 0x37 %#x 0x40 %#x 0x77 %#x\n", cerr ? "with errors" : "no errors",
+	    c_rd(MAIN, 0x18), c_rd(MAIN, 0x37), c_rd(MAIN, 0x40), c_rd(MAIN, 0x77));
+	return cerr == 0;
+}
+
+static bool
+step_uaif(void)
+{
+	uint32_t m = rd(mmu, 0x0);
+	if (m & 4) {
+		(void)wr(mmu, "SysMMU CTRL (translating: off, addresses physical)", 0x0, 0);
+	}
+	(void)wr_bits(abox, "SYSPOWER_CTRL (on)", SYSPOWER, 1, 1);
+	(void)wr_bits(abox, "DYN_CLOCK_OFF (all of ABOX's internal clocks held on)", 0x34, 0x7fffffffu, 0x7fffffffu);
+	/* ABOX never gates its bus clock or UAIF0's BCLK while it plays (Scion: ACLK and BCLK_UAIF1 = bit 3; so
+	 * BCLK_UAIF0 = bit 2 and ACLK = bit 0 here, INFERRED from the S9's layout) */
+	(void)wr_bits(abox, "QCHANNEL_DISABLE (ACLK, BCLK_UAIF0; inferred bits)", QCH_DISABLE, 0x5, 0x5);
+	(void)wr_bits(abox, "SPUS_CTRL0 (chain 0: RDMA, SIFS1, no ASRC)", SPUS0, 0xf, 0x0);
+	/*
+	 * (run 59) RDMA0 said "in progress" but never read a byte: without calliope, nobody gives it a sample bank.
+	 * Scion's S9 driver gives RDMA0 512 bytes (SPUS_SBANK_RDMA0 at +0x220, SIFS SIZE [29:20] in 16-byte units),
+	 * Samsung's S10 value; ABOX here is the same generation (the same register map otherwise).
+	 */
+	if (((rd(abox, 0x220) >> 20) & 0x3ff) == 0) {
+		(void)wr_bits(abox, "SPUS_SBANK_RDMA0 (512 bytes)", 0x220, 0x3ffu << 20, (512u / 16u) << 20);
+	}
+	(void)wr_bits(abox, "SPUS_CTRL1 (SIFS1 from SPUS OUT0)", SPUS1, 7u << 16, 0);
+	/*
+	 * Run 73: RDMA0 still read nothing with ABOX's memory path clocked. SIFS's output counters (CTRL_SIFS_CNT0/1,
+	 * +0x280/+0x284, two 16-bit fields each before ABOX 2.0) pace how often a SIFS takes a sample; at 0 nothing pulls
+	 * from SPUS and so from RDMA. Samsung's abox.h: CNT_VAL = 2 * ACLK / rate - 7. ACLK = PLL_AUD / (DIV_AUD_BUS + 1)
+	 * (CMU_DISPAUD 0x1804). Every field gets it (only SIFS1 is used here).
+	 */
+	{
+		uint32_t div = (rd(cmu, 0x1804) & 0xf) + 1, aclk = 1179648000u / div, cnt = 2u * (aclk / RATE) - 7u;
+		printf("SWEET AUDIO: SIFS counts read %#x %#x; ACLK %u Hz (DIV_AUD_BUS %u), CNT_VAL %u\n",
+		    rd(abox, 0x280), rd(abox, 0x284), aclk, div - 1, cnt);
+		if (cnt > 7 && cnt <= 0xffff) {
+			(void)wr(abox, "CTRL_SIFS_CNT0", 0x280, cnt << 16 | cnt);
+			(void)wr(abox, "CTRL_SIFS_CNT1", 0x284, cnt << 16 | cnt);
+		}
+	}
+	(void)wr_bits(abox, "ROUTE_CTRL0 (UAIF0 from SIFS1)", ROUTE0, 0xf, 2);
+	(void)wr(abox, "UAIF0 CTRL1 (2 x 16 bit I2S)", UAIF(0, 4), (0x9u << 24) | (1u << 23) | (1u << 18) | (15u << 12));
+	(void)wr(abox, "UAIF0 CTRL0 (master, data mode, FIFO diff 1)", UAIF(0, 0), (1u << 24) | (1u << 4) | (1u << 2));
+	(void)wr_bits(abox, "UAIF0 CTRL0 (SPK_ENABLE)", UAIF(0, 0), 1, 1);
+	delay(20000);
+	uint32_t hi = 0, lo = 0x1f;
+	for (int i = 0; i < 64; i++) {          /* gpb0-1..4 toggle if UAIF0 drives BCLK/LRCK */
+		uint32_t d = rd(gpio, 0x4);
+		hi |= d;
+		lo &= d;
+	}
+	printf("SWEET AUDIO: 5 UAIF0: status %#x; gpb0 pins ever high %#x, always high %#x (toggling %#x)\n",
+	    rd(abox, UAIF(0, 0xc)), hi, lo, hi & ~lo);
+	return (rd(abox, ROUTE0) & 0xf) == 2 && (rd(abox, UAIF(0, 0)) & 1);
+}
+
+/*
+ * Run 71: RDMA0 enabled reads nothing (STATUS 0x80000000 throughout). Scion's S9 driver also writes, before ENABLE,
+ * SBANK_LIMIT (+0x20, 128-byte units, field position not known here) and CTRL0's FORMAT (16-bit stereo, code 9 as
+ * in UAIF CTRL1 [28:24]) with BUF_UPDATE (position not known). Try each candidate with the DAC muted, 25 ms each,
+ * and keep the first that makes the read offset or count move. a8rdmaprobe=0 skips.
+ */
+static uint32_t probe_limit, probe_ctrl0;
+
+static int
+rdma_try(uint32_t limit, uint32_t bits)
+{
+	uint32_t base = rd(abox, RDMA0(R_CTRL0)) & ~1u, st;
+
+	*(volatile uint32_t *)(abox + RDMA0(0x20)) = limit;
+	*(volatile uint32_t *)(abox + RDMA0(R_STR_POINT)) = RMEM_PA;
+	*(volatile uint32_t *)(abox + RDMA0(R_CTRL0)) = base | bits;
+	*(volatile uint32_t *)(abox + RDMA0(R_CTRL0)) = base | bits | 1u;
+	delay(25000);
+	st = rd(abox, RDMA0(R_STATUS));
+	*(volatile uint32_t *)(abox + RDMA0(R_CTRL0)) = base | bits;
+	delay(2000);
+	*(volatile uint32_t *)(abox + RDMA0(R_CTRL0)) = base;
+	if (st & 0x1fff1fffu) {
+		printf("SWEET AUDIO: 6 probe: RDMA0 moves with SBANK_LIMIT %#x, CTRL0 bits %#x (status %#x)\n", limit, bits, st);
+		return 1;
+	}
+	return 0;
+}
+
+static int
+rdma_probe(void)
+{
+	static const uint32_t limits[6] = { 0, 4, 4u << 8, 4u << 16, 4u << 24, 0x7f };
+	unsigned on = 0, tries = 0;   /* run 74: never found anything; a8rdmaprobe=1 */
+
+	(void)PE_parse_boot_argn("a8rdmaprobe", &on, sizeof(on));
+	if (!on) {
+		return 0;
+	}
+	printf("SWEET AUDIO: 6 probe: SBANK_LIMIT reads %#x, CTRL0 %#x, CTRL1 %#x\n",
+	    rd(abox, RDMA0(0x20)), rd(abox, RDMA0(R_CTRL0)), rd(abox, RDMA0(0x04)));
+	for (unsigned l = 0; l < 6; l++) {
+		for (unsigned b = 0; b < 32; b++) {     /* b 0: no extra bit; else one bit (not ENABLE or BURST_LEN) */
+			uint32_t bits = b == 0 ? 0 : (1u << b);
+			if (b >= 19 && b <= 22) {
+				continue;
+			}
+			tries++;
+			if (rdma_try(limits[l], bits)) {
+				probe_limit = limits[l]; probe_ctrl0 = bits;
+				return 1;
+			}
+		}
+		for (unsigned sh = 1; sh <= 27; sh++) {         /* FORMAT 9 (16-bit stereo) at each place clear of BURST_LEN */
+			if (sh + 4 >= 19 && sh <= 22) {
+				continue;
+			}
+			tries++;
+			if (rdma_try(limits[l], 9u << sh)) {
+				probe_limit = limits[l]; probe_ctrl0 = 9u << sh;
+				return 1;
+			}
+		}
+	}
+	*(volatile uint32_t *)(abox + RDMA0(0x20)) = 0;
+	printf("SWEET AUDIO: 6 probe: nothing moved RDMA0 in %u tries\n", tries);
+	return 0;
+}
+
+static void
+step_tone(void)
+{
+	static const int16_t quarter[13] = { 0, 428, 848, 1254, 1638, 1995, 2317, 2600, 2838, 3028, 3165, 3249, 3277 };
+	unsigned secs = 3, vol = 0x6c;
+	volatile int16_t *s;
+
+	(void)PE_parse_boot_argn("a8audiosecs", &secs, sizeof(secs));
+	(void)PE_parse_boot_argn("a8audiovol", &vol, sizeof(vol));
+	(void)PE_parse_boot_argn("a8ringpa", &ring_pa, sizeof(ring_pa));
+	printf("SWEET AUDIO: 6 tone: ring at %#x (%u bytes)\n", ring_pa, (unsigned)RING_BYTES);
+	secs = secs < 1 ? 1 : secs > 10 ? 10 : secs;
+	vol = vol < 0x30 ? 0x30 : vol > 0xff ? 0xff : vol;      /* never louder than 0x30 */
+	if (ring == 0) {
+		ring = ml_io_map(RMEM_PA, RING_BYTES);
+	}
+	if (ring == 0) {
+		printf("SWEET AUDIO: 6 tone: abox_rmem not mapped\n");
+		return;
+	}
+	s = (volatile int16_t *)ring;
+	for (unsigned f = 0; f < PERIOD * PERIODS; f++) {       /* 48 frames a cycle, -20 dBFS */
+		unsigned p = f % 48, q = p % 24;
+		int16_t v = q <= 12 ? quarter[q] : quarter[24 - q];
+		v = p < 24 ? v : (int16_t)-v;
+		s[2 * f] = v;
+		s[2 * f + 1] = v;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	(void)wr_bits(abox, "RDMA0 CTRL0 (off)", RDMA0(R_CTRL0), 1, 0);
+	(void)wr(abox, "RDMA0 BUF_STR", RDMA0(R_BUF_STR), RMEM_PA);
+	(void)wr(abox, "RDMA0 BUF_END", RDMA0(R_BUF_END), RMEM_PA + RING_BYTES);
+	(void)wr(abox, "RDMA0 BUF_OFFSET (period)", RDMA0(R_BUF_OFFSET), PERIOD * 4u);
+	(void)wr(abox, "RDMA0 STR_POINT", RDMA0(R_STR_POINT), RMEM_PA);
+	if ((rd(abox, RDMA0(R_VOL)) & 0xffffff) == 0) {
+		(void)wr_bits(abox, "RDMA0 VOL_FACTOR (unity)", RDMA0(R_VOL), 0xffffff, 0x800000);
+	}
+	if (((rd(abox, RDMA0(R_CTRL0)) >> 19) & 0xf) == 0) {
+		(void)wr_bits(abox, "RDMA0 CTRL0 (BURST_LEN 8)", RDMA0(R_CTRL0), 0xfu << 19, 8u << 19);
+	}
+	if (rdma_probe()) {
+		(void)wr(abox, "RDMA0 SBANK_LIMIT (probed)", RDMA0(0x20), probe_limit);
+		(void)wr_bits(abox, "RDMA0 CTRL0 (probed bits)", RDMA0(R_CTRL0), probe_ctrl0, probe_ctrl0);
+		(void)wr(abox, "RDMA0 STR_POINT", RDMA0(R_STR_POINT), RMEM_PA);
+	}
+	c_wr(MAIN, 0x51, (uint8_t)vol);
+	c_wr(MAIN, 0x52, (uint8_t)vol);
+	(void)wr_bits(abox, "RDMA0 CTRL0 (ENABLE)", RDMA0(R_CTRL0), 1, 1);
+	printf("SWEET AUDIO: 6 tone: 1 kHz, -20 dBFS, DAC volume %#x, %u s\n", vol, secs);
+	for (unsigned t = 0; t < secs * 4; t++) {
+		uint32_t st = rd(abox, RDMA0(R_STATUS));
+		if (t < 4 || t % 4 == 0) {
+			printf("SWEET AUDIO: 6 tone: %u ms: RDMA0 status %#x (progress %u, offset %u, count %u), UAIF0 status %#x\n",
+			    t * 250, st, st >> 31, (st >> 16) & 0x1fff, st & 0x1fff, rd(abox, UAIF(0, 0xc)));
+		}
+		delay(250000);
+	}
+	c_wr(MAIN, 0x51, 0xff);
+	c_wr(MAIN, 0x52, 0xff);
+	(void)wr_bits(abox, "RDMA0 CTRL0 (off)", RDMA0(R_CTRL0), 1, 0);
+	printf("SWEET AUDIO: 6 tone: done; did you hear it (headphones, speaker)?\n");
+}
+
+/*
+ * Speaker, step 1 (look, read only on the amplifier): the NXP TFA9872 at 0x34 on I2C3 (0x13860000, an s3c2440-type
+ * controller; stock DT /i2c@13860000/tfa98xx@34), fed by ABOX UAIF3 on Android (mixer_paths route-spkamp-playback).
+ * Pins gpp3-0/1 function 2, pull-up (pinctrl 0x139B0000 bank 0x80); clock CMU_PERI 0x10010000 gate 0x2044, Q 0x3024.
+ * Registers are 16 bits, big endian, after an 8-bit address. Polled: IICCON bit 4 is the pending flag.
+ */
+#define I2C3_PA         0x13860000u
+#define IICCON          0x00u
+#define IICSTAT         0x04u
+#define IICDS           0x0cu
+#define IICLC           0x10u
+#define TFA_ADDR        0x34u
+
+static vm_offset_t i2c;
+
+static int
+i2c_wait(void)
+{
+	for (int i = 0; i < 2000; i++) {
+		if (rd(i2c, IICCON) & 0x10) {
+			return 0;
+		}
+		delay(10);
+	}
+	return ETIMEDOUT;
+}
+
+static inline void i2c_go(uint32_t ack) { *(volatile uint32_t *)(i2c + IICCON) = (ack ? 0x80u : 0) | 0x60u | 3u; }
+
+static void
+i2c_stop(uint32_t mode)
+{
+	*(volatile uint32_t *)(i2c + IICSTAT) = mode;
+	i2c_go(0);
+	delay(100);
+}
+
+static int
+tfa_read(uint8_t reg, uint16_t *val)
+{
+	uint8_t hi, lo;
+
+	*(volatile uint32_t *)(i2c + IICDS) = TFA_ADDR << 1;
+	*(volatile uint32_t *)(i2c + IICSTAT) = 0xf0;           /* master transmit, START, output on */
+	if (i2c_wait() || (rd(i2c, IICSTAT) & 1)) {
+		i2c_stop(0xd0);
+		return ENXIO;                                       /* no ACK for the address */
+	}
+	*(volatile uint32_t *)(i2c + IICDS) = reg;
+	i2c_go(1);
+	if (i2c_wait() || (rd(i2c, IICSTAT) & 1)) {
+		i2c_stop(0xd0);
+		return EIO;
+	}
+	*(volatile uint32_t *)(i2c + IICDS) = (TFA_ADDR << 1) | 1;
+	*(volatile uint32_t *)(i2c + IICSTAT) = 0xb0;           /* master receive, repeated START */
+	i2c_go(1);
+	if (i2c_wait()) {
+		i2c_stop(0x90);
+		return EIO;
+	}
+	i2c_go(1);                                              /* first byte, ACK */
+	if (i2c_wait()) {
+		i2c_stop(0x90);
+		return EIO;
+	}
+	hi = (uint8_t)rd(i2c, IICDS);
+	i2c_go(0);                                              /* last byte, NACK */
+	if (i2c_wait()) {
+		i2c_stop(0x90);
+		return EIO;
+	}
+	lo = (uint8_t)rd(i2c, IICDS);
+	i2c_stop(0x90);
+	*val = (uint16_t)(hi << 8 | lo);
+	return 0;
+}
+
+static int
+tfa_write(uint8_t reg, uint16_t val)
+{
+	const uint8_t b[3] = { reg, (uint8_t)(val >> 8), (uint8_t)val };
+
+	*(volatile uint32_t *)(i2c + IICDS) = TFA_ADDR << 1;
+	*(volatile uint32_t *)(i2c + IICSTAT) = 0xf0;
+	if (i2c_wait() || (rd(i2c, IICSTAT) & 1)) {
+		i2c_stop(0xd0);
+		return ENXIO;
+	}
+	for (int k = 0; k < 3; k++) {
+		*(volatile uint32_t *)(i2c + IICDS) = b[k];
+		i2c_go(1);
+		if (i2c_wait() || (rd(i2c, IICSTAT) & 1)) {
+			i2c_stop(0xd0);
+			return EIO;
+		}
+	}
+	i2c_stop(0xd0);
+	return 0;
+}
+
+/* NXP bitfield id: register << 8 | position << 4 | (length - 1) (tfa9872_tfafieldnames.h, facts only) */
+static int
+tfa_bf(uint16_t bf, uint16_t v)
+{
+	uint8_t reg = (uint8_t)(bf >> 8);
+	unsigned pos = (bf >> 4) & 15, len = (bf & 15) + 1;
+	uint16_t mask = (uint16_t)(((1u << len) - 1) << pos), old = 0;
+	int e = tfa_read(reg, &old);
+
+	return e ? e : tfa_write(reg, (uint16_t)((old & ~mask) | ((v << pos) & mask)));
+}
+
+/*
+ * Speaker, step 2: UAIF3 (gpb2-0..3, CMU_DISPAUD DIV 0x1824, MUX 0x1014, gates 0x201c/0x20c4, Q 0x3018) from SIFS1
+ * (ROUTE_CTRL0 [15:12] = 2), 2 x 16-bit I2S master as UAIF0; then the TFA9872 started from Samsung's Tfa9872.cnt
+ * (vendor/firmware): the device's 23 bitfields and the "music" profile's (AUDFS 48 kHz, AMPE, LPM1MODE, LNMODE, DCA),
+ * without the speaker-protection DSP (it runs in ABOX on Android). MANSCONF, then PWDN 0 once BCK runs.
+ */
+static const uint16_t tfa_dev_bf[23][2] = {
+	{ 0x20c3, 0x0 }, { 0x2144, 0xf }, { 0x2224, 0xf }, { 0x2103, 0x1 }, { 0x2330, 0x1 }, { 0x2340, 0x1 },
+	{ 0x2603, 0x0 }, { 0x26c3, 0x0 }, { 0x2703, 0x1 }, { 0x6801, 0x2 }, { 0x6821, 0x1 }, { 0x6841, 0x2 },
+	{ 0x6110, 0x1 }, { 0x6365, 0x1b }, { 0x6565, 0x0 }, { 0x7033, 0xc }, { 0x6163, 0x6 }, { 0x7444, 0x7 },
+	{ 0x7534, 0x5 }, { 0x7402, 0x4 }, { 0x7002, 0x5 }, { 0x0580, 0x0 }, { 0x0560, 0x0 },
+};
+static int spk_on;
+
+static void
+step_speaker_start(void)
+{
+	vm_offset_t aud = gpio;
+	uint16_t st = 0, st13 = 0;
+	int errs = 0;
+
+	if (!i2c) {
+		return;
+	}
+	(void)wr_bits(cmu, "spk: DIV_UAIF3 (/16: 1.536 MHz)", 0x1824, 0x1f, 15);
+	(void)wr_bits(cmu, "spk: MUX_UAIF3 (the divider)", 0x1014, 1, 0);
+	(void)wr_bits(cmu, "spk: gate BCLK_UAIF3", 0x201c, GATE_ON, GATE_ON);
+	(void)wr_bits(cmu, "spk: gate RSTNSYNC UAIF3", 0x20c4, GATE_ON, GATE_ON);
+	(void)wr_bits(cmu, "spk: QCH UAIF3", 0x3018, 3, 2);
+	(void)wr_bits(aud, "spk: gpb2 CON (0..3 function 2)", 0x40, 0xffff, 0x2222);
+	(void)wr_bits(aud, "spk: gpb2 PUD (0..3 as the DT: 1)", 0x48, 0xffff, 0x1111);
+	(void)wr_bits(abox, "spk: QCHANNEL_DISABLE (+ BCLK_UAIF3; inferred bit 5)", QCH_DISABLE, 1u << 5, 1u << 5);
+	(void)wr_bits(abox, "spk: ROUTE_CTRL0 (UAIF3 from SIFS1)", ROUTE0, 0xfu << 12, 2u << 12);
+	(void)wr(abox, "spk: UAIF3 CTRL1 (2 x 16 bit I2S)", UAIF(3, 4), 0x0984f000);
+	(void)wr(abox, "spk: UAIF3 CTRL0 (master, data mode)", UAIF(3, 0), 0x1000014);
+	(void)wr_bits(abox, "spk: UAIF3 CTRL0 (SPK_ENABLE)", UAIF(3, 0), 1, 1);
+	delay(20000);
+
+	errs += tfa_write(0x00, 0x0002) != 0;                   /* I2CR: registers to their defaults */
+	delay(10000);
+	errs += tfa_write(0x0f, 0x5a6b) != 0;                   /* hidden-register key */
+	for (unsigned i = 0; i < 23; i++) {
+		errs += tfa_bf(tfa_dev_bf[i][0], tfa_dev_bf[i][1]) != 0;
+	}
+	errs += tfa_write(0x0f, 0) != 0;
+	errs += tfa_bf(0x0203, 8) != 0;                         /* AUDFS 48 kHz */
+	errs += tfa_bf(0x64e1, 1) != 0;                         /* LPM1MODE */
+	errs += tfa_bf(0x62e1, 0) != 0;                         /* LNMODE */
+	errs += tfa_bf(0x0030, 1) != 0;                         /* AMPE */
+	errs += tfa_bf(0x0040, 1) != 0;                         /* DCA */
+	errs += tfa_bf(0x0120, 1) != 0;                         /* MANSCONF */
+	errs += tfa_bf(0x0000, 0) != 0;                         /* PWDN 0: power up */
+	for (int t = 0; t < 50; t++) {                          /* up to 500 ms for AMPS (status bit 12) */
+		(void)tfa_read(0x10, &st);
+		if (st & (1u << 12)) {
+			break;
+		}
+		delay(10000);
+	}
+	(void)tfa_read(0x13, &st13);
+	spk_on = 1;
+	printf("SWEET AUDIO: spk: TFA9872 started (%d I2C errors); status 0x10 %#x (CLKS %u PLLS %u AMPS %u), 0x13 %#x "
+	    "(MANOPER %u)\n", errs, st, (st >> 5) & 1, (st >> 1) & 1, (st >> 12) & 1, st13, st13 >> 15);
+}
+
+static void
+step_speaker_stop(void)
+{
+	if (!spk_on) {
+		return;
+	}
+	(void)tfa_bf(0x0030, 0);                                /* AMPE off */
+	(void)tfa_bf(0x0000, 1);                                /* PWDN */
+	(void)wr_bits(abox, "spk: UAIF3 CTRL0 (off)", UAIF(3, 0), 1, 0);
+	spk_on = 0;
+}
+
+static void
+step_speaker_look(void)
+{
+	vm_offset_t peri = ml_io_map(0x10010000u, 0x4000), top = ml_io_map(0x139b0000u, 0x1000);
+	char line[160];
+	int n = 0;
+
+	i2c = ml_io_map(I2C3_PA, 0x100);
+	if (!peri || !top || !i2c) {
+		printf("SWEET AUDIO: spk: cannot map\n");
+		return;
+	}
+	(void)wr_bits(peri, "spk: CMU_PERI gate I2C3 PCLK", 0x2044, GATE_ON, GATE_ON);
+	(void)wr_bits(peri, "spk: CMU_PERI QCH I2C3", 0x3024, 3, 2);
+	(void)wr_bits(top, "spk: gpp3 CON (0, 1 function 2: I2C3)", 0x80, 0xff, 0x22);
+	(void)wr_bits(top, "spk: gpp3 PUD (0, 1 pull-up)", 0x88, 0xff, 0x33);
+	*(volatile uint32_t *)(i2c + IICLC) = 0;
+	i2c_go(1);
+	*(volatile uint32_t *)(i2c + IICSTAT) = 0x10;           /* output on, idle */
+	printf("SWEET AUDIO: spk: I2C3 CON %#x STAT %#x; gpp3 DAT %#x (both high when the bus is idle)\n",
+	    rd(i2c, IICCON), rd(i2c, IICSTAT), rd(top, 0x84));
+	static const uint8_t regs[6] = { 0x00, 0x01, 0x03, 0x10, 0x13, 0x51 };
+	for (unsigned i = 0; i < 6; i++) {
+		uint16_t v = 0;
+		int e = tfa_read(regs[i], &v);
+		n += snprintf(line + n, sizeof(line) - n, e ? " %02x:err%d" : " %02x:%04x", regs[i], e ? e : v);
+	}
+	printf("SWEET AUDIO: spk: TFA9872 at 0x34 (0x03 is the revision; 0x..72 is a TFA9872):%s\n", line);
+	/* run 73: it answers (0x03 = 0x3b72). Whole map 0x00-0x8f, read only, 8 a line, for planning its power-up. */
+	for (unsigned r = 0; r < 0x90; r += 8) {
+		n = 0;
+		for (unsigned k = 0; k < 8; k++) {
+			uint16_t v = 0;
+			n += snprintf(line + n, sizeof(line) - n, tfa_read((uint8_t)(r + k), &v) ? " ----" : " %04x", v);
+		}
+		printf("SWEET AUDIO: spk: TFA %02x:%s\n", r, line);
+	}
+}
+
+/*
+ * Calliope (run 76): on the 7885, ABOX's RDMA is not the AP's to drive. Samsung's driver (Exynos7885-Dev lineage-18.1
+ * sound/soc/samsung/abox: abox.c abox_enable/abox_download_firmware, abox_rdma.c hw_params/prepare/trigger; GPL,
+ * read for facts only) boots ABOX's Cortex-A7 with calliope_sram.bin/calliope_dram.bin and sends it IPC_PCMPLAYBACK
+ * messages; the firmware runs RDMA. Runs 66..75 poked RDMA0 directly: progress 1, never a byte read.
+ *
+ * Here, the same, minus Linux:
+ *   firmware: the phone's own files, packed by tools/mkaboxfw.py, loaded by the shim after the kernel and found at
+ *     /chosen/memory-map "SweetABOX" (mkpayload --blob). Never in git.
+ *   memory: the firmware sees 12 MB at IOVA 0x80000000 (DRAM_FIRMWARE_SIZE) and the RDMA0 buffer at 0x81000000
+ *     (IOVA_RDMA_BUFFER(0)), through ABOX's SysMMU (0x14A30000) with our own 1 MB-section level-1 table. Physical
+ *     pages: low bank 0xE8000000.. (XNU only manages the upper bank; just below the stock wifibt_if carve-out).
+ *     Plus the identity sections Samsung maps (0x11C80000 PMU, 0x12090000).
+ *   CPU: PMU ABOX_CA7_CONFIGURATION 0x2520 bit 0, OPTION 0x2528 bit 15 (ENABLE_CPU), STATUS 0x2524 bit 0; it starts at
+ *     REMAP_ADDR 0x14B00000 (ABOX SRAM). The secure handshake (PMU 0x814 magic + SMC 0x82000501) as abox_enable.
+ *   IPC: ABOX_IPC_MSG (764 bytes) at SRAM+0x22000, ack word +0x222fc; doorbell = SGI (ipcid) through ABOX's own GIC
+ *     distributor 0x14AF1000+0xF00 (GIC_IS_SECURE_FREE in abox_gic.c: plain writes). Firmware->AP at +0x22300, ack
+ *     +0x225fc, polled (its SPI is not wired into XNU).
+ */
+extern int IODTGetLoaderInfo(const char *key, void **infoAddr, int *infoSize);
+
+#define PMU_PA          0x11c80000u
+#define SRAM_PA         0x14b00000u
+#define SRAM_SIZE       0x28000u
+#define AGIC_PA         0x14af1000u     /* +0x000 distributor, +0x1000 CPU interface */
+#define FW_IOVA         0x80000000u
+#define FW_SIZE         0xc00000u
+#define RING_IOVA       0x81000000u
+#define IPC_TX          0x22000u
+#define IPC_TX_ACK      0x222fcu
+#define IPC_RX          0x22300u
+#define IPC_RX_ACK      0x225fcu
+#define IPC_WORDS       191u            /* sizeof(ABOX_IPC_MSG) / 4 */
+
+/* run 77: io mappings are permanent on this kernel (ml_io_unmap panics: "Attempting to remove permanent VM map entry")
+ * and one 12 MB io map does not fit. So the 12 MB firmware + 1 MB page table + 1 MB ring are ordinary XNU RAM:
+ * physically contiguous, 1 MB aligned (the SysMMU maps 1 MB sections), written through the kernel's cached mapping
+ * and cleaned to memory with dc cvac before the CA7 (not coherent) looks at it. */
+static uint64_t fw_pa;
+static vm_offset_t fw_va;
+static vm_offset_t pmu, sram, agic, ptab, cring;
+
+static void
+dc_clean(vm_offset_t va, vm_size_t len)
+{
+	for (vm_offset_t a = va & ~(vm_offset_t)63; a < va + len; a += 64) {
+		__asm__ volatile ("dc cvac, %0" :: "r"(a) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+static unsigned rx_shown;
+
+static inline void wr32(vm_offset_t b, uint32_t o, uint32_t v) { *(volatile uint32_t *)(b + o) = v; }
+
+static int64_t
+smc4(uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = a0;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int64_t)x0;
+}
+
+static const char *
+ipc_name(uint32_t id)
+{
+	static const char *n[16] = { "RECEIVED", "SYSTEM", "PCMPLAYBACK", "PCMCAPTURE", "OFFLOAD", "ERAP", "6", "7",
+		                     "WDMA0_FULL", "WDMA1_FULL", "CONFIG", "RDMA0_EMPTY", "RDMA1_EMPTY", "RDMA2_EMPTY",
+		                     "RDMA3_EMPTY", "ASB_TEST" };
+	return id < 16 ? n[id] : "?";
+}
+
+/* Firmware -> AP messages: print (the first 40), then hand the slot back. Returns the last SYSTEM msgtype seen. */
+static uint32_t
+ipc_rx_poll(void)
+{
+	uint32_t last = 0;
+	for (int k = 0; k < 16 && rd(sram, IPC_RX_ACK); k++) {
+		uint32_t m[8];
+		for (int i = 0; i < 8; i++) {
+			m[i] = rd(sram, IPC_RX + 4u * i);
+		}
+		if (m[0] == 1) {
+			last = m[2];
+		}
+		if (rx_shown++ < 40) {
+			printf("SWEET AUDIO: 7 rx: %s task %u: %#x %#x %#x %#x %#x %#x\n", ipc_name(m[0]), m[1], m[2], m[3],
+			    m[4], m[5], m[6], m[7]);
+		}
+		wr32(sram, IPC_RX_ACK, 0);
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	return last;
+}
+
+static int
+ipc_send(const char *what, const uint32_t *m, unsigned words, int sync)
+{
+	unsigned i;
+	for (i = 0; i < IPC_WORDS; i++) {
+		wr32(sram, IPC_TX + 4u * i, i < words ? m[i] : 0);
+	}
+	wr32(sram, IPC_TX_ACK, 1);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr32(agic, 0xf00, (1u << 16) | (m[0] & 0xf));
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (!sync) {
+		printf("SWEET AUDIO: 7 tx: %s (no wait)\n", what);
+		return 0;
+	}
+	for (i = 0; i < 20000 && rd(sram, IPC_TX_ACK); i++) {
+		delay(1);
+		if ((i & 63) == 0) {
+			(void)ipc_rx_poll();
+		}
+	}
+	printf("SWEET AUDIO: 7 tx: %s: %s after %u us\n", what, rd(sram, IPC_TX_ACK) ? "NO ACK" : "acked", i);
+	return rd(sram, IPC_TX_ACK) ? -1 : 0;
+}
+
+/* PCMTASK message for RDMA0: { ipcid, task_id, msgtype, channel_id, param[3] } */
+static int
+pcm(const char *what, uint32_t type, uint32_t p0, uint32_t p1, uint32_t p2, int sync)
+{
+	uint32_t m[7] = { 2u /* IPC_PCMPLAYBACK */, 0, type, 0, p0, p1, p2 };
+	return ipc_send(what, m, 7, sync);
+}
+
+static void
+mmu_report(const char *when)
+{
+	printf("SWEET AUDIO: 7 SysMMU %s: ver %#x ctrl %#x cfg %#x status %#x pt %#x/%#x int %#x fault AR %#x (%#x) AW %#x (%#x)\n",
+	    when, rd(mmu, 0x34), rd(mmu, 0x0), rd(mmu, 0x4), rd(mmu, 0x8), rd(mmu, 0xc), rd(mmu, 0x1020), rd(mmu, 0x60),
+	    rd(mmu, 0x70), rd(mmu, 0x78), rd(mmu, 0x80), rd(mmu, 0x88));
+}
+
+/* 16-bit sine, Bhaskara's approximation; phase: 2^32 = one cycle */
+static int32_t
+isin(uint32_t ph)
+{
+	int64_t t = (ph >> 16) & 0x7fff, T = 32768;
+	int64_t v = (16 * t * (T - t) * 32767) / (5 * T * T - 4 * t * (T - t));
+	return (ph & 0x80000000u) ? (int32_t)-v : (int32_t)v;
+}
+
+/*
+ * The ring (RING_BYTES_C, 4 s of 48 kHz stereo 16 bit): an original marimba-like phrase (sine + a fast-decaying 4th
+ * partial, 170 ms decay), 2.75 s, then silence; or the old 1 kHz tone with a8tone=1. Peak about -11 dBFS.
+ */
+#define C_PERIOD_BYTES  4800u           /* 25 ms */
+#define C_PERIODS       160u
+#define RING_BYTES_C    (C_PERIOD_BYTES * C_PERIODS)
+static void
+fill_ring(unsigned tone)
+{
+	static const uint16_t notes[][2] = {    /* Hz, eighths of a second; 0 Hz = rest */
+		{ 659, 1 }, { 784, 1 }, { 1047, 1 }, { 784, 1 }, { 659, 1 }, { 784, 1 }, { 1047, 1 }, { 1319, 2 }, { 0, 1 },
+		{ 1175, 1 }, { 988, 1 }, { 784, 1 }, { 988, 1 }, { 1175, 1 }, { 988, 1 }, { 784, 1 }, { 1047, 3 }, { 0, 2 },
+	};
+	const unsigned frames = RING_BYTES_C / 4u;
+	unsigned f = 0;
+	if (tone) {
+		for (; f < frames; f++) {
+			int32_t v = isin((uint32_t)((uint64_t)f * 1000u * 4294967296ull / RATE)) / 10;
+			wr32(cring, 4u * f, ((uint32_t)(uint16_t)v << 16) | (uint16_t)v);
+		}
+		return;
+	}
+	for (unsigned n = 0; n < sizeof(notes) / sizeof(notes[0]); n++) {
+		unsigned len = notes[n][1] * (RATE / 8u);
+		uint32_t ph = 0, inc = (uint32_t)((uint64_t)notes[n][0] * 4294967296ull / RATE);
+		int64_t env = 1ll << 30, env4 = 1ll << 30;
+		for (unsigned i = 0; i < len && f < frames; i++, f++) {
+			int32_t v = 0;
+			if (notes[n][0]) {
+				int64_t s = (int64_t)isin(ph) * env + (int64_t)isin(ph * 4u) * (env4 / 3);
+				v = (int32_t)((s >> 30) * 9000 / 32767);
+				if (i < 48) {
+					v = v * (int32_t)i / 48;
+				}
+				ph += inc;
+				env -= env >> 13;
+				env4 -= env4 >> 10;
+			}
+			wr32(cring, 4u * f, ((uint32_t)(uint16_t)v << 16) | (uint16_t)v);
+		}
+	}
+	for (; f < frames; f++) {
+		wr32(cring, 4u * f, 0);
+	}
+}
+
+static int
+calliope_boot(void)
+{
+	void *blob_pa = NULL;
+	int blob_size = 0;
+	const uint32_t *blob;
+	uint32_t count, magic, st, last = 0;
+	unsigned i;
+
+	if (IODTGetLoaderInfo("SweetABOX", &blob_pa, &blob_size) != 0 || blob_size < 8) {
+		printf("SWEET AUDIO: 7 calliope: no SweetABOX firmware in this boot image (mkpayload --blob)\n");
+		return -1;
+	}
+	blob = (const uint32_t *)ml_static_ptovirt((vm_offset_t)blob_pa);
+	magic = blob[0];
+	count = blob[1];
+	printf("SWEET AUDIO: 7 calliope: firmware %d bytes at %#lx, magic %#x, %u parts\n", blob_size,
+	    (unsigned long)(uintptr_t)blob_pa, magic, count);
+	if (magic != 0x46584241u /* "ABXF" */ || count == 0 || count > 8) {
+		return -1;
+	}
+	pmu = ml_io_map(PMU_PA, 0x4000);
+	sram = ml_io_map(SRAM_PA, SRAM_SIZE);
+	agic = ml_io_map(AGIC_PA, 0x2000);
+	if (!pmu || !sram || !agic) {
+		printf("SWEET AUDIO: 7 calliope: cannot map
+");
+		return -1;
+	}
+	{
+		kern_return_t kr = kmem_alloc_contig(kernel_map, &fw_va, FW_SIZE + 0x200000u, 0,
+		    (ppnum_t)(0x1000000000ull >> PAGE_SHIFT), (ppnum_t)((0x100000u >> PAGE_SHIFT) - 1),
+		    KMA_KOBJECT | KMA_ZERO, VM_KERN_MEMORY_IOKIT);
+		if (kr != KERN_SUCCESS || fw_va == 0) {
+			printf("SWEET AUDIO: 7 calliope: no contiguous %u MB (kr %d)\n", (FW_SIZE + 0x200000u) >> 20, kr);
+			return -1;
+		}
+		fw_pa = (uint64_t)ml_vtophys(fw_va);
+		for (i = 0; i < FW_SIZE + 0x200000u; i += 0x100000u) {
+			if ((uint64_t)ml_vtophys(fw_va + i) != fw_pa + i) {
+				printf("SWEET AUDIO: 7 calliope: memory not contiguous at +%#x\n", i);
+				return -1;
+			}
+		}
+		if ((fw_pa & 0xfffffull) != 0) {
+			printf("SWEET AUDIO: 7 calliope: memory at %#llx not 1 MB aligned\n", (unsigned long long)fw_pa);
+			return -1;
+		}
+		ptab = fw_va + FW_SIZE;
+		cring = fw_va + FW_SIZE + 0x100000u;
+		printf("SWEET AUDIO: 7 calliope: firmware memory %u MB of XNU RAM at PA %#llx\n",
+		    (FW_SIZE + 0x200000u) >> 20, (unsigned long long)fw_pa);
+	}
+	printf("SWEET AUDIO: 7 calliope: CA7 status %#x option %#x config %#x, TIMER0_CTRL1 %#x, PC %#x\n",
+	    rd(pmu, 0x2524), rd(pmu, 0x2528), rd(pmu, 0x2520), rd(abox, 0x604), rd(abox, 0x2c3c));
+
+	/* abox_gic_enable / abox_gicd_enable(true) */
+	wr32(agic, 0x0, 0x1);
+	wr32(agic, 0x80, 0);
+	wr32(agic, 0x84, 0);
+	wr32(agic, 0x88, 0);
+	wr32(agic, 0x8c, 0);
+	wr32(agic, 104, 0xc);   /* sic: decimal, as abox_gic.c */
+
+	/* abox_enable, fresh boot: CPU off, start address, secure handshake */
+	(void)wr_bits(pmu, "PMU CA7 OPTION (CPU disable)", 0x2528, 0x8000, 0);
+	(void)wr_bits(pmu, "PMU CA7 CONFIGURATION (power off)", 0x2520, 1, 0);
+	(void)wr(abox, "REMAP_ADDR (CA7 starts in ABOX SRAM)", 0x28, SRAM_PA);
+	{
+		unsigned dosmc = 1;
+		(void)PE_parse_boot_argn("a8absmc", &dosmc, sizeof(dosmc));
+		if (dosmc) {
+			int64_t r;
+			wr32(pmu, 0x814, 0);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			r = smc4(0x82000501ull, 0, 0, 0);
+			for (i = 0; i < 1000 && rd(pmu, 0x814) != 0xab0cab0cu; i++) {
+				delay(10);
+			}
+			printf("SWEET AUDIO: 7 calliope: SMC 0x82000501 -> %lld, PMU magic %#x after %u x 10 us\n", r,
+			    rd(pmu, 0x814), i);
+			(void)wr_bits(pmu, "PMU CA7 OPTION (CPU disable)", 0x2528, 0x8000, 0);
+			(void)wr_bits(pmu, "PMU CA7 CONFIGURATION (power off)", 0x2520, 1, 0);
+		}
+	}
+
+	/* abox_gic_init_gic, GIC_IS_SECURE_FREE */
+	wr32(agic, 0x1000 + 0x4, 0xff);
+	wr32(agic, 0x0, 0x3);
+	for (i = 0; i < 40; i++) {
+		wr32(agic, 0x400 + 4u * i, 0x10101010u);
+	}
+	wr32(agic, 0x1000 + 0x0, 0x3);
+
+	/* SysMMU: level-1 table of 1 MB sections, entry = (pa >> 4) | 2 (exynos-iommu.h mk_lv1ent_sect) */
+	for (i = 0; i < 4096; i++) {
+		wr32(ptab, 4u * i, 0);
+	}
+	for (i = 0; i < FW_SIZE >> 20; i++) {
+		wr32(ptab, 4u * ((FW_IOVA >> 20) + i), ((fw_pa + (i << 20)) >> 4) | 2u);
+	}
+	wr32(ptab, 4u * (RING_IOVA >> 20), ((fw_pa + FW_SIZE + 0x100000u) >> 4) | 2u);
+	wr32(ptab, 4u * (0x11c80000u >> 20), (0x11c00000u >> 4) | 2u);
+	wr32(ptab, 4u * (0x12090000u >> 20), (0x12000000u >> 4) | 2u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	dc_clean(ptab, 0x4000);
+	mmu_report("before");
+	(void)wr(mmu, "SysMMU CTRL (block)", 0x0, 0x7);
+	(void)wr(mmu, "SysMMU PT_BASE_PPN", 0xc, (fw_pa + FW_SIZE) >> 12);
+	(void)wr(mmu, "SysMMU PT_BASE_PPN (table #1, ABOX)", 0x1020, (fw_pa + FW_SIZE) >> 12);
+	wr32(mmu, 0x10, 0x1);
+	wr32(mmu, 0x10, 0x11);
+	(void)wr(mmu, "SysMMU CTRL (enable)", 0x0, 0x5);
+
+	/* abox_download_firmware: SRAM zeroed, then each part */
+	for (i = 0; i < SRAM_SIZE; i += 4) {
+		wr32(sram, i, 0);
+	}
+	for (i = 0; i < count; i++) {
+		const uint32_t *e = blob + 2 + 4 * i;
+		uint32_t lim = e[0] == 0 ? SRAM_SIZE : FW_SIZE;
+		if (e[1] + e[2] > lim || e[3] + e[2] > (uint32_t)blob_size) {
+			printf("SWEET AUDIO: 7 calliope: part %u does not fit\n", i);
+			return -1;
+		}
+	}
+	/* firmware DRAM parts (the memory came zeroed) */
+	for (i = 0; i < count; i++) {
+		const uint32_t *e = blob + 2 + 4 * i;
+		if (e[0] == 1) {
+			for (uint32_t w = 0; w < e[2]; w += 4) {
+				wr32(fw_va, e[1] + w, blob[(e[3] + w) / 4]);
+			}
+		}
+	}
+	dc_clean(fw_va, FW_SIZE);
+	for (i = 0; i < count; i++) {
+		const uint32_t *e = blob + 2 + 4 * i;
+		if (e[0] == 0) {
+			for (uint32_t w = 0; w < e[2]; w += 4) {
+				wr32(sram, e[1] + w, blob[(e[3] + w) / 4]);
+			}
+		}
+		printf("SWEET AUDIO: 7 calliope: part %u (%u bytes) -> %s +%#x\n", i, e[2], e[0] == 0 ? "SRAM" : "DRAM", e[1]);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	/* abox_request_dram_on, abox_cpu_power(true), abox_cpu_enable(true) */
+	(void)wr_bits(abox, "SYSPOWER_CTRL (DRAM on)", SYSPOWER, 1, 1);
+	(void)wr_bits(pmu, "PMU CA7 CONFIGURATION (power on)", 0x2520, 1, 1);
+	(void)wr_bits(pmu, "PMU CA7 OPTION (CPU enable)", 0x2528, 0x8000, 0x8000);
+	for (i = 0; i < 1000 && !(rd(pmu, 0x2524) & 1); i++) {
+		delay(10);
+	}
+	printf("SWEET AUDIO: 7 calliope: CA7 status %#x after %u x 10 us\n", rd(pmu, 0x2524), i);
+
+	/* boot done: a SYSTEM message ABOX_BOOT_DONE (3), within 3 s */
+	for (i = 0; i < 3000; i++) {
+		st = ipc_rx_poll();
+		if (st) {
+			last = st;
+		}
+		if (last == 3) {
+			break;
+		}
+		if (i % 500 == 0) {
+			printf("SWEET AUDIO: 7 calliope: %u ms: CA7 PC %#x status %#x\n", i, rd(abox, 0x2c3c), rd(pmu, 0x2524));
+		}
+		delay(1000);
+	}
+	mmu_report("after boot");
+	printf("SWEET AUDIO: 7 calliope: %s after %u ms (CA7 PC %#x)\n", last == 3 ? "BOOT DONE" : "no boot-done message",
+	    i, rd(abox, 0x2c3c));
+	return last == 3 ? 0 : 1;
+}
+
+static void
+step_calliope_play(void)
+{
+	unsigned secs = 4, tone = 0;
+	int b;
+
+	(void)PE_parse_boot_argn("a8audiosecs", &secs, sizeof(secs));
+	(void)PE_parse_boot_argn("a8tone", &tone, sizeof(tone));
+	secs = secs < 1 ? 1 : secs > 12 ? 12 : secs;
+	b = calliope_boot();
+	if (b < 0) {
+		return;
+	}
+	fill_ring(tone);
+	dc_clean(cring, RING_BYTES_C);
+	printf("SWEET AUDIO: 7 play: %s, %u s, ring IOVA %#x (%u x %u bytes)\n", tone ? "1 kHz tone" : "ringtone phrase",
+	    secs, RING_IOVA, C_PERIODS, C_PERIOD_BYTES);
+	(void)pcm("PCM_PLTDAI_OPEN", 11, 0, 0, 0, 1);
+	(void)pcm("PCM_SET_BUFFER", 20, RING_IOVA, C_PERIOD_BYTES, C_PERIODS, 1);
+	(void)pcm("PCM_PLTDAI_HW_PARAMS (48000 Hz, 16 bit, 2 ch)", 14, RATE, 16, 2, 1);
+	(void)pcm("PCM_PLTDAI_PREPARE", 16, 0, 0, 0, 1);
+	(void)pcm("PCM_PLTDAI_TRIGGER (start)", 17, 1, 0, 0, 0);
+	for (unsigned t = 0; t < secs * 4; t++) {
+		uint32_t s = rd(abox, RDMA0(R_STATUS));
+		(void)ipc_rx_poll();
+		if (t < 4 || t % 4 == 0) {
+			printf("SWEET AUDIO: 7 play: %u ms: RDMA0 ctrl %#x buf %#x..%#x status %#x (progress %u, offset %u, count %u), UAIF3 %#x st %#x\n",
+			    t * 250, rd(abox, RDMA0(R_CTRL0)), rd(abox, RDMA0(R_BUF_STR)), rd(abox, RDMA0(R_BUF_END)), s, s >> 31,
+			    (s >> 16) & 0x1fff, s & 0x1fff, rd(abox, UAIF(3, 0)), rd(abox, UAIF(3, 0xc)));
+		}
+		delay(250000);
+	}
+	(void)pcm("PCM_PLTDAI_TRIGGER (stop)", 17, 0, 0, 0, 0);
+	delay(20000);
+	(void)ipc_rx_poll();
+	(void)pcm("PCM_PLTDAI_CLOSE", 12, 0, 0, 0, 1);
+	mmu_report("after play");
+	printf("SWEET AUDIO: 7 play: done; did you hear it?\n");
+}
+
+void
+sweet_a8_audio_run(void)
+{
+	unsigned n = 0;
+
+	if (!PE_parse_boot_argn("a8audio", &n, sizeof(n)) || n == 0) {
+		return;
+	}
+	abox = ml_io_map(ABOX_PA, 0x3000);
+	cmu = ml_io_map(CMU_PA, 0x4000);
+	gpio = ml_io_map(GPIO_PA, 0x1000);
+	mmu = ml_io_map(MMU_PA, 0x1000);
+	if (!abox || !cmu || !gpio || !mmu) {
+		printf("SWEET AUDIO: cannot map\n");
+		return;
+	}
+	step_speaker_look();
+	step_look();
+	if (n < 2 || !step_clocks()) {
+		return;
+	}
+	if (n < 3 || !step_pins()) {
+		return;
+	}
+	if (n < 4 || !step_codec()) {
+		return;
+	}
+	if (n < 5 || !step_uaif()) {
+		return;
+	}
+	if (n >= 6) {
+		unsigned spk = 1;
+		(void)PE_parse_boot_argn("a8spk", &spk, sizeof(spk));
+		unsigned fw = 1;
+		(void)PE_parse_boot_argn("a8abox", &fw, sizeof(fw));
+		if (spk) {
+			step_speaker_start();
+		}
+		if (fw) {
+			step_calliope_play();   /* run 76: the firmware drives RDMA */
+		} else {
+			step_tone();
+		}
+		step_speaker_stop();
+	}
+	step_look();
+}
+#endif /* SWEET_JACKPOTLTE */
