diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 9414972..92adaa9 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -499,6 +499,40 @@ start_cpu:
 2:
 .endmacro
 
+#if defined(SWEET)
+/*
+ * sweet_bootstrap_blocks: V=P L2 block entries in the bootstrap tables.
+ *   arg0 - physical (= virtual) address, L2 aligned; advanced
+ *   arg1 - number of L2 blocks; consumed
+ *   arg2 - block template (attributes, no address)
+ * Uses x25 (V=P L1 table) and x2 (free page pointer, last allocated page),
+ * scratch x6-x9. Reuses the L1 slot's L2 table if one exists.
+ */
+.macro sweet_bootstrap_blocks
+1:
+	and		x6, $0, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x6, x6, #(ARM_TT_L1_SHIFT)
+	add		x6, x25, x6, lsl #(TTE_SHIFT)		// L1 entry pointer
+	ldr		x7, [x6]
+	tbnz	x7, #0, 2f							// valid: existing L2 table
+	add		x2, x2, PGBYTES						// allocate a (zeroed) L2 table
+	mov		x8, #(ARM_TTE_BOOT_TABLE)
+	and		x7, x2, #(ARM_TTE_TABLE_MASK)
+	orr		x7, x7, x8
+	str		x7, [x6]
+2:
+	and		x7, x7, #(ARM_TTE_TABLE_MASK)		// L2 table address
+	and		x8, $0, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x8, x8, #(ARM_TT_L2_SHIFT)
+	orr		x9, $0, $2
+	str		x9, [x7, x8, lsl #(TTE_SHIFT)]
+	MOV64	x9, ARM_TT_L2_SIZE
+	add		$0, $0, x9
+	subs	$1, $1, #1
+	b.ne	1b
+.endmacro
+#endif
+
 /*
  * _start_first_cpu
  * Cold boot init routine.  Called from __start
@@ -517,10 +551,10 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (SWEET_FB_PA + (SWEET_FB_HEIGHT - 32) * SWEET_FB_STRIDE)
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	mov		x4, #(SWEET_FB_STRIDE)
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -532,6 +566,15 @@ Lsweet_mark_pixel:
 	subs	x2, x2, #1
 	b.ne	Lsweet_mark_row
 	dsb		sy
+#if defined(SWEET_DECON_PA)
+	/* Command-mode panel: re-arm DECON's TE trigger so the band is shown. */
+	MOV64	x0, (SWEET_DECON_PA + SWEET_DECON_TRIG_CONTROL)
+	ldr		w1, [x0]
+	bic		w1, w1, #(SWEET_DECON_TRIG_MASK)
+	orr		w1, w1, #(SWEET_DECON_TRIG_EN)
+	str		w1, [x0]
+	dsb		sy
+#endif
 #endif
 
 	// Set low reset vector before attempting any loads
@@ -682,19 +725,22 @@ Lkernelcache_base_found:
 
 #if defined(SWEET)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
-	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
-	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * Splash framebuffer as Normal-NC V=P L2 blocks (one 32MB block with
+	 * 16K pages, 2MB blocks with 4K pages), and on command-mode panels the
