diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index 7f07330..8ccd704 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -40,6 +40,31 @@
 #define SWEET_CPU_NAME            "Kryo 470"
 #endif
 
+/*
+ * Bootloader splash framebuffer used by the early console (sweet_early.c,
+ * start.s): a8r8g8b8, physical, L2-block aligned. Only the first buffer.
+ */
+#if defined(SWEET_JACKPOTLTE)
+#define SWEET_FB_PA               0xEC000000      // S-Boot, 0x1400000 reserved
+#define SWEET_FB_WIDTH            1080
+#define SWEET_FB_HEIGHT           2220
+/*
+ * DSI command-mode panel: DECON scans out one frame per armed TE trigger and
+ * masks the trigger again, so every update must be "presented" (shim/a8:
+ * a8_present). The shim leaves DECON enabled and DPP0 on SWEET_FB_PA.
+ */
+#define SWEET_DECON_PA            0x14860000
+#define SWEET_DECON_TRIG_CONTROL  0x70            // HW_SW_TRIG_CONTROL
+#define SWEET_DECON_TRIG_MASK     0x10            // HW_TRIG_MASK_DECON
+#define SWEET_DECON_TRIG_EN       0x1             // HW_TRIG_EN
+#else
+#define SWEET_FB_PA               0x9c000000      // ABL continuous splash
+#define SWEET_FB_WIDTH            1080
+#define SWEET_FB_HEIGHT           2400
+#endif
+#define SWEET_FB_STRIDE           (SWEET_FB_WIDTH * 4)
+#define SWEET_FB_BYTES            (SWEET_FB_STRIDE * SWEET_FB_HEIGHT)
+
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__              8
 #define __ARM_VMSA__              8
