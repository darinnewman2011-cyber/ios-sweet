+	if (PSR64_IS_USER64(get_saved_state_cpsr(state))) {
+		boolean_t ie = ml_set_interrupts_enabled(TRUE);
+		bool done = sweet_emulate(state, instr);
+		ml_set_interrupts_enabled(ie);
+		if (done) {
+			return;
+		}
+	}
+#endif
+
 #if CONFIG_DTRACE
 
