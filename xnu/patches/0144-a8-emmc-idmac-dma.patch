 /* count 512-byte sectors of the file at sector lba into the bounce buffer. */
+static int file_read_blocks_timed(uint64_t lba, uint32_t count);
+
 static int
 file_read_blocks(uint64_t lba, uint32_t count)
+{
+	uint64_t t0 = mach_absolute_time();
+	int error = file_read_blocks_timed(lba, count);
+
+	if (!error) {
+		mdma.rd_bytes += (uint64_t)count * UFS_BLOCK;
+		mdma.rd_abs += mach_absolute_time() - t0;
+	}
+	return error;
+}
