+/*
+ * xnu 0168 (boot-arg sweetlog=2): the A8 keeps the ring in the last 4 MiB + 512 B of SYSTEM (mmcblk0p19, the
+ * Android system partition Darin gave to iOS), written raw and only inside [mmc_log_lo, mmc_log_hi); TWRP reads it
+ * with tools/a8-log-pull.sh. USERDATA (the root file) is never touched by the log.
+ */
+static int
+sweet_log_write(uint64_t lba, uint32_t n)
+{
+	uint32_t *buf = (uint32_t *)(su.dma + DMA_BOUNCE);
+	while (n) {
+		uint32_t m = MIN(n, MMC_MULTI_MAX);
+		if (m == 1) {
+			return mmc_write_sector(lba, buf) ? EIO : mmc_wait_tran(lba);
+		}
+		int e = mmc_xfer_multi(lba, m, buf, true);
+		if (e) {
+			return e;
+		}
+		lba += m;
+		buf += m * (UFS_BLOCK / 4);
+		n -= m;
+	}
+	return 0;
+}
