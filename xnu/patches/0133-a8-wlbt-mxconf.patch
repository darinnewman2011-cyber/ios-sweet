+/* A bump allocator in the heap after the firmware (Linux's miframman: 4-byte aligned, here 16). */
+static uint32_t
+heap_alloc(uint32_t len)
+{
+	uint32_t at = heap_next;
+
+	heap_next = (heap_next + len + 15u) & ~15u;
+	return at;
+}
+
+static void
+stream_make(struct stream *s, uint32_t num, uint32_t size, uint8_t rbit, uint8_t wbit, int to_ap)
+{
+	s->num = num;
+	s->size = size;
+	s->buf = heap_alloc(num * size);
+	s->ridx = heap_alloc(4);
+	s->widx = heap_alloc(4);
+	s->rbit = rbit;
+	s->wbit = wbit;
+	for (uint32_t off = 0; off < num * size; off += 4) {
+		wr(shm, s->buf + off, to_ap ? 0xffffffffu : 0);
+	}
+	wr(shm, s->ridx, 0);
+	wr(shm, s->widx, 0);
+}
+
+static void
+put32(uint32_t v)
+{
+	memcpy(conf + conf_len, &v, 4);
+	conf_len += 4;
+}
+
+static void
+put_stream(const struct stream *s)
+{
+	put32(s->buf);
+	put32(s->num);
+	put32(s->size);
+	put32(s->ridx);
+	put32(s->widx);
+	conf[conf_len++] = s->rbit;
+	conf[conf_len++] = s->wbit;
+}
+
+/* Builds the configuration in the heap and returns its offset (mailbox 1). */
+static uint32_t
+mxconf_build(uint32_t runtime)
+{
+	uint32_t at;
+
+	heap_next = (runtime + 15u) & ~15u;
+	at = heap_alloc(sizeof(conf));
+	stream_make(&mgmt_in, 64, 8, 1, 0, 1);
+	stream_make(&mgmt_out, 64, 8, 1, 2, 0);
+	stream_make(&gdb4_in, 512, 4, 3, 2, 1);
+	stream_make(&gdb4_out, 512, 4, 3, 0, 0);
+	stream_make(&gdbm_in, 512, 4, 1, 4, 1);
+	stream_make(&gdbm_out, 512, 4, 5, 0, 0);
+	stream_make(&log_in, 4096, 4, 4, 6, 1);
+	memset(conf, 0, sizeof(conf));
+	conf_len = 0;
+	put32(0x79828486u);
+	put32(0u | (1u << 16));         /* major 0, minor 1 */
+	put_stream(&mgmt_in);
+	put_stream(&mgmt_out);
+	put_stream(&gdb4_in);
+	put_stream(&gdb4_out);
+	put_stream(&gdbm_in);
+	put_stream(&gdbm_out);
+	put_stream(&log_in);
+	for (uint32_t i = 0; i < sizeof(conf); i += 4) {
+		uint32_t w;
+
+		memcpy(&w, conf + i, 4);
+		wr(shm, at + i, w);
+	}
+	return at;
+}
