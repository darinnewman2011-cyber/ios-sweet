+	(void)runtime;
+	printf("SWEET A8 WLBT: %s: CTRL_NS %#x STAT %#x | INTSR0 %#x INTSR1 %#x | mbox %#x %#x %#x %#x | mgmt in w%u r%u, out "
+	    "w%u r%u, log w%u r%u, gdb4 w%u | heap words set %u | panic %08x %08x %08x %08x\n", when, rd(pmu, WIFI_CTRL_NS),
+	    rd(pmu, WIFI_STAT), rd(mbox, INTSR0), rd(mbox, INTSR1), rd(mbox, ISSR(0)), rd(mbox, ISSR(1)), rd(mbox, ISSR(2)),
+	    rd(mbox, ISSR(3)), rd(shm, mgmt_in.widx), rd(shm, mgmt_in.ridx), rd(shm, mgmt_out.widx), rd(shm, mgmt_out.ridx),
+	    rd(shm, log_in.widx), rd(shm, log_in.ridx), rd(shm, gdb4_in.widx), changed, rd(shm, panic_off), rd(shm, panic_off + 4),
+	    rd(shm, panic_off + 8), rd(shm, panic_off + 12));
+}
+
+static void
+dump_words(const char *what, uint32_t off, uint32_t words)
+{
+	for (uint32_t i = 0; i < words; i += 8) {
+		printf("SWEET A8 WLBT: %s +%03x: %08x %08x %08x %08x %08x %08x %08x %08x\n", what, i * 4, rd(shm, off + i * 4),
+		    rd(shm, off + i * 4 + 4), rd(shm, off + i * 4 + 8), rd(shm, off + i * 4 + 12), rd(shm, off + i * 4 + 16),
+		    rd(shm, off + i * 4 + 20), rd(shm, off + i * 4 + 24), rd(shm, off + i * 4 + 28));
+	}
+}
+
+static void
+final_dump(uint32_t panic_off)
+{
+	uint32_t w = rd(shm, mgmt_in.widx) % mgmt_in.num;
+	uint32_t lw = rd(shm, log_in.widx);
+
+	printf("SWEET A8 WLBT: management packets from the core: %u (MM_START_IND is channel 0, payload 0)\n", w);
+	for (uint32_t i = 0; i < w && i < 8; i++) {
+		printf("SWEET A8 WLBT: mgmt %u: %08x %08x\n", i, rd(shm, mgmt_in.buf + i * 8), rd(shm, mgmt_in.buf + i * 8 + 4));
+	}
+	printf("SWEET A8 WLBT: mxlog write index %u\n", lw);
+	dump_words("mxlog", log_in.buf, lw > 0 && lw < 64 ? ((lw + 7u) & ~7u) : 64);
+	dump_words("panic record", panic_off, 56);
 }
 
