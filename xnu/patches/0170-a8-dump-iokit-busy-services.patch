 #define A80211_SIOCGA     0xc02869c9u
 #define A80211_SIOCSA     0x802869c8u
 
+/*
+ * xnu 0170: which IOServices keep IOKit busy. SystemConfiguration's __wait_for_IOKit_to_quiesce (behind
+ * SCNetworkInterfaceCopyAll) waits for configd's InterfaceNamer to see IOKit quiet; wifid hangs there on the A8.
+ * Printed with the test-reboot backtraces: the root's busy state and every service still busy.
+ */
+extern "C" void sweet_dump_iokit_busy(void);
+extern "C" void
+sweet_dump_iokit_busy(void)
+{
+	IOService *root = IOService::getServiceRoot();
+	IORegistryIterator *it = IORegistryIterator::iterateOver(gIOServicePlane, kIORegistryIterateRecursively);
+	int shown = 0, busy = 0;
+
+	IOLog("SWEET BUSY: root busy %u\n", root ? root->getBusyState() : 0xffffffffu);
+	if (it == NULL) {
+		return;
+	}
+	OSObject *o;
+	while ((o = it->getNextObject()) != NULL) {
+		IOService *svc = OSDynamicCast(IOService, o);
+		if (svc == NULL || svc->getBusyState() == 0) {
+			continue;
+		}
+		busy++;
+		if (shown < 40) {
+			shown++;
+			IOLog("SWEET BUSY: %s (%s) busy %u%s\n", svc->getName(), svc->getMetaClass()->getClassName(),
+			    svc->getBusyState(), svc->isInactive() ? " inactive" : "");
+		}
+	}
+	it->release();
+	IOLog("SWEET BUSY: %d busy services\n", busy);
+}
+
 /* Called from the Wi-Fi service thread once the radio's WLAN service runs: lets the personality below match. */
 extern "C" void
 sweet_a80211_ready(void)
