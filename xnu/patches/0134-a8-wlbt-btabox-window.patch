diff --git a/bsd/dev/sweet_a8wlbt.c b/bsd/dev/sweet_a8wlbt.c
--- a/bsd/dev/sweet_a8wlbt.c
+++ b/bsd/dev/sweet_a8wlbt.c
@@ -68,6 +68,10 @@
 #define CENTRAL_SEQ_ST  0x384u
 #define MEM_CONFIG0     0x7300u
 #define MEM_CONFIG1     0x7304u
+#define MEM_CONFIG2     0x7308u         /* BAAW1 size >> 12 (BT-ABOX shared memory) */
+#define MEM_CONFIG3     0x730cu         /* BAAW1 base >> 12 */
+#define BTABOX_PA       0xa0000000u     /* low-bank RAM XNU never uses (it runs from 0x880000000) */
+#define BTABOX_SIZE     0x400000u       /* the DT's btabox_rmem size */
 #define BOOT_RST_CFG    0x7330u
