diff --git a/bsd/dev/sweet_k88input.c b/bsd/dev/sweet_k88input.c
new file mode 100644
index 0000000..fdbd54e
--- /dev/null
+++ b/bsd/dev/sweet_k88input.c
@@ -0,0 +1,358 @@
+/*
+ * ZTE K88 (MSM8952) input, polled: volume keys on TLMM GPIOs and the Goodix
+ * GT928 touch controller on BLSP1 QUP3 I2C. Both feed the HID services in
+ * iokit/Kernel/arm/hid/SweetHID.cpp, as sweet_a8input.c does on the A8.
+ * Verified with shim/k88 diag12 (2026-11-14): the GT928 answers at 0x5d
+ * without a reset or regulator work after LK, product "928", firmware
+ * 0x1081, touch space 800x1280 = the panel.
+ *
+ * Keys: volume up GPIO 85, volume down GPIO 90, active low with pull-ups.
+ * Both volume keys together = Home. Power is on the PMIC (PON), not here yet.
+ *
+ * The QUP is driven like Linux i2c-qup's v1 path (facts only): 16-bit tag
+ * words (START | address, DATA, STOP, REC | count), FIFO mode, a write
+ * message ends with STOP, then a read message. Polled, no interrupt.
+ */
+#if defined(SWEET_K88)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_k88_input_init(void);
+
+#define TLMM_PA         0x01000000u
+#define TLMM_SIZE       0x00100000u     /* GPIOs 0-...: one 4 KiB page each, up to GPIO 90 needed */
+#define QUP_PA          0x078b7000u
+#define GCC_PA          0x01800000u
+#define GCC_BLSP1_AHB_VOTE      0x45004u        /* APCS clock branch vote, bit 10 */
+#define GCC_QUP3_I2C_CBCR       0x04020u
+
+#define GPIO_VOLUP      85
+#define GPIO_VOLDOWN    90
+#define GT_ADDR         0x5du
+#define GT_STATUS       0x814eu
+#define GT_POINTS       0x814fu
+#define GT_MAX          10
+
+static vm_offset_t tlmm, qup, gcc;
+static int k88_sleep_chan;
+
+static uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&k88_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* TLMM config: pull [1:0] (3 = up), function [5:2], drive [8:6] (mA / 2 - 1), output enable 9 */
+static void
+gpio_cfg(unsigned n, unsigned func, unsigned pull, unsigned ma)
+{
+	wr(tlmm, n * 0x1000u, pull | (func << 2) | (((ma / 2) - 1) << 6));
+}
+
+static int
+gpio_get(unsigned n)
+{
+	return rd(tlmm, n * 0x1000u + 4) & 1;
+}
+
+/* ---- QUP I2C ---- */
+
+#define QUP_CONFIG      0x000u
+#define QUP_STATE       0x004u
+#define QUP_IO_MODE     0x008u
+#define QUP_SW_RESET    0x00cu
+#define QUP_OPERATIONAL 0x018u
+#define QUP_ERR_EN      0x020u
+#define QUP_OUT_FIFO    0x110u
+#define QUP_MX_WRITE    0x150u
+#define QUP_MX_READ     0x208u
+#define QUP_IN_FIFO     0x218u
+#define QUP_I2C_CLK     0x400u
+#define QUP_I2C_STATUS  0x404u
+#define OP_IN_NOT_EMPTY         (1u << 5)
+#define OP_MAX_OUTPUT_DONE      (1u << 10)
+#define I2C_ERRORS              0x1cu   /* bus error, NACK, arbitration lost */
+
+static uint32_t qup_err;
+
+static int
+qup_state(uint32_t st)
+{
+	for (int i = 0; i < 1000 && !(rd(qup, QUP_STATE) & 4); i++) {
+		delay(10);
+	}
+	wr(qup, QUP_STATE, st);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t s = rd(qup, QUP_STATE);
+		if ((s & 4) && (s & 3) == st) {
+			return 0;
+		}
+		delay(10);
+	}
+	return EIO;
+}
+
+static int
+qup_init(void)
+{
+	wr(gcc, GCC_BLSP1_AHB_VOTE, rd(gcc, GCC_BLSP1_AHB_VOTE) | (1u << 10));
+	wr(gcc, GCC_QUP3_I2C_CBCR, rd(gcc, GCC_QUP3_I2C_CBCR) | 1);
+	delay(2000);
+	gpio_cfg(10, 3, 0, 2);          /* BLSP1 I2C3 SDA/SCL */
+	gpio_cfg(11, 3, 0, 2);
+	wr(qup, QUP_SW_RESET, 1);
+	delay(2000);
+	if (qup_state(0)) {
+		return EIO;
+	}
+	wr(qup, QUP_CONFIG, (2u << 8) | 0xf);                   /* I2C mini core, 16-bit words */
+	wr(qup, QUP_IO_MODE, (rd(qup, QUP_IO_MODE) & ~0x3c00u) | (3u << 14)); /* FIFO, repack */
+	wr(qup, QUP_ERR_EN, 0);
+	wr(qup, QUP_I2C_CLK, (3u << 8) | (19200000 / 400000 / 2 - 3));       /* 400 kHz */
+	return 0;
+}
+
+static int
+qup_wait(uint32_t opbit)
+{
+	for (int i = 0; i < 2000; i++) {
+		uint32_t op = rd(qup, QUP_OPERATIONAL), st = rd(qup, QUP_I2C_STATUS);
+		if (st & I2C_ERRORS) {
+			qup_err = st;
+			return EIO;
+		}
+		if (op & opbit) {
+			return 0;
+		}
+		delay(10);
+	}
+	qup_err = 0xdead;
+	return ETIMEDOUT;
+}
+
+static int
+qup_write(uint8_t addr, const uint8_t *buf, unsigned len)
+{
+	uint32_t val = 0;
+	unsigned w = 0;
+
+	if (qup_state(0)) {
+		return EIO;
+	}
+	wr(qup, QUP_MX_WRITE, len + 1);
+	wr(qup, QUP_MX_READ, 0);
+	if (qup_state(1)) {
+		return EIO;
+	}
+	for (unsigned i = 0; i <= len; i++) {
+		uint32_t t = i == 0 ? (0x100u | (uint32_t)(addr << 1)) :
+		    ((i == len ? 0x300u : 0x200u) | buf[i - 1]);
+		if (w & 1) {
+			wr(qup, QUP_OUT_FIFO, val | (t << 16));
+		} else {
+			val = t;
+		}
+		w++;
+	}
+	if (w & 1) {
+		wr(qup, QUP_OUT_FIFO, val);
+	}
+	int r = qup_wait(OP_MAX_OUTPUT_DONE);
+	wr(qup, QUP_OPERATIONAL, rd(qup, QUP_OPERATIONAL));
+	return r;
+}
+
+static int
+qup_read(uint8_t addr, uint8_t *buf, unsigned len)
+{
+	if (qup_state(0)) {
+		return EIO;
+	}
+	wr(qup, QUP_MX_WRITE, 2);
+	wr(qup, QUP_MX_READ, len);
+	if (qup_state(1)) {
+		return EIO;
+	}
+	wr(qup, QUP_OUT_FIFO, ((0x400u | len) << 16) | 0x100u | (uint32_t)((addr << 1) | 1));
+	for (unsigned i = 0; i < len;) {
+		int r = qup_wait(OP_IN_NOT_EMPTY);
+		if (r) {
+			return r;
+		}
+		uint32_t v = rd(qup, QUP_IN_FIFO);
+		buf[i++] = v & 0xff;
+		if (i < len) {
+			buf[i++] = (v >> 16) & 0xff;
+		}
+	}
+	wr(qup, QUP_OPERATIONAL, rd(qup, QUP_OPERATIONAL));
+	return 0;
+}
+
+static int
+gt_read(uint16_t reg, uint8_t *buf, unsigned len)
+{
+	uint8_t a[2] = { (uint8_t)(reg >> 8), (uint8_t)reg };
+	int r = qup_write(GT_ADDR, a, 2);
+	return r ? r : qup_read(GT_ADDR, buf, len);
+}
+
+static int
+gt_write8(uint16_t reg, uint8_t v)
+{
+	uint8_t a[3] = { (uint8_t)(reg >> 8), (uint8_t)reg, v };
+	return qup_write(GT_ADDR, a, 3);
+}
+
+/* ---- polling ---- */
+
+enum { KEY_POWER = 0, KEY_VOLUP = 1, KEY_VOLDOWN = 2, KEY_HOME = 3 };
+
+static void
+keys_poll(int state[4])
+{
+	int now[3] = { 0, !gpio_get(GPIO_VOLUP), !gpio_get(GPIO_VOLDOWN) };
+
+	for (int k = 1; k < 3; k++) {
+		if (now[k] != state[k]) {
+			state[k] = now[k];
+			printf("SWEET K88 KEYS: key=%d down=%d\n", k, now[k]);
+			sweet_hid_key(k, now[k]);
+		}
+	}
+	int home = state[KEY_VOLUP] && state[KEY_VOLDOWN];
+	if (home != state[KEY_HOME]) {
+		state[KEY_HOME] = home;
+		printf("SWEET K88 KEYS: home down=%d\n", home);
+		sweet_hid_key(KEY_HOME, home);
+	}
+}
+
+static uint32_t touch_errors;
+
+static void
+touch_poll(uint32_t *down_mask)
+{
+	uint8_t st = 0, pts[GT_MAX * 8];
+	uint32_t now = 0;
+
+	int r = gt_read(GT_STATUS, &st, 1);
+	if (r == 0 && !(st & 0x80)) {
+		return;                         /* no new data */
+	}
+	unsigned n = st & 0xf;
+	if (r == 0 && n > GT_MAX) {
+		n = 0;
+	}
+	if (r == 0 && n) {
+		r = gt_read(GT_POINTS, pts, n * 8);
+	}
+	if (r == 0) {
+		for (unsigned i = 0; i < n; i++) {
+			const uint8_t *p = pts + i * 8;
+			int id = p[0] & 0xf;
+			int x = p[1] | p[2] << 8, y = p[3] | p[4] << 8;
+			if (id >= GT_MAX) {
+				continue;
+			}
+			now |= 1u << id;
+			sweet_hid_touch(id, 1, x, y);
+		}
+		for (int id = 0; id < GT_MAX; id++) {
+			if ((*down_mask & ~now) & (1u << id)) {
+				sweet_hid_touch(id, 0, 0, 0);
+			}
+		}
+		*down_mask = now;
+	}
+	(void)gt_write8(GT_STATUS, 0);
+	if (r && (touch_errors++ % 200u) == 0) {
+		printf("SWEET K88 TOUCH: read error %d (i2c status %#x)\n", r, qup_err);
+		(void)qup_init();
+	}
+}
+
+static void
+k88_input_thread(void *arg, wait_result_t result)
+{
+	int keys[4] = { 0, 0, 0, 0 };
+	uint32_t fingers = 0;
+	int touch = 1;
+	uint8_t id[6] = { 0 }, res[4] = { 0 };
+	(void)arg;
+	(void)result;
+
+	gpio_cfg(GPIO_VOLUP, 0, 3, 2);
+	gpio_cfg(GPIO_VOLDOWN, 0, 3, 2);
+	(void)PE_parse_boot_argn("sweettouch", &touch, sizeof(touch));
+	bool ts_ok = false;
+	if (touch && qup_init() == 0 && gt_read(0x8140, id, 6) == 0 && gt_read(0x8048, res, 4) == 0) {
+		ts_ok = true;
+		printf("SWEET K88 TOUCH: Goodix %c%c%c%c firmware %#x, %ux%u\n", id[0], id[1], id[2],
+		    id[3] ? id[3] : ' ', id[4] | id[5] << 8, res[0] | res[1] << 8, res[2] | res[3] << 8);
+	} else {
+		printf("SWEET K88 TOUCH: off (sweettouch=%d, i2c status %#x)\n", touch, qup_err);
+	}
+	printf("SWEET K88 KEYS: volume up %d, volume down %d (1 = released)\n",
+	    gpio_get(GPIO_VOLUP), gpio_get(GPIO_VOLDOWN));
+	for (;;) {
+		keys_poll(keys);
+		if (ts_ok) {
+			touch_poll(&fingers);
+		}
+		sleep_ms(10);
+	}
+}
+
+void
+sweet_k88_input_init(void)
+{
+	int keys = 1;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("sweetkeys", &keys, sizeof(keys));
+	if (!keys) {
+		printf("SWEET K88 KEYS: input disabled (sweetkeys=0)\n");
+		return;
+	}
+	tlmm = ml_io_map(TLMM_PA, TLMM_SIZE);
+	qup = ml_io_map(QUP_PA, 0x1000);
+	gcc = ml_io_map(GCC_PA, 0x80000);
+	if (!tlmm || !qup || !gcc) {
+		printf("SWEET K88 KEYS: MMIO mapping failed\n");
+		return;
+	}
+	if (kernel_thread_start(k88_input_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* SWEET_K88 */
