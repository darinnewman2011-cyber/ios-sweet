+/*
+ * Partition sector of file sector lba, UINT64_MAX for a hole or an unwritten
+ * extent; *n = sectors (<= count) that continue the same way.
+ */
+static uint64_t
+file_extent(uint64_t lba, uint32_t count, uint32_t *n)
+{
+	uint32_t spb = xf.bsz / UFS_BLOCK;
+	uint64_t fblk = lba / spb;
+	uint32_t lo = 0, hi = xf.nrun;
+
+	/* last run with fblk >= run.fblk */
+	while (lo < hi) {
+		uint32_t mid = (lo + hi) / 2;
+		if (xf.run[mid].fblk <= fblk) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	const struct ext4_run *r = lo ? &xf.run[lo - 1] : NULL;
+	if (r && fblk < (uint64_t)r->fblk + r->len) {
+		uint64_t end = ((uint64_t)r->fblk + r->len) * spb;
+		*n = (uint32_t)MIN(count, end - lba);
+		return r->pblk == UINT64_MAX ? UINT64_MAX : (r->pblk + (fblk - r->fblk)) * spb + lba % spb;
+	}
+	/* hole up to the next run */
+	uint64_t end = lo < xf.nrun ? (uint64_t)xf.run[lo].fblk * spb : UINT64_MAX;
+	*n = (uint32_t)MIN(count, end - lba);
+	return UINT64_MAX;
+}
+
+/*
+ * Writing the root file in place is safe only if every block of it is an
+ * initialized extent: then each write lands in a block ext4 already gave the
+ * file, and nothing else on USERDATA can be touched. A sparse image (holes,
+ * fallocate's unwritten extents) stays on the RAM overlay instead.
+ */
+static bool
+file_fully_written(void)
+{
+	uint64_t next = 0;
+
+	for (uint32_t i = 0; i < xf.nrun; i++) {
+		if (xf.run[i].fblk != next || xf.run[i].pblk == UINT64_MAX) {
+			printf("SWEET ROOT: not fully written at file block %llu (run %u)\n", next, i);
+			return false;
+		}
+		next += xf.run[i].len;
+	}
+	if (next * xf.bsz < xf.size) {
+		printf("SWEET ROOT: extents end at block %llu, file has %llu bytes\n", next, xf.size);
+		return false;
+	}
+	return true;
+}
+
+/* count 512-byte sectors from the bounce buffer to file sector lba. */
+static int
+file_write_blocks(uint64_t lba, uint32_t count)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+
+	if (count > BOUNCE_SIZE / UFS_BLOCK || lba + count > su.nblocks) {
+		return EINVAL;
+	}
+	while (count) {
+		uint32_t n;
+		uint64_t pba = file_extent(lba, count, &n);
+		if (pba == UINT64_MAX) {
+			printf("SWEET ROOT: no block behind file sector 0x%llx, refusing write\n", lba);
+			return EIO;
+		}
+		for (uint32_t i = 0; i < n; i++) {
+			int error = mmc_write_sector(su.first_block + pba + i,
+			    (const uint32_t *)(const void *)(b + i * UFS_BLOCK));
+			if (error) {
+				return error;
+			}
+		}
+		b += n * UFS_BLOCK;
+		lba += n;
+		count -= n;
+	}
+	return 0;
+}
