+/* R1 error bits: everything in 31..19 except CARD_IS_LOCKED (25). */
+#define R1_ERRORS       0xfdf80000u
+#define R1_STATE(r)     (((r) >> 9) & 0xf)
+#define R1_READY        (1u << 8)
+
+/* After a write or an R1b command: DAT0 released, then CMD13 until TRAN and ready. */
+static int
+mmc_wait_tran(uint64_t lba)
+{
+	uint32_t st, resp = 0;
+
+	if (!mmc_wait(MMC_STATUS, STATUS_BUSY, 0, MMC_DATA_NS)) {
+		printf("SWEET MMC: 0x%llx: card still busy\n", lba);
+		return ETIMEDOUT;
+	}
+	for (int i = 0; i < 1000; i++) {
+		st = mmc_cmd(13, MMC_RCA << 16, CMD_RESP_EXP | CMD_RESP_CRC, &resp);
+		if (st != UINT32_MAX && !(st & INT_ERROR)) {
+			if (resp & R1_ERRORS) {
+				printf("SWEET MMC: 0x%llx: card status 0x%x\n", lba, resp);
+				return EIO;
+			}
+			if (R1_STATE(resp) == 4 && (resp & R1_READY)) {
+				return 0;
+			}
+		}
+		delay(10);
+	}
+	printf("SWEET MMC: 0x%llx: card not back in TRAN, r1 0x%x\n", lba, resp);
+	return ETIMEDOUT;
+}
+
+/* CMD24: one 512-byte sector from src (4-byte aligned), only inside [mmc_wr_lo, mmc_wr_hi). */
+static int
+mmc_write_sector(uint64_t lba, const uint32_t *src)
+{
+	uint32_t st, resp = 0, n = 0;
+	uint64_t deadline;
+
+	if (lba < mmc_wr_lo || lba >= mmc_wr_hi || lba > UINT32_MAX) {
+		printf("SWEET MMC: refusing write at 0x%llx (writable 0x%llx-0x%llx)\n", lba, mmc_wr_lo, mmc_wr_hi);
+		return EPERM;
+	}
+	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) | CTRL_FIFO_RESET);
+	(void)mmc_wait(MMC_CTRL, CTRL_FIFO_RESET, 0, 10 * NSEC_PER_MSEC);
+	ufs_wr(MMC_BLKSIZ, 512);
+	ufs_wr(MMC_BYTCNT, 512);
+	st = mmc_cmd(24, (uint32_t)lba,
+	    CMD_RESP_EXP | CMD_RESP_CRC | CMD_DAT_EXP | CMD_READ_WRITE | CMD_PRV_DAT_WAIT, &resp);
+	if (st == UINT32_MAX || (st & INT_ERROR) || (resp & R1_ERRORS)) {
+		printf("SWEET MMC: CMD24 0x%llx: rintsts 0x%x r1 0x%x\n", lba, st, resp);
+		return EIO;
+	}
+	nanoseconds_to_absolutetime(MMC_DATA_NS, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		uint32_t r = ufs_rd(MMC_RINTSTS);
+
+		/* A 64-bit FIFO takes whole 64-bit entries (Linux dw_mmc: writeq). */
+		while (n < 128 && !(ufs_rd(MMC_STATUS) & STATUS_FIFO_FULL)) {
+			if (mmc_fifo64) {
+				*(volatile uint64_t *)(su.regs + MMC_FIFO) = ((uint64_t)src[n + 1] << 32) | src[n];
+				n += 2;
+			} else {
+				ufs_wr(MMC_FIFO, src[n++]);
+			}
+		}
+		ufs_wr(MMC_RINTSTS, INT_TXDR);
+		if (r & INT_ERROR) {
+			printf("SWEET MMC: write 0x%llx: rintsts 0x%x after %u words\n", lba, r, n);
+			return EIO;
+		}
+		if ((r & INT_DATA_OVER) && n >= 128) {
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET MMC: write 0x%llx timed out: rintsts 0x%x, %u words\n", lba, r, n);
+			return ETIMEDOUT;
+		}
+	}
+	return mmc_wait_tran(lba);
+}
