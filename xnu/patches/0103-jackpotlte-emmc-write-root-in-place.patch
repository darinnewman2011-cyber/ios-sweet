+/* CMD6 SWITCH EXT_CSD[32] FLUSH_CACHE = 1 (R1b); harmless if the cache is off. */
 static int
 ufs_sync_cache(void)
 {
+	static bool logged;
+	uint32_t resp = 0, st;
+
+	if (!mmc_wr_hi) {
+		return 0;
+	}
+	st = mmc_cmd(6, (3u << 24) | (32u << 16) | (1u << 8), CMD_RESP_EXP | CMD_RESP_CRC, &resp);
+	int error = (st == UINT32_MAX || (st & INT_ERROR)) ? EIO : mmc_wait_tran(0);
+	if (error && !logged) {
+		printf("SWEET MMC: cache flush failed (rintsts 0x%x r1 0x%x), ignoring\n", st, resp);
+		logged = true;
+	}
 	return 0;
 }
 
