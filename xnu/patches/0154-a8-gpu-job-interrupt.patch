+ * xnu 0154: hand an SPI to a kernel handler. Level-triggered (GICD_ICFGR bit 2n+1 clear), priority 0xA0 like
+ * the timer and the IPI, routed to CPU 0's interface, then enabled. The secure firmware already put Android's
+ * SPIs in Group 1. The handler runs in sleh_irq() before the EOI and must quiet the device (mask or clear).
+ */
+int
+sweet_gic_enable_spi(uint32_t intid, void (*fn)(void *arg), void *arg)
+{
+	if (intid < 32 || intid >= SWEET_SPI_TABLE || fn == NULL || !gicd_base) {
+		return -1;
