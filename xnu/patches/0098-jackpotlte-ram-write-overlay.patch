+	}
+#endif
 	for (uint32_t done = 0; done < count;) {
 		uint64_t pos = off + done;
 		uint64_t lba = pos / UFS_BLOCK;
@@ -850,6 +985,9 @@ sweet_ufs_strategy(buf_t bp)
 			error = root_read_blocks(lba, blocks);
 			if (!error) {
 				memcpy(vaddr + done, (const char *)bounce + skip, want);
+#if defined(SWEET_JACKPOTLTE)
+				ovl_patch(pos, vaddr + done, want);
+#endif
 			}
 		} else {
 			/* Partial device blocks at either end: read, merge, write back. */
@@ -1084,7 +1222,7 @@ sweet_ufs_init(void)
 	if (rw) {
 		printf("SWEET MMC: ufsrw ignored, eMMC writes are not implemented\n");
 	}
-	su.writable = false;
+	su.writable = ovl_init();
 #else
 	su.writable = (rw != 0);
 #endif
@@ -1233,6 +1371,9 @@ sweet_log_start(void)
 	thread_t thread;
 
 	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
