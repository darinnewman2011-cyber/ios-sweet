@@ -298,6 +303,163 @@ ufs_sync_cache(void)
 	static const uint8_t cdb[10] = { 0x35 };       /* SYNCHRONIZE CACHE(10), whole LUN */
 	return ufs_scsi(cdb, sizeof(cdb), 0, false);
 }
+#else /* SWEET_JACKPOTLTE */
+/*
+ * Galaxy A8 (2018): eMMC on the Exynos 7885 DW-MSHC (v2.70a). S-Boot leaves
+ * the controller and the card ready (shim/a8 milestone 3, verified on the
+ * phone): PIO, DDR52 8-bit, card selected at RCA 1 in TRAN state, Samsung
+ * protector (SMU) in bypass. Like the shim, this reuses that state and reads
+ * polled single sectors (CMD17) through the FIFO. "Device blocks" are 512-byte
+ * sectors here (the eMMC GPT uses them too). No writes yet.
+ */
+#define MMC_CTRL        0x000
+#define CTRL_FIFO_RESET         (1u << 1)
+#define CTRL_DMA_ENABLE         (1u << 5)
+#define CTRL_USE_IDMAC          (1u << 25)
+#define MMC_BLKSIZ      0x01c
+#define MMC_BYTCNT      0x020
+#define MMC_CMDARG      0x028
+#define MMC_CMD         0x02c
+#define CMD_START               (1u << 31)
+#define CMD_USE_HOLD_REG        (1u << 29)      /* Samsung: when CLKSEL drive phase != 0 */
+#define CMD_PRV_DAT_WAIT        (1u << 13)
+#define CMD_DAT_EXP             (1u << 9)
+#define CMD_RESP_CRC            (1u << 8)
+#define CMD_RESP_EXP            (1u << 6)
+#define MMC_RESP0       0x030
+#define MMC_RINTSTS     0x044
+#define INT_RXDR                (1u << 5)
+#define INT_DATA_OVER           (1u << 3)
+#define INT_CMD_DONE            (1u << 2)
+#define INT_ERROR               0xbfc2u         /* SDMMC_INT_ERROR */
+#define MMC_STATUS      0x048
+#define STATUS_BUSY             (1u << 9)
+#define STATUS_FCNT(s)          (((s) >> 17) & 0x1fff)
+#define MMC_HCON        0x070
+#define MMC_BMOD        0x080
+#define BMOD_IDMAC_ENABLE       (1u << 7)
+#define MMC_CLKSEL      0x0a4
+#define MMC_FIFO        0x200                   /* 64-bit entries, read as two words */
+
+#define MMC_RCA         1u                      /* S-Boot's, verified by milestone 3 */
+#define MMC_CMD_NS      (100ull * NSEC_PER_MSEC)
+#define MMC_DATA_NS     (500ull * NSEC_PER_MSEC)
+
+static uint32_t mmc_hold;                       /* CMD_USE_HOLD_REG or 0 */
+static bool mmc_fifo64;
+
+/* Wait until (reg & mask) == want; false on timeout. */
+static bool
+mmc_wait(uint32_t r, uint32_t mask, uint32_t want, uint64_t ns)
+{
+	uint64_t deadline;
+
+	nanoseconds_to_absolutetime(ns, &deadline);
+	deadline += mach_absolute_time();
+	while ((ufs_rd(r) & mask) != want) {
+		if (mach_absolute_time() > deadline) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* One command; returns RINTSTS, or UINT32_MAX if the CIU never took it. */
+static uint32_t
+mmc_cmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t *resp)
+{
+	(void)mmc_wait(MMC_STATUS, STATUS_BUSY, 0, MMC_CMD_NS);
+	ufs_wr(MMC_RINTSTS, 0xffffffff);
+	ufs_wr(MMC_CMDARG, arg);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ufs_wr(MMC_CMD, CMD_START | mmc_hold | flags | idx);
+	if (!mmc_wait(MMC_CMD, CMD_START, 0, 10 * NSEC_PER_MSEC)) {
+		return UINT32_MAX;
+	}
+	(void)mmc_wait(MMC_RINTSTS, INT_CMD_DONE, INT_CMD_DONE, MMC_CMD_NS);
+	*resp = ufs_rd(MMC_RESP0);
+	return ufs_rd(MMC_RINTSTS);
+}
+
+/* CMD17: one 512-byte sector into dst (4-byte aligned). */
+static int
+mmc_read_sector(uint64_t lba, uint32_t *dst)
+{
+	uint32_t st, resp = 0, n = 0;
+	uint64_t deadline;
+
+	if (lba > UINT32_MAX) {
+		return EINVAL;
+	}
+	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) | CTRL_FIFO_RESET);
+	(void)mmc_wait(MMC_CTRL, CTRL_FIFO_RESET, 0, 10 * NSEC_PER_MSEC);
+	ufs_wr(MMC_BLKSIZ, 512);
+	ufs_wr(MMC_BYTCNT, 512);
+	st = mmc_cmd(17, (uint32_t)lba, CMD_RESP_EXP | CMD_RESP_CRC | CMD_DAT_EXP | CMD_PRV_DAT_WAIT, &resp);
+	if (st == UINT32_MAX || (st & INT_ERROR)) {
+		printf("SWEET MMC: CMD17 0x%llx: rintsts 0x%x r1 0x%x\n", lba, st, resp);
+		return EIO;
+	}
+	nanoseconds_to_absolutetime(MMC_DATA_NS, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		uint32_t s = ufs_rd(MMC_STATUS), r = ufs_rd(MMC_RINTSTS);
+
+		/* FIFO count is in host-data-width entries (HCON[9:7] 2 = 64-bit) */
+		for (uint32_t c = STATUS_FCNT(s); c && n < 128; c--) {
+			dst[n++] = ufs_rd(MMC_FIFO);
+			if (mmc_fifo64) {
+				dst[n++] = ufs_rd(MMC_FIFO + 4);
+			}
+		}
+		ufs_wr(MMC_RINTSTS, INT_RXDR);
+		if (r & INT_ERROR) {
+			printf("SWEET MMC: read 0x%llx: rintsts 0x%x after %u words\n", lba, r, n);
+			return EIO;
+		}
+		if ((r & INT_DATA_OVER) && n >= 128) {
+			return 0;
+		}
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET MMC: read 0x%llx timed out: rintsts 0x%x status 0x%x, %u words\n",
+			    lba, r, s, n);
+			return ETIMEDOUT;
+		}
+	}
+}
+
+/* count sectors at lba into the bounce buffer. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	uint32_t *b = (uint32_t *)(su.dma + DMA_BOUNCE);
+
+	if (count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		int error = mmc_read_sector(lba + i, b + i * (UFS_BLOCK / 4));
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
+}
+
+/* Not implemented: su.writable is never set on the A8, so this is unreachable. */
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	printf("SWEET MMC: refusing write of %u blocks at 0x%llx\n", count, lba);
+	return EROFS;
+}
+
+static int
+ufs_sync_cache(void)
+{
+	return 0;
+}
+#endif /* SWEET_JACKPOTLTE */
 
 static int
 ufs_find_partition(const char *want)
@@ -353,6 +515,7 @@ ufs_find_partition(const char *want)
 	return ENOENT;
 }
 
+#if !defined(SWEET_JACKPOTLTE)
 static int
 ufs_take_over_host(void)
 {
@@ -386,6 +549,28 @@ ufs_take_over_host(void)
 	}
 	return 0;
 }
+#else /* SWEET_JACKPOTLTE */
+static int
+ufs_take_over_host(void)
+{
+	uint32_t resp = 0, st;
+
+	if ((ufs_rd(MMC_CLKSEL) >> 16) & 7) {
+		mmc_hold = CMD_USE_HOLD_REG;
+	}
+	mmc_fifo64 = ((ufs_rd(MMC_HCON) >> 7) & 7) == 2;
+	/* PIO: the CPU drains the FIFO, no IDMAC descriptors */
+	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) & ~(CTRL_USE_IDMAC | CTRL_DMA_ENABLE));
+	ufs_wr(MMC_BMOD, ufs_rd(MMC_BMOD) & ~BMOD_IDMAC_ENABLE);
+	st = mmc_cmd(13, MMC_RCA << 16, CMD_RESP_EXP | CMD_RESP_CRC, &resp);
+	if (st == UINT32_MAX || (st & INT_ERROR) || ((resp >> 9) & 0xf) != 4) {
+		printf("SWEET MMC: card not in TRAN at RCA %u (rintsts 0x%x r1 0x%x)\n",
+		    MMC_RCA, st, resp);
+		return ENXIO;
+	}
+	return 0;
+}
+#endif /* SWEET_JACKPOTLTE */
 
