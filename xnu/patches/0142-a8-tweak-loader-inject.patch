 			sweet_inject_name[0] = 0;
 		}
+		if (!PE_parse_boot_argn("sweettweaks", &sweet_tweaks, sizeof(sweet_tweaks))) {
+			sweet_tweaks = 0;
+		}
 		sweet_inject_read = 1;
 	}
-	if (sweet_inject_name[0] == 0 || imgp->ip_ndp == NULL) {
-		return false;
+	if (sweet_inject_name[0] != 0 && imgp->ip_ndp != NULL) {
+		namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+		gl = namelen != 0 && namelen == strnlen(sweet_inject_name, sizeof(sweet_inject_name)) &&
+		    strncmp(imgp->ip_ndp->ni_cnd.cn_nameptr, sweet_inject_name, namelen) == 0;
 	}
-	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
-	if (namelen == 0 || namelen != strnlen(sweet_inject_name, sizeof(sweet_inject_name)) ||
-	    strncmp(imgp->ip_ndp->ni_cnd.cn_nameptr, sweet_inject_name, namelen) != 0) {
+	tweak = sweet_tweak_wanted(imgp);
+	if (!gl && !tweak) {
 		return false;
 	}
-	strlcpy(env, "DYLD_INSERT_LIBRARIES=" SWEET_INJECT_LIBRARY, size);
-	if (sweet_inject_count++ < 8) {
+	strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	if (gl) {
+		strlcat(env, SWEET_INJECT_LIBRARY, size);
+	}
+	if (tweak) {
+		strlcat(env, gl ? ":" SWEET_TWEAK_LIBRARY : SWEET_TWEAK_LIBRARY, size);
+	}
+	if (gl && sweet_inject_count++ < 8) {
 		printf("SWEET INJECT: %s started with %s\n", sweet_inject_name, env);
 	}
 	return true;
