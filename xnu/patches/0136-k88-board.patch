+#define SWEET_FB_PA               0x83400000
+#define SWEET_FB_WIDTH            800
+#define SWEET_FB_HEIGHT           1280
+#elif defined(SWEET_JACKPOTLTE)
 #define SWEET_FB_PA               0xEC000000      // S-Boot, 0x1400000 reserved
 #define SWEET_FB_WIDTH            1080
 #define SWEET_FB_HEIGHT           2220
@@ -99,7 +117,9 @@
  * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
  * (CNTV) is INTID 16 + 3 = 19.
  */
-#if defined(SWEET_JACKPOTLTE)
