+#define SWEET_VTIMER_INTID        20      // MSM8952 DT PPI 4 (shim/k88: verified)
+#elif defined(SWEET_JACKPOTLTE)
 #define SWEET_VTIMER_INTID        27      // standard PPI 11 (Exynos 7885 DT)
 #else
 #define SWEET_VTIMER_INTID        19
