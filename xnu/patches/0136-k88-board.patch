 /*
  * Exynos 7885: A53 MPIDRs 0x100-0x103 and 0x200-0x201, A73 0x0/0x1 (Aff0 =
  * core, Aff1 = cluster). S-Boot enters the kernel on 0x100, the ADT's cpu0.
@@ -44,7 +52,17 @@
  * Bootloader splash framebuffer used by the early console (sweet_early.c,
  * start.s): a8r8g8b8, physical, L2-block aligned. Only the first buffer.
  */
-#if defined(SWEET_JACKPOTLTE)
