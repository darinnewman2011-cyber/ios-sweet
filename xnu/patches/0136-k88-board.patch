@@ -25,7 +25,15 @@
  */
 #define SWEET_SMP_MAX_CPUS         8
 
-#if defined(SWEET_JACKPOTLTE)
+#if defined(SWEET_K88)
+/*
+ * ZTE K88 (MSM8952): two clusters of four Cortex-A53, MPIDRs 0x100-0x103 and
+ * 0x0-0x3. LK enters on 0x100 (shim/k88, 2026-11-13), the ADT's cpu0.
+ */
+#define SWEET_BOOT_MPIDR          0x100
+#define SWEET_MPIDR_VALID(m)      ((m) <= 0x3 || ((m) >= 0x100 && (m) <= 0x103))
+#define SWEET_CPU_NAME            "MSM8952"
