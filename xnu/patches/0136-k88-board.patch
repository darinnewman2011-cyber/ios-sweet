diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index b0b8907..b320302 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1961,9 +1961,28 @@ sweet_ufs_rootdev(dev_t *dev)
  * SEC_POWER_RESET, INFORM3 SEC_RESET_REASON_RECOVERY) and resets the SoC,
  * so S-Boot starts TWRP (verified with the shim on 2026-11-02).
  */
+#if defined(SWEET_K88)
+/*
+ * ZTE K88 (verified with shim/k88 on 2026-11-13): TWRP's ramoops console zone
+ * is at 0x9FDFE000 (1 MiB, ecc 0) and shows up as console-ramoops-0. LK writes
+ * its own log over the first few KiB of that zone on every boot, so the text
+ * starts K88_OOPS_SKIP bytes in, after newlines; console records need no
+ * "====" header. Reboot: LK's RECOVERY_MODE cookie in the IMEM restart reason,
+ * then PS_HOLD low (warm reset, DRAM kept).
+ */
+#define A8_OOPS_PA              0x9FDFE000ull
+#define K88_OOPS_SKIP           0x4000u
+#define A8_OOPS_SIZE            0x20000u        /* mapped: the skip + 112 KiB of text */
+#define A8_OOPS_SIG             0x43474244u
+#define K88_IMEM_PA             0x08600000ull
+#define K88_IMEM_RESTART        0x65C
+#define K88_RESTART_RECOVERY    0x77665502u
+#define K88_PSHOLD_PA           0x004AB000ull
+#else
 #define A8_OOPS_PA              0x92400000ull
 #define A8_OOPS_SIZE            0x4000u         /* ramoops record_size */
 #define A8_OOPS_SIG             0x43474244u     /* PERSISTENT_RAM_SIG ^ 0 */
+#endif
 #define A8_PMU_PA               0x11C80000ull
 #define A8_PMU_SWRESET          0x0400
 #define A8_PMU_INFORM2          0x0808
@@ -1972,7 +1991,10 @@ sweet_ufs_rootdev(dev_t *dev)
 #define A8_SEC_RESET_RECOVERY   0x12345674u
 
 static volatile uint32_t *a8_oops;
-static volatile uint32_t *a8_pmu;
+static volatile uint32_t *a8_pmu;               /* K88: the IMEM page */
+#if defined(SWEET_K88)
+static volatile uint32_t *k88_pshold;
+#endif
 
 void sweet_a8_channel_init(void);
 void sweet_a8_snapshot(void);
@@ -1987,7 +2009,12 @@ sweet_a8_channel_init(void)
 		a8_oops = (volatile uint32_t *)ml_io_map(A8_OOPS_PA, A8_OOPS_SIZE);
 	}
 	if (!a8_pmu) {
+#if defined(SWEET_K88)
+		k88_pshold = (volatile uint32_t *)ml_io_map(K88_PSHOLD_PA, 0x1000);
+		a8_pmu = (volatile uint32_t *)ml_io_map(K88_IMEM_PA, 0x1000);
+#else
 		a8_pmu = (volatile uint32_t *)ml_io_map(A8_PMU_PA, 0x1000);
+#endif
 	}
 }
 
@@ -1999,8 +2026,14 @@ sweet_a8_channel_init(void)
 void
 sweet_a8_snapshot(void)
 {
+#if defined(SWEET_K88)
+	/* console zone: newlines up to K88_OOPS_SKIP (LK overwrites the start), then the log tail */
+	static const char hdr[K88_OOPS_SKIP] = { [0 ... K88_OOPS_SKIP - 1] = '\n' };
+	const uint32_t hlen = K88_OOPS_SKIP;
+#else
 	static const char hdr[] = "====1.0-D\n";
 	const uint32_t hlen = sizeof(hdr) - 1;
+#endif
 	const uint32_t cap = A8_OOPS_SIZE - 12;          /* sig, start, size */
 	volatile uint32_t *w;
 
@@ -2035,12 +2068,20 @@ void
 sweet_a8_reboot_recovery(void)
 {
 	sweet_a8_snapshot();
+#if defined(SWEET_K88)
+	if (a8_pmu && k88_pshold) {
+		a8_pmu[K88_IMEM_RESTART / 4] = K88_RESTART_RECOVERY;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		k88_pshold[0] = 0;
+	}
+#else
 	if (a8_pmu) {
 		a8_pmu[A8_PMU_INFORM2 / 4] = A8_SEC_POWER_RESET;
 		a8_pmu[A8_PMU_INFORM3 / 4] = A8_SEC_RESET_RECOVERY;
 		__asm__ volatile ("dsb sy" ::: "memory");
 		a8_pmu[A8_PMU_SWRESET / 4] = 1;
 	}
+#endif
 	for (;;) {
 		__builtin_arm_wfe();
 	}
