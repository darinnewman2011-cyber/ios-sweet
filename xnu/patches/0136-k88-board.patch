diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 217f968..23ad0f6 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -67,6 +67,11 @@ MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 # features (LSE etc.) despite -march.
 ifeq ($(SWEET_BOARD),jackpotlte)
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET -DSWEET_JACKPOTLTE -mcpu=generic -march=armv8-a
+else ifeq ($(SWEET_BOARD),k88)
+# ZTE K88 (MSM8952, 8x Cortex-A53): the same 4K/ARMv8.0/GICv2 kernel as the A8
+# (SWEET_JACKPOTLTE), with SWEET_K88 swapping the board values and keeping the
+# Exynos-only drivers off.
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET -DSWEET_JACKPOTLTE -DSWEET_K88 -mcpu=generic -march=armv8-a
 else
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
 endif
@@ -348,7 +353,9 @@ endif
 # SWEET_BOARD=jackpotlte: 4K pages and __ARM64_PMAP_SUBPAGE_L1__ give a 38-bit
 # kernel VA (T1SZ_BOOT 26, TTBR1 from 0xffffffc000000000), which cannot reach
 # the -2 TB ARM_LARGE_MEMORY layout: use the iOS 4K layout instead.
-ifeq ($(SWEET_BOARD),jackpotlte)
+# (k88 too: same 4K kernel. Run 43559578563 missed this and linked k88 at
+# 0xfffffe0006000000, which faulted right after the shim's jump.)
+ifneq ($(filter $(SWEET_BOARD),jackpotlte k88),)
 LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
 ARM64_PLKSEG_ADDR  =0xfffffff004004000
 ARM64_LINK_ADDR    =0xfffffff007004000
