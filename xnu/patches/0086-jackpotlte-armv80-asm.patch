diff --git a/EXTERNAL_HEADERS/corecrypto/cc_config.h b/EXTERNAL_HEADERS/corecrypto/cc_config.h
index c9bc9cc..6f4afb3 100644
--- a/EXTERNAL_HEADERS/corecrypto/cc_config.h
+++ b/EXTERNAL_HEADERS/corecrypto/cc_config.h
@@ -429,7 +429,12 @@
  #define CCSHA1_VNG_INTEL       0
  #define CCSHA2_VNG_INTEL       0
  #define CCSHA1_VNG_ARM         1
+#if defined(SWEET_JACKPOTLTE)
+ /* ARMv8.0 Exynos 7885: SHA2 instructions unverified, use the C ltc digest */
+ #define CCSHA2_VNG_ARM         0
+#else
  #define CCSHA2_VNG_ARM         1
+#endif
 
 //-(3) Intel 32/64
 #elif (defined(__x86_64__) || defined(__i386__)) && defined(__clang__) && CC_USE_ASM
diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..dfc3396 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,8 +273,18 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if defined(SWEET_JACKPOTLTE)
+	// ARMv8.0 (no LSE): same acquire trylock with LDAXR/STXR
+1:	ldaxr	w10, [x3]		 // w10 = current lock value
+	cbnz	w10, 2f			 // already locked
+	stxr	w12, w11, [x3]	 // try to store locked value
+	cbnz	w12, 1b			 // lost exclusivity, retry
+	b		Ltrylock_enqueue_success
+2:	clrex
+#else
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_enqueue_success
+#endif
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_enqueue_exit
@@ -323,8 +333,18 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if defined(SWEET_JACKPOTLTE)
+	// ARMv8.0 (no LSE): same acquire trylock with LDAXR/STXR
+1:	ldaxr	w10, [x2]		 // w10 = current lock value
+	cbnz	w10, 2f			 // already locked
+	stxr	w12, w11, [x2]	 // try to store locked value
+	cbnz	w12, 1b			 // lost exclusivity, retry
+	b		Ltrylock_dequeue_success
+2:	clrex
+#else
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_dequeue_success
+#endif
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_dequeue_exit
