+bool
+sweet_mali_surface_shown(SweetSurface * s)
+{
+	uint64_t fence = s->gpuFence;
+
+	if (fence == 0 || s->gpuShown != fence) {
+		return false;
+	}
+	if (!sweet_mali_wait(fence, MALI_SURFACE_WAIT_MS)) {
+		IOLog("SWEET MALI: IOSurface %u: the panel copy (job %llu) not done after %u ms\n", s->id, fence, MALI_SURFACE_WAIT_MS);
+	}
+	return true;
+}
