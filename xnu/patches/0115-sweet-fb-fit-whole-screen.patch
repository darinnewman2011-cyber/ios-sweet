+/*
+ * sweetfb_fit: one layer, its logical rectangle (dx, dy, w, h) taken from the
+ * surface at (sx, sy), drawn scaled into the panel's fit area; the bars around
+ * the area are cleared (console text may have been drawn there).
+ */
+void
+AppleCLCD::presentFit(SweetSurface *s, uintptr_t src, uint32_t bpe, int32_t sx, int32_t sy, int32_t dx, int32_t dy,
+    int32_t w, int32_t h)
+{
+	if (src == 0 || bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 || s->memory == NULL) {
+		return;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w <= 0 || h <= 0 || (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow + (uint64_t)(sx + w) * 4 >
+	    s->memory->getLength()) {
+		return;
+	}
+	/* the panel columns whose logical column falls inside [dx, dx + w) */
+	uint32_t c0 = 0, c1;
+	while (c0 < fFitW && fFitCol[c0] < (uint32_t)dx) {
+		c0++;
+	}
+	for (c1 = c0; c1 < fFitW && fFitCol[c1] < (uint32_t)(dx + w); c1++) {
+	}
+	for (uint32_t py = 0; py < fHeight; py++) {
+		uint32_t *row = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		if (py < fFitY || py >= fFitY + fFitH) {
+			bzero(row, (size_t)fWidth * 4);
+			continue;
+		}
+		bzero(row, (size_t)fFitX * 4);
+		bzero(row + fFitX + fFitW, (size_t)(fWidth - fFitX - fFitW) * 4);
+		uint32_t ly = (uint32_t)((uint64_t)(py - fFitY) * fFitDen / fFitNum);
+		if (ly < (uint32_t)dy || ly >= (uint32_t)(dy + h)) {
+			continue;
+		}
+		const uint32_t *line = (const uint32_t *)(src + s->offset + (uint64_t)(sy + ly - dy) * s->bytesPerRow) +
+		    (sx - dx);
+		/* built in cached memory, then one copy: the panel memory is not cached */
+		for (uint32_t c = c0; c < c1; c++) {
+			fFitRow[c] = line[fFitCol[c]];
+		}
+		memcpy(row + fFitX + c0, fFitRow + c0, (size_t)(c1 - c0) * 4);
+	}
+}
