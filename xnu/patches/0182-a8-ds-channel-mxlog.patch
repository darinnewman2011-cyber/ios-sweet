+/*
+ * xnu 0182: the firmware's mxlog stream (to-AP, 4-byte packets): always drained so it never fills, printed
+ * as raw words while a join is in progress (mxlog_left lines). Records are | sync 0x9669 | lvl | len || tstamp ||
+ * offset into debug/common/log-strings.bin || args |; tools/a8-mxlog.py decodes them on the Mac.
+ */
+static int mxlog_left = 150;            /* the first records after Wi-Fi starts, too */
+
+static void
+mxlog_drain(void)
+{
+	uint32_t r = rd(shm, log_in.ridx) % log_in.num, w = rd(shm, log_in.widx) % log_in.num;
+	uint32_t v[8], n = 0;
+
+	while (r != w) {
+		v[n++] = rd(shm, log_in.buf + r * 4);
+		r = (r + 1) % log_in.num;
+		if (n == 8 || r == w) {
+			if (mxlog_left > 0) {
+				mxlog_left--;
+				printf("SWEET A8 MXLOG: %08x %08x %08x %08x %08x %08x %08x %08x /%u\n", v[0], n > 1 ? v[1] : 0,
+				    n > 2 ? v[2] : 0, n > 3 ? v[3] : 0, n > 4 ? v[4] : 0, n > 5 ? v[5] : 0, n > 6 ? v[6] : 0,
+				    n > 7 ? v[7] : 0, n);
+			}
+			n = 0;
+		}
+	}
+	wr(shm, log_in.ridx, r);
+}
